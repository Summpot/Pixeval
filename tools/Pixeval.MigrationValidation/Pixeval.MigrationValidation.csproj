<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- The headless storage fixture implements Avalonia's platform storage interfaces.
             This opt-in is confined to the validation executable, never the product. -->
        <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Pixeval/Pixeval.csproj" />
        <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
        <Content Include="../../src/Pixeval/i18n/**/*.json;../../src/Pixeval/i18n/**/*.md"
                 Link="i18n/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
