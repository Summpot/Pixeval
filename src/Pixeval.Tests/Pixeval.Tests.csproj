<Project Sdk="MSTest.Sdk/4.4.1">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<!-- Storage picker fixtures implement Avalonia platform interfaces; product does not opt in. -->
		<AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<ProjectReference Include="..\Pixeval\Pixeval.csproj" />
		<ProjectReference Include="..\Pixeval.SourceGen\Pixeval.SourceGen.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Fixtures\ProgressiveImages\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

    <ItemGroup>
        <Content Include="../Pixeval/i18n/**/*.json;../Pixeval/i18n/**/*.md"
                 Link="i18n/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
