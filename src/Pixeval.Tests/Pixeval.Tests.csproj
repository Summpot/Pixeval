<Project Sdk="MSTest.Sdk/4.5.1">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<UseAppHost>false</UseAppHost>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
		<ProjectReference Include="..\Pixeval\Pixeval.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
	</ItemGroup>

	<ItemGroup>
      <None Update="Fixtures\ProgressiveImages\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
