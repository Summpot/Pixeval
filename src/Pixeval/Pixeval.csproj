<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
        <ZeroI18nNamespace>Pixeval.Localization</ZeroI18nNamespace>
        <ZeroI18nClassName>Strings</ZeroI18nClassName>
        <ZeroI18nAccessModifier>public</ZeroI18nAccessModifier>
        <ZeroI18nDefaultLocale>zh-Hans</ZeroI18nDefaultLocale>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsAotCompatible>true</IsAotCompatible>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<EnableMcp Condition="'$(EnableMcp)' == ''">true</EnableMcp>
		<DefineConstants Condition="'$(EnableMcp)' == 'true'">$(DefineConstants);PIXEVAL_MCP</DefineConstants>
		<NoWarn>$(NoWarn);CS0114;CS8618;IL2026;IL3050;IL2075;CA1416;AVLN3001</NoWarn>
		<NoWarn Condition="'$(Configuration)' != 'Release'">$(NoWarn);ZERO005</NoWarn>
		
		<Version>5.0.13.0</Version>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>
		<InformationalVersion>$(Version)</InformationalVersion>
		<UniFFICrateName>pixeval_native</UniFFICrateName>
		<UniFFIEnginePrefer Condition="'$(UniFFIEnginePrefer)' == ''">Auto</UniFFIEnginePrefer>
		<UniFFINamespace>Pixeval.Ffi;pixeval_filters=global::Pixeval.Filters;pixeval_cache=global::Pixeval.Cache;pixeval_maho=global::Pixeval.Maho;pixeval_mako=global::Pixeval.Mako;pixeval_download=global::Pixeval.Download;pixeval_storage=global::Pixeval.Storage;pixeval_subscription=global::Pixeval.Subscription;pixeval_config=global::Pixeval.Config;pixeval_mcp=global::Pixeval.Mcp;pixeval_plugin=global::Pixeval.Plugin;pixeval_novel=global::Pixeval.Novel;pixeval_media=global::Pixeval.Media;pixeval_booru=global::Pixeval.Booru;pixeval_saucenao=global::Pixeval.SauceNao;pixeval_update=global::Pixeval.Update</UniFFINamespace>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	</PropertyGroup>

	<!-- GUI-only global properties must not be propagated to library and source-generator projects. -->
	<ItemDefinitionGroup>
		<ProjectReference>
			<GlobalPropertiesToRemove>EnableMcp;PublishAot</GlobalPropertiesToRemove>
		</ProjectReference>
	</ItemDefinitionGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ZeroI18n" Version="1.1.0" PrivateAssets="all" />
		<PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
		<PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
		<!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
		<PackageReference Include="Pixeval.Extensions.Common" Version="5.0.0" />
		<PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
		<PackageReference Include="TabView.Avalonia" Version="1.0.0" />
		<PackageReference Include="Velopack" Version="1.2.161" />
		<PackageReference Include="UniFFISharp" Version="0.3.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\lib\AutoSettingsPage\AutoSettingsPage.Avalonia\AutoSettingsPage.Avalonia.csproj" />
		<ProjectReference Include="..\lib\AutoSettingsPage\AutoSettingsPage\AutoSettingsPage.csproj" />
		<ProjectReference Include="..\lib\AnimatedControls.Avalonia\AnimatedControls.Avalonia\AnimatedControls.Avalonia.csproj" />
		<ProjectReference Include="..\lib\FluentAvalonia\FluentAvalonia.csproj" />
		<ProjectReference Include="..\lib\SmoothScroll.Avalonia\src\SmoothScroll.Avalonia.Controls\SmoothScroll.Avalonia.Controls.csproj" />
		<ProjectReference Include="..\Pixeval.Utilities\Pixeval.Utilities.csproj" />
		<ProjectReference Include="..\Pixeval.SourceGen\Pixeval.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="False" />
	</ItemGroup>

	<ItemGroup Condition="'$(EnableMcp)' != 'true'">
		<AvaloniaXaml Remove="Views\Settings\McpHelpSection.axaml" />
		<Compile Remove="Services\Background\IPixevalMcpService.cs" />
		<Compile Remove="Services\Background\PixevalMcpService.cs" />
		<Compile Remove="Services\Background\HelpPageJsonContext.cs" />
		<Compile Remove="Services\Background\JsonSchemaObject.cs" />
		<Compile Remove="Services\Background\McpJsonRpcError.cs" />
		<Compile Remove="Services\Background\McpToolSchema.cs" />
		<Compile Remove="Services\Background\McpToolsListResponse.cs" />
		<Compile Remove="Services\Background\McpToolsListResult.cs" />
		<Compile Remove="ViewModels\Settings\McpToolItemViewModel.cs" />
		<Compile Remove="ViewModels\Settings\McpToolParameterItemViewModel.cs" />
		<Compile Remove="Views\Settings\McpHelpSection.Mcp.cs" />
		<Compile Remove="Views\Settings\McpHelpSection.McpTools.cs" />
	</ItemGroup>

	<ItemGroup>
        <AdditionalFiles Include="Assets\PathIcons\*.svg" />
    </ItemGroup>
</Project>
