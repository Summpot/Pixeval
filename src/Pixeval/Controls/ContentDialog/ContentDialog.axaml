<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">

    <SolidColorBrush x:Key="ContentDialogOverlayBrush" Color="{m3:Token {x:Static m3:MaterialTokens+Comp+Scrim.ContainerColor}}" />

    <ControlTheme x:Key="{x:Type controls:ContentDialogHost}" TargetType="controls:ContentDialogHost">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Root" Background="{StaticResource ContentDialogOverlayBrush}">
                    <Panel
                        x:Name="PART_DialogPanel"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:compact /template/ Panel#PART_DialogPanel">
            <Setter Property="Margin" Value="8,8,8,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type controls:ContentDialog}" TargetType="{x:Type controls:ContentDialog}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Dialog.MinWidth}}" />
        <Setter Property="MaxWidth" Value="{m3:Token {x:Static m3:MaterialTokens+Comp+Dialog.MaxWidth}}" />
        <Setter Property="MaxHeight" Value="720" />
        <Setter Property="Template">
            <ControlTemplate>
                <m3:MaterialSurface
                    x:Name="PART_LayoutRoot"
                    Background="{m3:Token {x:Static m3:MaterialTokens+Comp+Dialog.ContainerColor}}"
                    ClipToBounds="True"
                    CornerRadius="{m3:Token {x:Static m3:MaterialTokens+Comp+Dialog.ContainerShape}}">
                    <Grid
                        Margin="{m3:Token {x:Static m3:MaterialTokens+Comp+Dialog.ContentPadding}}"
                        RowDefinitions="Auto,*,Auto"
                        RowSpacing="24">
                        <ContentPresenter
                            x:Name="PART_TitlePresenter"
                            Content="{TemplateBinding Title}"
                            ContentTemplate="{TemplateBinding TitleTemplate}"
                            IsVisible="{TemplateBinding Title,
                                                        Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentPresenter.DataTemplates>
                                <DataTemplate DataType="{x:Type x:String}">
                                    <TextBlock
                                        m3:MaterialText.Style="{m3:Token {x:Static m3:MaterialTokens+Comp+Dialog.HeadlineFont}}"
                                        FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                                        Foreground="{m3:Token {x:Static m3:MaterialTokens+Comp+Dialog.HeadlineColor}}"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ContentPresenter.DataTemplates>
                        </ContentPresenter>

                        <ScrollViewer
                            Grid.Row="1"
                            MaxHeight="420"
                            VerticalScrollBarVisibility="Auto">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}">
                                <ContentPresenter.DataTemplates>
                                    <DataTemplate x:DataType="{x:Type x:String}" DataType="{x:Type x:String}">
                                        <TextBlock
                                            m3:MaterialText.Style="{m3:Token {x:Static m3:MaterialTokens+Comp+Dialog.SupportingTextFont}}"
                                            Foreground="{m3:Token {x:Static m3:MaterialTokens+Comp+Dialog.SupportingTextColor}}"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ContentPresenter.DataTemplates>
                            </ContentPresenter>
                        </ScrollViewer>

                        <WrapPanel
                            x:Name="PART_ButtonPanel"
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            ItemSpacing="8"
                            LineSpacing="8"
                            Orientation="Horizontal">
                            <Button
                                x:Name="PART_PrimaryButton"
                                MinWidth="84"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding PrimaryButtonText}"
                                IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}"
                                IsVisible="{TemplateBinding PrimaryButtonText,
                                                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <Button
                                x:Name="PART_SecondaryButton"
                                MinWidth="84"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding SecondaryButtonText}"
                                IsEnabled="{TemplateBinding IsSecondaryButtonEnabled}"
                                IsVisible="{TemplateBinding SecondaryButtonText,
                                                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Button
                                x:Name="PART_CloseButton"
                                MinWidth="84"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding CloseButtonText}"
                                IsEnabled="{TemplateBinding IsCloseButtonEnabled}"
                                IsVisible="{TemplateBinding CloseButtonText,
                                                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </WrapPanel>
                    </Grid>
                </m3:MaterialSurface>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Button.default">
            <Setter Property="Theme" Value="{StaticResource MaterialFilledButtonTheme}" />
        </Style>

        <Style Selector="^ /template/ Button">
            <Setter Property="Theme" Value="{StaticResource MaterialTextButtonTheme}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <Style Selector="^:compact">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="10000" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style Selector="^:compact /template/ m3|MaterialSurface#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="28,28,0,0" />
        </Style>

        <Style Selector="^:compact /template/ WrapPanel#PART_ButtonPanel">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ItemWidth" Value="{Binding $self.Bounds.Width}" />
        </Style>

        <Style Selector="^:compact /template/ WrapPanel#PART_ButtonPanel Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
