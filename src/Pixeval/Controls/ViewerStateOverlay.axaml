<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:pixeval="using:Pixeval">
    <ControlTheme x:Key="{x:Type controls:ViewerStateOverlay}" TargetType="{x:Type controls:ViewerStateOverlay}">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type controls:ViewerStateOverlay}">
                <Panel>
                    <Border
                        Padding="24"
                        Background="{TemplateBinding Background}"
                        IsVisible="{TemplateBinding IsLoading}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">
                            <ProgressBar
                                Width="160"
                                AutomationProperties.Name="{I18N {x:Static pixeval:EntryViewerPageResources+LoadingTextBlock.Text}}"
                                IsIndeterminate="{TemplateBinding IsLoading}" />
                            <TextBlock
                                m3:MaterialText.Style="{m3:Typography BodyMedium}"
                                Text="{I18N {x:Static pixeval:EntryViewerPageResources+LoadingTextBlock.Text}}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Background="{TemplateBinding Background}" IsVisible="{TemplateBinding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <m3:MaterialSurface
                            MaxWidth="528"
                            Margin="24"
                            Padding="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="16">
                            <Grid RowDefinitions="Auto,*" RowSpacing="16">
                                <fluent:SymbolIcon
                                    Foreground="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OnErrorContainer}}"
                                    IconVariant="Regular"
                                    Symbol="ErrorCircle" />
                                <ScrollViewer
                                    Grid.Row="1"
                                    AutomationProperties.Name="{I18N {x:Static pixeval:EntryViewerPageResources.LoadFailed}}"
                                    Focusable="True"
                                    VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        m3:MaterialText.Style="{m3:Typography BodyMedium}"
                                        Foreground="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OnErrorContainer}}"
                                        Text="{TemplateBinding ErrorMessage}"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Grid>
                        </m3:MaterialSurface>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
