<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia">

    <Design.PreviewWith>
        <ContentControl
            Width="320"
            Height="220"
            Background="{DynamicResource SystemRegionBrush}">
            <controls:Skeleton HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </ContentControl>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:Skeleton}" TargetType="{x:Type controls:Skeleton}">
        <Setter Property="Background" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerHighest}}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type controls:Skeleton}">
                <Border
                    Background="{TemplateBinding Background}"
                    ClipToBounds="True"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Panel>
                        <Border
                            Name="PART_Shimmer"
                            HorizontalAlignment="Left"
                            IsHitTestVisible="False"
                            Opacity="0.12"
                            RenderTransform="skew(-18deg)"
                            RenderTransformOrigin="50%,50%">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Offset="0" Color="Transparent" />
                                    <GradientStop Offset="0.5" Color="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OnSurface}}" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
