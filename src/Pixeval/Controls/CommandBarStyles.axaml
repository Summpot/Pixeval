<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:pixeval="using:Pixeval">

    <Style Selector="CommandBar /template/ CommandBarButton#PART_OverflowButton">
        <Setter Property="controls:CommandBarOverflowLabel.Text" Value="{CompiledBinding [Misc-MoreCommands], Source={x:Static loc:LocalizationManager.Instance}}" />
    </Style>

    <Style Selector="CommandBarButton[IsInOverflow=True] /template/ ContentPresenter#PART_Label, CommandBarToggleButton[IsInOverflow=True] /template/ ContentPresenter#PART_Label">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="CommandBarButton[IsCompact=True]">
        <Setter Property="ToolTip.Tip" Value="{Binding $self.Label}" />
    </Style>

    <Style Selector="CommandBarToggleButton[IsCompact=True]">
        <Setter Property="ToolTip.Tip" Value="{Binding $self.Label}" />
    </Style>

    <Style Selector="CommandBarButton[IsInOverflow=True] /template/ ContentPresenter#PART_Icon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <Style Selector="CommandBarToggleButton[IsInOverflow=True] /template/ ContentPresenter#PART_Icon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <Style Selector="CommandBarButton:disabled">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
    </Style>

    <Style Selector="CommandBarToggleButton:disabled">
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundDisabled}" />
    </Style>

</Styles>
