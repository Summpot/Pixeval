<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="using:FluentIcons.Avalonia"
    xmlns:controls="using:Pixeval.Controls">

    <Styles.Resources>
        <!--  Keep the native CommandBar, including overflow, commands and toggle state.  -->
        <ControlTheme
            x:Key="FloatingCommandBarTheme"
            BasedOn="{StaticResource MaterialCommandBarIconTheme}"
            TargetType="{x:Type CommandBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
        </ControlTheme>

        <ControlTheme x:Key="FloatingCommandBarElementContainerTheme" TargetType="{x:Type controls:CommandBarElementContainer}">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="{x:Type controls:CommandBarElementContainer}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme
            x:Key="FloatingCommandBarTextTheme"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="CommandBar.floating-command-bar CommandBarButton">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="CommandBar.floating-command-bar CommandBarToggleButton">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="CommandBar.floating-command-bar controls|CommandBarElementContainer">
        <Setter Property="Theme" Value="{StaticResource FloatingCommandBarElementContainerTheme}" />
    </Style>

    <Style Selector="CommandBar.floating-command-bar controls|CommandBarElementContainer TextBlock">
        <Setter Property="Theme" Value="{StaticResource FloatingCommandBarTextTheme}" />
    </Style>

    <Style Selector="CommandBar.floating-command-bar avalonia|SymbolIcon">
        <Setter Property="FontSize" Value="20" />
    </Style>
</Styles>
