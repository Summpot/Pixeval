<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:notifications="using:Avalonia.Controls.Notifications"
    xmlns:pixeval="using:Pixeval">

    <Design.PreviewWith>
        <StackPanel Orientation="Horizontal">
            <ThemeVariantScope RequestedThemeVariant="Light">
                <StackPanel Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <NotificationCard>
                        <notifications:Notification Title="Success message" Type="Success" />
                    </NotificationCard>
                    <NotificationCard>
                        <notifications:Notification
                            Title="Information"
                            Message="Information message"
                            Type="Information" />
                    </NotificationCard>
                    <NotificationCard>
                        <notifications:Notification
                            Title="Warning"
                            Message="Warning message"
                            Type="Warning" />
                    </NotificationCard>
                    <NotificationCard>
                        <notifications:Notification
                            Title="Error"
                            Message="Error message"
                            Type="Error" />
                    </NotificationCard>
                </StackPanel>
            </ThemeVariantScope>
            <ThemeVariantScope RequestedThemeVariant="Dark">
                <StackPanel Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <NotificationCard>
                        <notifications:Notification Title="Success message" Type="Success" />
                    </NotificationCard>
                    <NotificationCard>
                        <notifications:Notification
                            Title="Information"
                            Message="Information message"
                            Type="Information" />
                    </NotificationCard>
                    <NotificationCard>
                        <notifications:Notification
                            Title="Warning"
                            Message="Warning message"
                            Type="Warning" />
                    </NotificationCard>
                    <NotificationCard>
                        <notifications:Notification
                            Title="Error"
                            Message="Error message"
                            Type="Error" />
                    </NotificationCard>
                </StackPanel>
            </ThemeVariantScope>
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme
        x:Key="NotificationCardCloseButtonStyle"
        BasedOn="{StaticResource MaterialStandardIconButtonTheme}"
        TargetType="{x:Type m3:IconButton}">
        <Setter Property="Margin" Value="4" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Symbol" Value="Close" />
        <Setter Property="AutomationProperties.Name" Value="{CompiledBinding [Misc-CloseNotification], Source={x:Static loc:LocalizationManager.Instance}}" />
        <Setter Property="ToolTip.Tip" Value="{CompiledBinding [Misc-CloseNotification], Source={x:Static loc:LocalizationManager.Instance}}" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type NotificationCard}" TargetType="{x:Type NotificationCard}">
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="RenderTransformOrigin" Value="50%,100%" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type NotificationCard}">
                <LayoutTransformControl x:Name="PART_LayoutTransformControl" UseRenderTransform="True">
                    <m3:MaterialSurface
                        x:Name="PART_Surface"
                        Margin="12,6,12,10"
                        Padding="16,0,0,0"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ShadowElevation="3"
                        TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid MinHeight="48" ColumnDefinitions="Auto,*,Auto">
                            <fluent:SymbolIcon
                                x:Name="PART_Icon"
                                Margin="0,16,14,16"
                                VerticalAlignment="Top"
                                Foreground="{TemplateBinding Foreground}"
                                IconVariant="Regular"
                                Symbol="QuestionCircle" />
                            <ContentPresenter
                                x:Name="PART_ContentPresenter"
                                Grid.Column="1"
                                Margin="0,14,16,18"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}">
                                <ContentPresenter.DataTemplates>
                                    <DataTemplate x:DataType="{x:Type notifications:INotification}" DataType="{x:Type notifications:INotification}">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Foreground="{Binding $parent[NotificationCard].Foreground}"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap"
                                                Theme="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Foreground="{Binding $parent[NotificationCard].Foreground}"
                                                IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                MaxLines="4"
                                                Text="{Binding Message}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                Theme="{StaticResource BodyTextBlockStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                    <DataTemplate x:DataType="{x:Type x:String}" DataType="{x:Type x:String}">
                                        <TextBlock
                                            Foreground="{Binding $parent[NotificationCard].Foreground}"
                                            Text="{Binding}"
                                            TextWrapping="Wrap"
                                            Theme="{StaticResource BodyStrongTextBlockStyle}" />
                                    </DataTemplate>
                                </ContentPresenter.DataTemplates>
                            </ContentPresenter>
                            <m3:IconButton
                                x:Name="PART_CloseButton"
                                Grid.Column="2"
                                Foreground="{TemplateBinding Foreground}"
                                NotificationCard.CloseOnClick="True"
                                Theme="{StaticResource NotificationCardCloseButtonStyle}" />
                        </Grid>
                    </m3:MaterialSurface>
                </LayoutTransformControl>
            </ControlTemplate>
        </Setter>

        <ControlTheme.Animations>
            <Animation
                Easing="0.1,0.9,0.2,1.0"
                FillMode="Forward"
                Duration="0:0:0.35">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="24" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.96" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </ControlTheme.Animations>

        <Style Selector="^[IsClosing=true] /template/ LayoutTransformControl#PART_LayoutTransformControl">
            <Setter Property="RenderTransformOrigin" Value="50%,0%" />
            <Style.Animations>
                <Animation
                    Easing="0.7,0.0,1.0,0.5"
                    FillMode="Forward"
                    Duration="0:0:0.3">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="48" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="48" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^[IsClosing=true]">
            <!--  A dismissed card remains visible during its exit animation, but must not invoke its action twice.  -->
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Animations>
                <Animation FillMode="Forward" Duration="0:0:0.35">
                    <KeyFrame Cue="100%">
                        <Setter Property="IsClosed" Value="True" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^:information">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
            <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OnSecondaryContainer}}" />
            <Style Selector="^ /template/ fluent|SymbolIcon#PART_Icon">
                <Setter Property="Symbol" Value="QuestionCircle" />
            </Style>
        </Style>

        <Style Selector="^:success">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
            <Style Selector="^ /template/ fluent|SymbolIcon#PART_Icon">
                <Setter Property="Symbol" Value="CheckmarkCircle" />
            </Style>
        </Style>

        <Style Selector="^:warning">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            <Style Selector="^ /template/ fluent|SymbolIcon#PART_Icon">
                <Setter Property="Symbol" Value="Warning" />
            </Style>
        </Style>

        <Style Selector="^:error">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
            <Setter Property="Foreground" Value="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OnErrorContainer}}" />
            <Style Selector="^ /template/ fluent|SymbolIcon#PART_Icon">
                <Setter Property="Symbol" Value="DismissCircle" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
