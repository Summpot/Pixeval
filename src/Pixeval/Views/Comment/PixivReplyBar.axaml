<UserControl
    x:Class="Pixeval.Views.PixivReplyBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comment="using:Pixeval.Views.Comment"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:utilities="using:Pixeval.Utilities"
    x:Name="ReplyBarRoot"
    mc:Ignorable="d"
    d:DesignHeight="40"
    d:DesignWidth="350">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
        <DockPanel HorizontalSpacing="8" LastChildFill="True">
            <Button
                x:Name="EmojiButton"
                MinWidth="40"
                MinHeight="40"
                Padding="8"
                VerticalAlignment="Center"
                AutomationProperties.Name="{I18N {x:Static pixeval:PixivReplyBarResources.OpenEmoji}}"
                Background="Transparent"
                BorderThickness="0"
                DockPanel.Dock="Left"
                IsEnabled="{Binding !#ReplyBarRoot.IsSubmitting}"
                Theme="{StaticResource TransparentButtonStyle}"
                ToolTip.Tip="{I18N {x:Static pixeval:PixivReplyBarResources.OpenEmoji}}">
                <markup:SymbolIcon FontSize="16" Symbol="Emoji" />
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedLeft">
                        <TabControl
                            Width="300"
                            MaxWidth="{Binding #ReplyBarRoot.Bounds.Width}"
                            SelectedIndex="0">
                            <TabItem Header="{I18N {x:Static pixeval:CommentRepliesBlockResources+EmojiButtonFlyoutEmojiSectionNavigationViewItem.Content}}">
                                <ScrollViewer
                                    Width="300"
                                    Height="150"
                                    MaxWidth="{Binding #ReplyBarRoot.Bounds.Width}"
                                    HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{x:Static utilities:CommentImageHelper.EmojiIds}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="{x:Type x:Int32}">
                                                <Button
                                                    Padding="0"
                                                    Click="EmojiImage_OnClick"
                                                    Theme="{StaticResource TransparentButtonStyle}">
                                                    <Image
                                                        Width="35"
                                                        Height="35"
                                                        controls:Source.Cache="{Binding Converter={x:Static converters:PixevalConverters.StringFormatConverter}, ConverterParameter={x:Static utilities:CommentImageHelper.EmojiDownloadUrl}}"
                                                        Stretch="Uniform" />
                                                    <Button.Styles>
                                                        <Style Selector="Image">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                        </Style>
                                                    </Button.Styles>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="{I18N {x:Static pixeval:CommentRepliesBlockResources+EmojiButtonFlyoutStickersSectionNavigationViewItem.Content}}">
                                <ScrollViewer
                                    Width="300"
                                    Height="150"
                                    MaxWidth="{Binding #ReplyBarRoot.Bounds.Width}"
                                    HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{x:Static utilities:CommentImageHelper.StickerIds}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="{x:Type x:Int32}">
                                                <Button
                                                    Padding="0"
                                                    Click="StickerImage_OnClick"
                                                    Theme="{StaticResource TransparentButtonStyle}">
                                                    <Image
                                                        Width="83"
                                                        Height="83"
                                                        controls:Source.Cache="{Binding Converter={x:Static converters:PixevalConverters.StringFormatConverter}, ConverterParameter={x:Static utilities:CommentImageHelper.StickerDownloadUrl}}"
                                                        Stretch="Uniform" />
                                                    <Button.Styles>
                                                        <Style Selector="Image">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                        </Style>
                                                    </Button.Styles>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button
                x:Name="SendButton"
                MinWidth="40"
                MinHeight="40"
                Padding="8"
                VerticalAlignment="Center"
                AutomationProperties.Name="{I18N {x:Static pixeval:PixivReplyBarResources+SendButton.ToolTip}}"
                Background="Transparent"
                BorderThickness="0"
                Click="SendButton_OnClicked"
                Content="{markup:SymbolIcon Send,
                                            FontSize=16}"
                DockPanel.Dock="Right"
                IsEnabled="{Binding !#ReplyBarRoot.IsSubmitting}"
                Theme="{StaticResource TransparentButtonStyle}"
                ToolTip.Tip="{I18N {x:Static pixeval:PixivReplyBarResources+SendButton.ToolTip}}" />
            <TextBox
                x:Name="ReplyContentTextBox"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AutomationProperties.Name="{I18N {x:Static pixeval:PixivReplyBarResources+ReplyContentRichEditBox.PlaceholderText}}"
                MaxLength="140"
                PlaceholderText="{I18N {x:Static pixeval:PixivReplyBarResources+ReplyContentRichEditBox.PlaceholderText}}" />
        </DockPanel>
        <ProgressBar
            Grid.Row="1"
            Height="3"
            AutomationProperties.Name="{I18N {x:Static pixeval:EntryViewerPageResources+LoadingTextBlock.Text}}"
            IsIndeterminate="True"
            IsVisible="{Binding #ReplyBarRoot.IsSubmitting}" />
    </Grid>
</UserControl>
