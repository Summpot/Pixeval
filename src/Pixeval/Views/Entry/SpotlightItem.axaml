<m3:Card
    x:Class="Pixeval.Views.Entry.SpotlightItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entry="using:Pixeval.Views.Entry"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utilities="using:Pixeval.Utilities"
    xmlns:viewModels="using:Pixeval.ViewModels"
    x:DataType="{x:Type viewModels:SpotlightItemViewModel}"
    Padding="0"
    AutomationProperties.Name="{Binding Entry.Title}"
    Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
    Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
    Tag="{Binding Entry.ArticleUrl}"
    Theme="{StaticResource ContentCardTheme}"
    ToolTip.Tip="{Binding Entry.Title}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <DockPanel>
        <Grid
            Margin="12"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8"
            DockPanel.Dock="Bottom"
            RowDefinitions="Auto,Auto"
            RowSpacing="8">
            <ContentControl
                Grid.Row="0"
                Grid.Column="0"
                Padding="5,0"
                HorizontalAlignment="Left"
                Background="{Binding Entry.Category, Converter={x:Static entry:SpotlightItem.BackgroundBrushConverter}}"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <TextBlock
                    x:Name="CategoryText"
                    Foreground="Black"
                    Text="{Binding Entry.SubcategoryLabel}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding Entry.SubcategoryLabel}" />
            </ContentControl>
            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OnSurfaceVariant}}"
                Text="{Binding Entry.PublishDate, Converter={x:Static converters:PixevalConverters.DateTimeShortDate}}" />
            <TextBlock
                x:Name="TitleText"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                MaxLines="2"
                Text="{Binding Entry.Title}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Theme="{StaticResource BodyLargeStrongTextBlockStyle}" />
        </Grid>
        <Image controls:Source.Cache="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
    </DockPanel>
</m3:Card>
