<m3:Card
    x:Class="Pixeval.Views.Entry.UserItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Views.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:utilities="using:Pixeval.Utilities"
    xmlns:viewModels="using:Pixeval.ViewModels"
    x:DataType="{x:Type viewModels:UserItemViewModel}"
    Padding="0"
    AutomationProperties.Name="{Binding Username}"
    Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
    Design.DataContext="{x:Static utilities:DesignHelper.DesignUserViewModel}"
    Theme="{StaticResource ContentCardTheme}"
    ToolTip.Tip="{Binding Username}"
    mc:Ignorable="d"
    d:DesignHeight="160"
    d:DesignWidth="300">
    <Grid RowDefinitions="*,Auto">
        <Grid ColumnDefinitions="*,*,*">
            <Image
                Grid.Column="0"
                controls:Source.Cache="{Binding Banner0Url}"
                Stretch="UniformToFill" />
            <Image
                Grid.Column="1"
                controls:Source.Cache="{Binding Banner1Url}"
                Stretch="UniformToFill" />
            <Image
                Grid.Column="2"
                controls:Source.Cache="{Binding Banner2Url}"
                Stretch="UniformToFill" />
        </Grid>
        <StackPanel
            Grid.Row="1"
            MinHeight="72"
            Margin="105,4,12,8"
            Spacing="4">
            <TextBlock
                MaxLines="2"
                Text="{Binding Username}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Theme="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="5">
                <ContentControl
                    VerticalAlignment="Center"
                    Content="{markup:SymbolIcon Symbol=Guest,
                                                FontSize=12}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding UserId}"
                    Theme="{StaticResource CaptionStrongTextBlockStyle}" />
                <controls:PixevalBadge
                    IsVisible="{Binding IsFollowed}"
                    Mode="Following"
                    UseSmall="True" />
            </StackPanel>
        </StackPanel>
        <Button
            x:Name="AvatarButton"
            Grid.Row="0"
            Grid.RowSpan="2"
            Width="84"
            Height="84"
            Margin="10,0,0,15"
            Padding="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="{I18N {x:Static pixeval:MiscResources.MoreCommands}}"
            Background="Transparent"
            Click="AvatarButton_OnClicked"
            CornerRadius="100"
            Tapped="AvatarButton_OnTapped"
            Theme="{StaticResource MaterialTextButtonTheme}">
            <controls:AvatarImage controls:Source.Cache="{Binding AvatarUrl}" />
            <Button.Flyout>
                <MenuFlyout>
                    <MenuItem
                        Command="{Binding FollowCommand, Mode=OneWay}"
                        Header="{Binding FollowLabel}"
                        Icon="{markup1:SymbolIconEx Person,
                                                    IconVariant={Binding IsFollowedDisplay,
                                                                         Converter={x:Static converters:PixevalConverters.StateToIconVariant}}}" />
                    <Separator />
                    <MenuItem
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Header="{I18N {x:Static pixeval:EntryItemResources.OpenInWebBrowser}}"
                        Icon="{markup:SymbolIcon GlobeArrowUp}"
                        Tag="{Binding WebsiteUri}" />

                    <MenuItem
                        Click="{x:Static utilities:AvaloniaHelper.CopyTagToClipboard}"
                        Header="{I18N {x:Static pixeval:EntryItemResources.GenerateWebLink}}"
                        Icon="{markup:SymbolIcon LinkMultiple}"
                        Tag="{Binding WebsiteUri}" />
                    <MenuItem
                        Click="{x:Static utilities:AvaloniaHelper.CopyTagToClipboard}"
                        Header="{I18N {x:Static pixeval:EntryItemResources.GenerateLink}}"
                        Icon="{markup:SymbolIcon Link}"
                        Tag="{Binding AppUri}" />
                    <Separator />
                    <MenuItem
                        Command="{Binding BlockUserCommand}"
                        Header="{I18N {x:Static pixeval:BlockedContentResources.BlockUser}}"
                        Icon="{markup:SymbolIcon PersonProhibited}" />
                </MenuFlyout>
            </Button.Flyout>
        </Button>
    </Grid>
</m3:Card>
