<views:IconContentPage
    x:Class="Pixeval.Views.Search.WorkSearchResultPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:di="using:Pixeval.Views.Markup"
    xmlns:settings="using:Pixeval.AppManagement.Settings"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:Pixeval.Models.Pixiv"
    xmlns:mako="using:Pixeval.Native.Mako"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Views.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Pixeval.Views"
    xmlns:work="using:Pixeval.Views.Work"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <Grid RowDefinitions="Auto,*">
        <!-- Top Horizontal Popular Preview Strip -->
        <Border
            x:Name="PopularPreviewContainer"
            Grid.Row="0"
            IsVisible="False"
            Margin="10,6,10,6"
            Padding="10,8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <DockPanel>
                <StackPanel
                    DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="2,0,0,8">
                    <ContentControl
                        Content="{markup:SymbolIcon Sparkle, FontSize=16, IconVariant=Color}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="热门预览 (Popular Preview)"
                        FontWeight="SemiBold"
                        FontSize="13"
                        VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="PopularPreviewItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate x:DataType="{x:Type mako:Illustration}">
                                <Button
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="PopularPreviewItem_OnClick"
                                    Cursor="Hand"
                                    Theme="{StaticResource TransparentButtonStyle}">
                                    <StackPanel Width="110" Spacing="4">
                                        <Border
                                            Width="110"
                                            Height="110"
                                            CornerRadius="6"
                                            ClipToBounds="True"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <Image
                                                controls:Source.Cache="{Binding ThumbnailUrl}"
                                                Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontSize="12"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>

                            <DataTemplate x:DataType="{x:Type mako:Novel}">
                                <Button
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="PopularPreviewItem_OnClick"
                                    Cursor="Hand"
                                    Theme="{StaticResource TransparentButtonStyle}">
                                    <StackPanel Width="110" Spacing="4">
                                        <Border
                                            Width="110"
                                            Height="110"
                                            CornerRadius="6"
                                            ClipToBounds="True"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <Image
                                                controls:Source.Cache="{Binding ThumbnailUrl}"
                                                Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontSize="12"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <work:WorkContainer Grid.Row="1" x:Name="WorkContainer" IsRefreshEnabled="False">
            <work:WorkContainer.CommandBarElements>
                <controls:SymbolComboBox
                    x:Name="SimpleWorkTypeComboBox"
                    IsEnabled="False"
                    IsVisible="False"
                    ItemsSource="{markup1:EnumResources x:TypeArguments=enum:SimpleWorkType}"
                    SelectedValue="{Binding SearchSettings.DefaultSimpleWorkType, Source={di:Service Type={x:Type settings:AppSettings}}, DataType={x:Type settings:AppSettings}, Mode=OneTime}"
                    SelectionChanged="WorkTypeComboBox_OnSelectionChanged" />
            </work:WorkContainer.CommandBarElements>
        </work:WorkContainer>
    </Grid>
</views:IconContentPage>
