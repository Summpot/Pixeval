<ContentPage
    x:Class="Pixeval.Views.Search.IllustrationSearchOptionsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:Pixeval.Pixiv"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:viewModels="using:Pixeval.ViewModels.Search"
    x:DataType="{x:Type viewModels:IllustrationSearchFormViewModel}"
    DataContext="{x:Null}"
    Header="{CompiledBinding [Search-AdvancedOptions-IllustrationTab], Source={x:Static loc:LocalizationManager.Instance}}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    xmlns:nativeMako="clr-namespace:Pixeval.Mako"
    xmlns:loc="using:Pixeval.Localization">
    <ContentPage.Styles>
        <Style Selector="CalendarDatePicker">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </ContentPage.Styles>
    <m3:MaterialSurface
        MaxWidth="760"
        Margin="12"
        Padding="16"
        HorizontalAlignment="Stretch"
        Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
        CornerRadius="16">
        <StackPanel Spacing="16">
            <TextBlock
                m3:MaterialText.Style="{m3:Typography TitleMedium}"
                Text="{CompiledBinding [Search-Sections-Common], Source={x:Static loc:LocalizationManager.Instance}}"
                TextWrapping="Wrap" />
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Common-SortOption], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <controls:SymbolComboBox
                    Grid.Row="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Common-SortOption], Source={x:Static loc:LocalizationManager.Instance}}"
                    IconMode="False"
                    ItemsSource="{markup:EnumResources x:TypeArguments=nativeMako:SortOrder}"
                    SelectedValue="{Binding SortOption, Mode=TwoWay}" />
            </Grid>
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12"
                RowDefinitions="Auto,Auto"
                RowSpacing="8">
                <TextBlock
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Common-StartDate], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Common-StartDate], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsChecked="{Binding StartDateOption.IsEnabled, Mode=TwoWay}" />
                <CalendarDatePicker
                    Grid.Row="1"
                    Grid.Column="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Common-StartDate], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsEnabled="{Binding StartDateOption.IsEnabled}"
                    SelectedDate="{Binding StartDateOption.Value, Mode=TwoWay}"
                    SelectedDateFormat="Short" />
            </Grid>
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12"
                RowDefinitions="Auto,Auto"
                RowSpacing="8">
                <TextBlock
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Common-EndDate], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Common-EndDate], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsChecked="{Binding EndDateOption.IsEnabled, Mode=TwoWay}" />
                <CalendarDatePicker
                    Grid.Row="1"
                    Grid.Column="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Common-EndDate], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsEnabled="{Binding EndDateOption.IsEnabled}"
                    SelectedDate="{Binding EndDateOption.Value, Mode=TwoWay}"
                    SelectedDateFormat="Short" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Common-ShowAiWorks], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Column="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Common-ShowAiWorks], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsChecked="{Binding AiType, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Common-MergePlainKeywordResults], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Column="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Common-MergePlainKeywordResults], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsChecked="{Binding MergePlainKeywordResults, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Common-IncludeTranslatedTagResults], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Column="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Common-IncludeTranslatedTagResults], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsChecked="{Binding IncludeTranslatedTagResults, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Common-IncludePotentialViolationWorks], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Column="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Common-IncludePotentialViolationWorks], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsChecked="{Binding IncludePotentialViolationWorks, Mode=TwoWay}" />
            </Grid>

            <Separator />

            <TextBlock
                m3:MaterialText.Style="{m3:Typography TitleMedium}"
                Text="{CompiledBinding [Search-Sections-Illustration], Source={x:Static loc:LocalizationManager.Instance}}"
                TextWrapping="Wrap" />
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Illustration-MatchOption], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <controls:SymbolComboBox
                    Grid.Row="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Illustration-MatchOption], Source={x:Static loc:LocalizationManager.Instance}}"
                    IconMode="False"
                    ItemsSource="{markup:EnumResources x:TypeArguments=nativeMako:IllustSearchTarget}"
                    SelectedValue="{Binding MatchOption, Mode=TwoWay}" />
            </Grid>
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Illustration-ContentType], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <controls:SymbolComboBox
                    Grid.Row="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Illustration-ContentType], Source={x:Static loc:LocalizationManager.Instance}}"
                    IconMode="False"
                    ItemsSource="{markup:EnumResources x:TypeArguments=enum:SearchIllustrationContentType}"
                    SelectedValue="{Binding ContentType, Mode=TwoWay}" />
            </Grid>
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Illustration-RatioPattern], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <controls:SymbolComboBox
                    Grid.Row="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Illustration-RatioPattern], Source={x:Static loc:LocalizationManager.Instance}}"
                    IconMode="False"
                    ItemsSource="{markup:EnumResources x:TypeArguments=enum:SearchIllustrationRatioPattern}"
                    SelectedValue="{Binding RatioPattern, Mode=TwoWay}" />
            </Grid>
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12"
                RowDefinitions="Auto,Auto"
                RowSpacing="8">
                <TextBlock
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Illustration-WidthMin], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Illustration-WidthMin], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsChecked="{Binding WidthMinOption.IsEnabled, Mode=TwoWay}" />
                <NumericUpDown
                    Grid.Row="1"
                    Grid.Column="1"
                    AllowSpin="True"
                    AutomationProperties.Name="{CompiledBinding [Search-Illustration-WidthMin], Source={x:Static loc:LocalizationManager.Instance}}"
                    ClipValueToMinMax="True"
                    FormatString="F0"
                    Increment="1"
                    IsEnabled="{Binding WidthMinOption.IsEnabled}"
                    Minimum="0"
                    Value="{Binding WidthMinOption.Value, Mode=TwoWay}" />
            </Grid>
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12"
                RowDefinitions="Auto,Auto"
                RowSpacing="8">
                <TextBlock
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Illustration-WidthMax], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Illustration-WidthMax], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsChecked="{Binding WidthMaxOption.IsEnabled, Mode=TwoWay}" />
                <NumericUpDown
                    Grid.Row="1"
                    Grid.Column="1"
                    AllowSpin="True"
                    AutomationProperties.Name="{CompiledBinding [Search-Illustration-WidthMax], Source={x:Static loc:LocalizationManager.Instance}}"
                    ClipValueToMinMax="True"
                    FormatString="F0"
                    Increment="1"
                    IsEnabled="{Binding WidthMaxOption.IsEnabled}"
                    Minimum="0"
                    Value="{Binding WidthMaxOption.Value, Mode=TwoWay}" />
            </Grid>
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12"
                RowDefinitions="Auto,Auto"
                RowSpacing="8">
                <TextBlock
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Illustration-HeightMin], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Illustration-HeightMin], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsChecked="{Binding HeightMinOption.IsEnabled, Mode=TwoWay}" />
                <NumericUpDown
                    Grid.Row="1"
                    Grid.Column="1"
                    AllowSpin="True"
                    AutomationProperties.Name="{CompiledBinding [Search-Illustration-HeightMin], Source={x:Static loc:LocalizationManager.Instance}}"
                    ClipValueToMinMax="True"
                    FormatString="F0"
                    Increment="1"
                    IsEnabled="{Binding HeightMinOption.IsEnabled}"
                    Minimum="0"
                    Value="{Binding HeightMinOption.Value, Mode=TwoWay}" />
            </Grid>
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12"
                RowDefinitions="Auto,Auto"
                RowSpacing="8">
                <TextBlock
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Illustration-HeightMax], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    Grid.Row="1"
                    AutomationProperties.Name="{CompiledBinding [Search-Illustration-HeightMax], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsChecked="{Binding HeightMaxOption.IsEnabled, Mode=TwoWay}" />
                <NumericUpDown
                    Grid.Row="1"
                    Grid.Column="1"
                    AllowSpin="True"
                    AutomationProperties.Name="{CompiledBinding [Search-Illustration-HeightMax], Source={x:Static loc:LocalizationManager.Instance}}"
                    ClipValueToMinMax="True"
                    FormatString="F0"
                    Increment="1"
                    IsEnabled="{Binding HeightMaxOption.IsEnabled}"
                    Minimum="0"
                    Value="{Binding HeightMaxOption.Value, Mode=TwoWay}" />
            </Grid>
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{CompiledBinding [Search-Illustration-Tool], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />
                <ComboBox
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{CompiledBinding [Search-Illustration-Tool], Source={x:Static loc:LocalizationManager.Instance}}"
                    DisplayMemberBinding="{Binding}"
                    ItemsSource="{Binding ToolItems}"
                    SelectedValue="{Binding Tool, Mode=TwoWay}"
                    SelectedValueBinding="{Binding}" />
            </Grid>
        </StackPanel>
    </m3:MaterialSurface>
</ContentPage>
