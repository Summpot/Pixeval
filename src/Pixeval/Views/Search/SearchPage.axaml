<views:IconContentPage
    x:Class="Pixeval.Views.Search.SearchPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:Pixeval.Pixiv"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:Pixeval.Mako"
    xmlns:pixeval="using:Pixeval"
    xmlns:search="using:Pixeval.Views.Search"
    xmlns:storage="using:Pixeval.Storage"
    xmlns:viewModels="using:Pixeval.ViewModels.Search"
    xmlns:views="using:Pixeval.Views.Shell"
    x:DataType="{x:Type viewModels:SearchPageViewModel}"
    DataContext="{markup1:Service Type={x:Type viewModels:SearchPageViewModel}}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <views:IconContentPage.Resources>
        <DataTemplate x:DataType="search:SearchCompletionItem" x:Key="SearchCompletionTemplate">
            <StackPanel Margin="12,6" Spacing="1">
                <TextBlock FontWeight="SemiBold" Text="{Binding Text}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Description}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </views:IconContentPage.Resources>

    <ScrollViewer>
        <DockPanel
            Margin="20"
            HorizontalSpacing="5"
            VerticalSpacing="5">
            <Expander
                x:Name="AdvancedExpander"
                HorizontalAlignment="Stretch"
                DockPanel.Dock="Top">
                <Expander.Header>
                    <AutoCompleteBox
                        x:Name="SearchAutoCompleteBox"
                        FilterMode="None"
                        IsTextCompletionEnabled="False"
                        ItemsSource="{Binding SearchCompletionItems}"
                        SelectedItem="{Binding SelectedSearchCompletion, Mode=TwoWay}"
                        ItemSelector="SearchAutoCompleteBox_OnSelectItem"
                        ItemTemplate="{StaticResource SearchCompletionTemplate}"
                        KeyDown="SearchAutoCompleteBox_OnKeyDown"
                        MinimumPrefixLength="1"
                        PlaceholderText="{CompiledBinding [Search-SearchBox-PlaceholderText], Source={x:Static loc:LocalizationManager.Instance}}"
                        Tapped="SearchAutoCompleteBox_OnTapped"
                        TemplateApplied="SearchAutoCompleteBox_OnTemplateApplied"
                        Text="{Binding SearchText, Mode=TwoWay}">
                        <AutoCompleteBox.InnerRightContent>
                            <Button
                                Command="{Binding SearchCommand}"
                                CommandParameter="{Binding #AdvancedExpander.IsExpanded}"
                                Content="{markup:SymbolIcon Search, FontSize=16}" />
                        </AutoCompleteBox.InnerRightContent>
                    </AutoCompleteBox>
                </Expander.Header>
                <TabbedPage
                    x:Name="AdvancedOptionsTabControl"
                    KeyDown="AdvancedOptionsTabControl_OnKeyDown"
                    SelectedIndex="{Binding SelectedAdvancedOptionsType, Mode=TwoWay}">
                    <search:IllustrationSearchOptionsPage DataContext="{Binding IllustrationForm}" />
                    <search:NovelSearchOptionsPage DataContext="{Binding NovelForm}" />
                    <search:SauceNaoSearchPage />
                </TabbedPage>
            </Expander>
            <ScrollViewer MaxHeight="200" DockPanel.Dock="Top">
                <ItemsControl ItemsSource="{Binding SearchTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="5" LineSpacing="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type x:String}">
                            <Button
                                Command="{Binding OpenPinnedTagCommand, Source={markup1:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}"
                                CommandParameter="{Binding}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding}" />
                                        <fluent:SymbolIcon Symbol="Pin" />
                                    </StackPanel>
                                </Button.Content>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Command="{Binding CopyCommand, Source={markup1:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}"
                                            CommandParameter="{Binding}"
                                            Header="{CompiledBinding [Search-SearchHistory-Copy], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Icon="{markup:SymbolIcon Copy}" />
                                        <MenuItem
                                            Command="{Binding UnpinCommand, Source={markup1:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}"
                                            CommandParameter="{Binding}"
                                            Header="{CompiledBinding [Search-SearchHistory-Unpin], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Icon="{markup:SymbolIcon PinOff}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="{x:Type storage:SearchHistoryRecord}">
                            <Button
                                Command="{Binding OpenHistoryCommand, Source={markup1:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}"
                                CommandParameter="{Binding}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding Value}" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            IsVisible="{Binding TranslatedName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Text="{Binding TranslatedName}" />
                                    </StackPanel>
                                </Button.Content>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Command="{Binding CopyCommand, Source={markup1:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}"
                                            CommandParameter="{Binding}"
                                            Header="{CompiledBinding [Search-SearchHistory-Copy], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Icon="{markup:SymbolIcon Copy}" />
                                        <MenuItem
                                            Command="{Binding AddPinnedTagCommand, Source={markup1:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}"
                                            CommandParameter="{Binding}"
                                            Header="{CompiledBinding [Search-SearchHistory-AddPinnedTag], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Icon="{markup:SymbolIcon Pin}" />
                                        <MenuItem
                                            Command="{Binding DeleteHistoryCommand, Source={markup1:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}"
                                            CommandParameter="{Binding}"
                                            Header="{CompiledBinding [Search-SearchHistory-Delete], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Icon="{markup:SymbolIcon Delete}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
            <DockPanel VerticalSpacing="5">
                <DockPanel DockPanel.Dock="Top" HorizontalSpacing="10">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{CompiledBinding [Search-TrendingHeaderTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                        Theme="{StaticResource SubtitleTextBlockStyle}" />
                    <TabStrip
                        ItemsSource="{markup1:EnumResources x:TypeArguments=enum:SimpleWorkType}"
                        SelectedValue="{Binding SelectedTrendingTagsType, Mode=TwoWay}"
                        SelectedValueBinding="{Binding Value}">
                        <TabStrip.ItemTemplate>
                            <DataTemplate DataType="{x:Type controls:SymbolComboBoxItem}">
                                <controls:IconText Symbol="{Binding Symbol}" Text="{Binding Description}" />
                            </DataTemplate>
                        </TabStrip.ItemTemplate>
                    </TabStrip>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding TrendingTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveGrid
                                ItemSize="200"
                                ItemSpacing="5"
                                LineSize="200"
                                LineSpacing="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:TrendingTag}">
                            <Button
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Command="{Binding OpenTrendingTagCommand, Source={markup1:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}"
                                CommandParameter="{Binding}">
                                <Button.Content>
                                    <DockPanel VerticalSpacing="5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            DockPanel.Dock="Top"
                                            MaxLines="2"
                                            Text="{Binding Tag}"
                                            TextWrapping="WrapWithOverflow" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            DockPanel.Dock="Top"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            MaxLines="2"
                                            Text="{Binding TranslatedName}"
                                            TextWrapping="WrapWithOverflow" />
                                        <Border ClipToBounds="True" CornerRadius="{StaticResource ControlCornerRadius}">
                                            <Image controls:Source.Cache="{Binding Illust.ImageUrls.Medium}" Stretch="UniformToFill" />
                                        </Border>
                                    </DockPanel>
                                </Button.Content>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </DockPanel>
    </ScrollViewer>
</views:IconContentPage>
