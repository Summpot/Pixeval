<views:IconContentPage
    x:Class="Pixeval.Views.Search.SearchPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:di="using:Pixeval.Common.Markup"
    xmlns:nativeStorage="using:Pixeval.Storage"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:database="using:Pixeval.Storage"
    xmlns:enum="using:Pixeval.Pixiv"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:Pixeval.Mako"
    xmlns:pixeval="using:Pixeval"
    xmlns:search="using:Pixeval.Views.Search"
    xmlns:viewModels="using:Pixeval.ViewModels.Search"
    xmlns:views="using:Pixeval.Views.Shell"
    x:DataType="{x:Type viewModels:SearchPageViewModel}"
    DataContext="{markup1:Service Type={x:Type viewModels:SearchPageViewModel}}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    xmlns:nativeMako="clr-namespace:Pixeval.Mako"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:storage="using:Pixeval.Storage">
    <views:IconContentPage.Resources>
        <DataTemplate x:DataType="search:SearchCompletionItem" x:Key="SearchCompletionTemplate">
            <StackPanel Margin="12,6" Spacing="1">
                <TextBlock FontWeight="SemiBold" Text="{Binding Text}" />
                <TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Description}"
                    TextTrimming="CharacterEllipsis"
                    Theme="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </DataTemplate>
    </views:IconContentPage.Resources>

    <ScrollViewer>
        <DockPanel
            Margin="20"
            HorizontalSpacing="5"
            VerticalSpacing="12">
            <Expander
                x:Name="AdvancedExpander"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{CompiledBinding [Search-AdvancedOptions-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                DockPanel.Dock="Top">
                <Expander.Header>
                    <AutoCompleteBox
                        x:Name="SearchAutoCompleteBox"
                        AutomationProperties.Name="{CompiledBinding [Search-SearchBox-PlaceholderText], Source={x:Static loc:LocalizationManager.Instance}}"
                        FilterMode="None"
                        IsTextCompletionEnabled="False"
                        ItemSelector="SearchAutoCompleteBox_OnSelectItem"
                        ItemTemplate="{StaticResource SearchCompletionTemplate}"
                        MinimumPrefixLength="1"
                        PlaceholderText="{CompiledBinding [Search-SearchBox-PlaceholderText], Source={x:Static loc:LocalizationManager.Instance}}"
                        Tapped="SearchAutoCompleteBox_OnTapped"
                        TemplateApplied="SearchAutoCompleteBox_OnTemplateApplied"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        ItemsSource="{Binding SearchCompletionItems}" SelectedItem="{Binding SelectedSearchCompletion, Mode=TwoWay}">
                        <AutoCompleteBox.InnerRightContent>
                            <m3:IconButton
                                AutomationProperties.Name="{CompiledBinding [MainPage-Tab-Search], Source={x:Static loc:LocalizationManager.Instance}}"
                                Command="{Binding SearchCommand}" CommandParameter="{Binding #AdvancedExpander.IsExpanded}"
                                Symbol="Search" />
                        </AutoCompleteBox.InnerRightContent>
                    </AutoCompleteBox>
                </Expander.Header>
                <TabbedPage
                    x:Name="AdvancedOptionsTabControl"
                    KeyDown="AdvancedOptionsTabControl_OnKeyDown"
                    SelectedIndex="{Binding SelectedAdvancedOptionsType, Mode=TwoWay}">
                    <search:IllustrationSearchOptionsPage DataContext="{Binding IllustrationForm}" />
                    <search:NovelSearchOptionsPage DataContext="{Binding NovelForm}" />
                    <search:SauceNaoSearchPage />
                </TabbedPage>
            </Expander>
            <ScrollViewer MaxHeight="200" DockPanel.Dock="Top">
                <ItemsControl ItemsSource="{Binding SearchTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="5" LineSpacing="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type x:String}">
                            <m3:SuggestionChip
                                Command="{Binding OpenPinnedTagCommand, Source={di:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}" CommandParameter="{Binding}"
                                Content="{Binding}"
                                LeadingIcon="{markup:SymbolIcon Pin}">
                                <m3:SuggestionChip.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Command="{Binding CopyCommand, Source={di:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}" CommandParameter="{Binding}"
                                            Header="{CompiledBinding [Search-SearchHistory-Copy], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Icon="{markup:SymbolIcon Copy}" />
                                        <MenuItem
                                            Command="{Binding UnpinCommand, Source={di:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}" CommandParameter="{Binding}"
                                            Header="{CompiledBinding [Search-SearchHistory-Unpin], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Icon="{markup:SymbolIcon PinOff}" />
                                    </ContextMenu>
                                </m3:SuggestionChip.ContextMenu>
                            </m3:SuggestionChip>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="{x:Type nativeStorage:SearchHistoryRecord}">
                            <m3:SuggestionChip Command="{Binding OpenHistoryCommand, Source={di:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}" CommandParameter="{Binding}">
                                <m3:SuggestionChip.Content>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            IsVisible="{Binding TranslatedName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Text="{Binding TranslatedName}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </m3:SuggestionChip.Content>
                                <m3:SuggestionChip.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Command="{Binding CopyCommand, Source={di:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}" CommandParameter="{Binding}"
                                            Header="{CompiledBinding [Search-SearchHistory-Copy], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Icon="{markup:SymbolIcon Copy}" />
                                        <MenuItem
                                            Command="{Binding AddPinnedTagCommand, Source={di:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}" CommandParameter="{Binding}"
                                            Header="{CompiledBinding [Search-SearchHistory-AddPinnedTag], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Icon="{markup:SymbolIcon Pin}" />
                                        <MenuItem
                                            Command="{Binding DeleteHistoryCommand, Source={di:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}" CommandParameter="{Binding}"
                                            Header="{CompiledBinding [Search-SearchHistory-Delete], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Icon="{markup:SymbolIcon Delete}" />
                                    </ContextMenu>
                                </m3:SuggestionChip.ContextMenu>
                            </m3:SuggestionChip>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
            <DockPanel VerticalSpacing="5">
                <WrapPanel
                    DockPanel.Dock="Top"
                    ItemSpacing="12"
                    LineSpacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        m3:MaterialText.Style="{m3:Typography TitleMedium}"
                        Text="{CompiledBinding [Search-TrendingHeaderTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                        TextWrapping="Wrap" />
                    <TabStrip
                        ItemsSource="{markup1:EnumResources x:TypeArguments=nativeMako:SimpleWorkKind}"
                        SelectedValue="{Binding SelectedTrendingTagsType, Mode=TwoWay}"
                        SelectedValueBinding="{Binding Value, DataType={x:Type controls:SymbolComboBoxItem}}">
                        <TabStrip.ItemTemplate>
                            <DataTemplate DataType="{x:Type controls:SymbolComboBoxItem}">
                                <controls:IconText Symbol="{Binding Symbol}" Text="{Binding Description}" />
                            </DataTemplate>
                        </TabStrip.ItemTemplate>
                    </TabStrip>
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding TrendingTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveGrid
                                ItemSize="200"
                                ItemSpacing="5"
                                LineSize="200"
                                LineSpacing="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:TrendingTag}">
                            <m3:Card
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="{Binding Tag}"
                                Command="{Binding OpenTrendingTagCommand, Source={di:Service Type={x:Type viewModels:SearchPageViewModel}}, DataType={x:Type viewModels:SearchPageViewModel}}" CommandParameter="{Binding}"
                                Theme="{StaticResource ContentCardTheme}"
                                ToolTip.Tip="{Binding Tag}">
                                <m3:Card.Content>
                                    <DockPanel VerticalSpacing="5">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            DockPanel.Dock="Top"
                                            MaxLines="2"
                                            Text="{Binding Tag}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            DockPanel.Dock="Top"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            IsVisible="{Binding TranslatedName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            MaxLines="2"
                                            Text="{Binding TranslatedName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <Border ClipToBounds="True" CornerRadius="{StaticResource ControlCornerRadius}">
                                            <Image controls:Source.Cache="{Binding Illust.ImageUrls.Medium}" Stretch="UniformToFill" />
                                        </Border>
                                    </DockPanel>
                                </m3:Card.Content>
                            </m3:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </DockPanel>
    </ScrollViewer>
</views:IconContentPage>
