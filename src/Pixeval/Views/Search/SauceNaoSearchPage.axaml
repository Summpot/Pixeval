<ContentPage
    x:Class="Pixeval.Views.Search.SauceNaoSearchPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:viewModels="using:Pixeval.ViewModels.Search"
    x:DataType="{x:Type viewModels:SauceNaoSearchPageViewModel}"
    Header="{CompiledBinding [Search-AdvancedOptions-SauceNaoTab], Source={x:Static loc:LocalizationManager.Instance}}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    xmlns:loc="using:Pixeval.Localization"
    DataContext="{markup:Service Type={x:Type viewModels:SauceNaoSearchPageViewModel}}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            MaxWidth="720"
            Margin="16"
            Spacing="16">
            <controls:InfoBar
                IsVisible="{Binding !IsApiKeyExisted}"
                Mode="Warning"
                Text="{CompiledBinding [Search-SauceNAO-ProvideApiKey], Source={x:Static loc:LocalizationManager.Instance}}" />
            <controls:InfoBar
                x:Name="ImageError"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Mode="Error"
                Text="{Binding ErrorMessage}" />
            <StackPanel IsEnabled="{Binding IsApiKeyExisted}" Spacing="12">
                <Button
                    x:Name="SearchButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="SearchButton_OnClick"
                    Content="{CompiledBinding [Search-SauceNAO-Search], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsEnabled="{Binding CanSearch}" />
                <m3:Card
                    x:Name="ImagePicker"
                    Height="320"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{CompiledBinding [Search-SauceNAO-ProvideImage], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="OpenFileButton_OnClick"
                    Theme="{StaticResource ContentCardTheme}">
                    <Panel Margin="20">
                        <StackPanel
                            VerticalAlignment="Center"
                            IsVisible="{Binding !FileSelected}"
                            Spacing="20">
                            <PathIcon
                                Width="100"
                                Height="100"
                                Data="{markup:SvgPath {x:Static pixeval:SvgResources.SauceNAO}}" />
                            <TextBlock
                                m3:MaterialText.Style="{m3:Typography TitleLarge}"
                                Text="{CompiledBinding [Search-SauceNAO-ProvideImage], Source={x:Static loc:LocalizationManager.Instance}}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Image Source="{Binding Image}" Stretch="Uniform" />
                    </Panel>
                </m3:Card>
                <ProgressBar
                    AutomationProperties.Name="{CompiledBinding [EntryViewerPage-LoadingTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsIndeterminate="True"
                    IsVisible="{Binding IsLoading}" />
                <Button
                    x:Name="PasteButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.Name="{CompiledBinding [Search-SauceNAO-PasteFromClipboard], Source={x:Static loc:LocalizationManager.Instance}}"
                    Command="{Binding PasteCommand}"
                    CommandParameter="{Binding $self}">
                    <TextBlock
                        Text="{CompiledBinding [Search-SauceNAO-PasteFromClipboard], Source={x:Static loc:LocalizationManager.Instance}}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentPage>
