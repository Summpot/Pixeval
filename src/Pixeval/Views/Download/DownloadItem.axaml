<UserControl
    x:Class="Pixeval.Views.Download.DownloadItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pixeval"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Views.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Pixeval.ViewModels"
    x:DataType="{x:Type viewModels:DownloadItemViewModel}"
    x:Name="Root"
    mc:Ignorable="d"
    d:DesignHeight="90"
    d:DesignWidth="800">
    <m3:Card
        Padding="12"
        Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
        CornerRadius="16">
        <Grid
            ColumnDefinitions="Auto,*"
            ColumnSpacing="12"
            RowDefinitions="Auto,Auto"
            RowSpacing="8">
            <Image
                Grid.Column="0"
                Width="56"
                Height="56"
                VerticalAlignment="Center"
                controls:Source.Cache="{Binding ThumbnailUrl}"
                Stretch="UniformToFill" />

            <CommandBar
                x:Name="ItemCommands"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <CommandBarButton
                    x:Name="PrimaryActionButton"
                    Click="ActionButton_OnClicked"
                    Icon="{markup1:SymbolIconEx Symbol={Binding ActionButtonSymbol}}"
                    IsEnabled="{Binding IsItemEnabled}"
                    Label="{Binding ActionButtonContent}" />
                <CommandBar.SecondaryCommands>
                    <CommandBarButton
                        Click="ResetItem_OnClicked"
                        DataContext="{Binding #Root.DataContext}"
                        Icon="{markup:SymbolIcon ArrowRepeatAll}"
                        IsEnabled="{Binding IsResetItemEnabled}"
                        Label="{I18N {x:Static local:DownloadItemResources+ResetItem.Label}}" />
                    <CommandBarButton
                        Click="CancelDownloadItem_OnClicked"
                        DataContext="{Binding #Root.DataContext}"
                        Icon="{markup:SymbolIcon Dismiss}"
                        IsEnabled="{Binding IsCancelItemEnabled}"
                        Label="{I18N {x:Static local:DownloadItemResources+CancelDownloadItem.Label}}" />
                    <CommandBarButton
                        Click="OpenDownloadLocationItem_OnClicked"
                        DataContext="{Binding #Root.DataContext}"
                        Icon="{markup:SymbolIcon FolderArrowRight}"
                        Label="{I18N {x:Static local:DownloadItemResources+OpenDownloadLocationItem.Label}}" />
                    <CommandBarButton
                        Click="GoToPageItem_OnClicked"
                        DataContext="{Binding #Root.DataContext}"
                        Icon="{markup:SymbolIcon Open}"
                        Label="{I18N {x:Static local:DownloadItemResources+GoToPageItem.Label}}" />
                    <CommandBarButton
                        Click="CheckErrorMessageInDetail_OnClicked"
                        DataContext="{Binding #Root.DataContext}"
                        Icon="{markup:SymbolIcon ErrorCircle}"
                        IsEnabled="{Binding IsError}"
                        Label="{I18N {x:Static local:DownloadItemResources+CheckErrorMessageInDetailItem.Label}}" />
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock
                    x:Name="TitleText"
                    AutomationProperties.Name="{Binding Entry.Title}"
                    FontWeight="SemiBold"
                    MaxLines="2"
                    Text="{Binding Entry.Title}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    ToolTip.Tip="{Binding Entry.Title}" />
                <TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Text="{Binding AuthorsText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding AuthorsText}" />
                <ProgressBar
                    AutomationProperties.Name="{Binding ProgressMessage}"
                    IsIndeterminate="{Binding IsPending}"
                    Maximum="100"
                    Value="{Binding DownloadTask.ProgressPercentage}" />
                <TextBlock
                    x:Name="ProgressText"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Text="{Binding ProgressMessage}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding ProgressMessage}" />
                <TextBlock
                    x:Name="GroupStatsText"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    IsVisible="{Binding ShowGroupStats}"
                    Text="{Binding GroupProgressMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </m3:Card>
</UserControl>
