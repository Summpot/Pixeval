<ContentPage
    x:Class="Pixeval.Views.Download.DownloadFolderListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:entry="using:Pixeval.Views.Works"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:local="using:Pixeval.Views.Download"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:download="using:Pixeval.Download"
    xmlns:viewModels="using:Pixeval.ViewModels.Download"
    x:DataType="{x:Type viewModels:DownloadFolderPageViewModel}"
    x:Name="Root"
    Header="{CompiledBinding [DownloadPage-SubscriptionDownloadsButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
    mc:Ignorable="d">
    <DockPanel>
        <entry:EntryView HasNoItem="{Binding #Root.HasNoFolder}">
            <ListBox ItemsSource="{Binding View}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.DataTemplates>
                    <DataTemplate x:DataType="{x:Type download:DownloadFolderSnapshot}">
                        <local:DownloadFolder OpenRequested="DownloadFolder_OnOpenRequested">
                            <local:DownloadFolder.ContextMenu>
                                <ContextMenu DataContext="{Binding}">
                                    <MenuItem
                                        Header="{CompiledBinding [DownloadPage-ResumeButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                                        Icon="{markup:SymbolIcon Play}"
                                        Tag="{Binding}"
                                        Click="ResumeAll_OnClicked" />
                                    <MenuItem
                                        Header="{CompiledBinding [DownloadPage-PauseButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                                        Icon="{markup:SymbolIcon Pause}"
                                        Tag="{Binding}"
                                        Click="PauseAll_OnClicked" />
                                    <MenuItem
                                        Header="{CompiledBinding [DownloadPage-StopButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                                        Icon="{markup:SymbolIcon Stop}"
                                        Tag="{Binding}"
                                        Click="CancelAll_OnClicked" />
                                    <MenuItem
                                        Header="{CompiledBinding [DownloadPage-ResetButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                                        Icon="{markup:SymbolIcon ArrowRepeatAll}"
                                        Tag="{Binding}"
                                        Click="ResetAll_OnClicked" />
                                    <Separator />
                                    <MenuItem
                                        Header="{CompiledBinding [DownloadPage-SyncSubscriptionButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                                        Icon="{markup:SymbolIcon ArrowSync}"
                                        Tag="{Binding}"
                                        Click="SyncSubscription_OnClicked" />
                                    <MenuItem
                                        Header="{CompiledBinding [WorkSubscriptionsSettingsExpander-RemoveSubscriptionButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                                        Icon="{markup:SymbolIcon AlertOff}"
                                        Tag="{Binding}"
                                        Click="RemoveSubscription_OnClicked" />
                                </ContextMenu>
                            </local:DownloadFolder.ContextMenu>
                        </local:DownloadFolder>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>
        </entry:EntryView>
    </DockPanel>
</ContentPage>
