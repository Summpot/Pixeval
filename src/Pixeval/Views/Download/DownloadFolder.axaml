<UserControl
    x:Class="Pixeval.Views.Download.DownloadFolder"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:download="using:Pixeval.Download"
    x:DataType="{x:Type download:DownloadFolderSnapshot}"
    HorizontalAlignment="Stretch"
    mc:Ignorable="d"
    d:DesignHeight="90"
    d:DesignWidth="800">
    <m3:Card
        x:Name="FolderCard"
        Margin="8"
        Padding="12"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        AutomationProperties.HelpText="{Binding Subtitle}"
        AutomationProperties.Name="{Binding Title}"
        Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
        Click="Button_OnClicked"
        CornerRadius="16"
        Theme="{StaticResource ContentCardTheme}">
        <Grid
            HorizontalAlignment="Stretch"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12"
            RowDefinitions="Auto,Auto"
            RowSpacing="4"
            SizeChanged="FolderLayout_OnSizeChanged">
            <controls:AvatarImage
                Grid.Column="0"
                Width="48"
                Height="48"
                VerticalAlignment="Center"
                controls:Source.Cache="{Binding AvatarUrl}"/>
            <fluent:SymbolIcon
                Grid.Column="2"
                VerticalAlignment="Center"
                Symbol="ChevronRight" />
            <StackPanel
                x:Name="FolderText"
                Grid.Column="1"
                Spacing="4">
                <TextBlock
                    Text="{loc:LocalizedDownloadText Title}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Theme="{StaticResource BodyLargeStrongTextBlockStyle}"
                    ToolTip.Tip="{Binding Title}" />
                <ProgressBar
                    AutomationProperties.Name="{Binding Subtitle}"
                    IsIndeterminate="{Binding IsFetching}"
                    Maximum="100"
                    Value="{Binding ProgressPercentage}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock
                        Grid.Column="0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Text="{loc:LocalizedDownloadText Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="5">
                        <controls:DigitalSignalItem
                            Fill="{markup:BindingDynamicResource {Binding StateBrushKey}}"
                            IsVisible="{Binding !!ActiveCount}"
                            Text="{Binding ActiveCount}" />
                        <controls:DigitalSignalItem
                            Fill="{DynamicResource SystemFillColorSuccessBrush}"
                            IsVisible="{Binding !!CompletedCount}"
                            Text="{Binding CompletedCount}" />
                        <controls:DigitalSignalItem
                            Fill="{DynamicResource SystemFillColorCriticalBrush}"
                            IsVisible="{Binding !!ErrorCount}"
                            Text="{Binding ErrorCount}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </m3:Card>
</UserControl>
