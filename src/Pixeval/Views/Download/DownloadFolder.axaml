<UserControl
    x:Class="Pixeval.Views.Download.DownloadFolder"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Pixeval.ViewModels"
    x:DataType="{x:Type viewModels:DownloadFolderViewModel}"
    HorizontalAlignment="Stretch"
    mc:Ignorable="d"
    d:DesignHeight="90"
    d:DesignWidth="800">
    <m3:Card
        x:Name="FolderCard"
        Margin="8"
        Padding="12"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        AutomationProperties.HelpText="{Binding Subtitle}"
        AutomationProperties.Name="{Binding Title}"
        Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
        Click="Button_OnClicked"
        CornerRadius="16"
        Theme="{StaticResource ContentCardTheme}">
        <Grid
            HorizontalAlignment="Stretch"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12"
            RowDefinitions="Auto,Auto"
            RowSpacing="4"
            SizeChanged="FolderLayout_OnSizeChanged">
            <controls:AvatarImage
                Grid.Column="0"
                Width="48"
                Height="48"
                VerticalAlignment="Center"
                controls:Source.Cache="{Binding Subscription.AvatarUrl}" />
            <fluent:SymbolIcon
                Grid.Column="2"
                VerticalAlignment="Center"
                Symbol="ChevronRight" />
            <StackPanel
                x:Name="FolderText"
                Grid.Column="1"
                Spacing="4">
                <TextBlock
                    x:Name="FolderTitle"
                    MaxLines="2"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Theme="{StaticResource BodyLargeStrongTextBlockStyle}"
                    ToolTip.Tip="{Binding Title}" />
                <ProgressBar
                    AutomationProperties.Name="{Binding Subtitle}"
                    IsIndeterminate="{Binding IsFetching}"
                    Maximum="100"
                    Value="{Binding ProgressPercentage}" />
                <TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Subtitle}"
                    TextWrapping="Wrap"
                    ToolTip.Tip="{Binding Subtitle}" />
                <TextBlock
                    x:Name="GroupStatsText"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding GroupProgressMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </m3:Card>
</UserControl>
