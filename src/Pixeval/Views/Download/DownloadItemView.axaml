<ContentPage
    x:Class="Pixeval.Views.Download.DownloadItemView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entry="using:Pixeval.Views.Works"
    xmlns:icons="using:FluentIcons.Avalonia.Markup"
    xmlns:local="using:Pixeval.Views.Download"
    xmlns:markup="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:options="using:Pixeval.Config"
    xmlns:pixeval="using:Pixeval"
    xmlns:download="using:Pixeval.Download"
    xmlns:viewModels="using:Pixeval.ViewModels.Download"
    x:DataType="{x:Type viewModels:DownloadItemPageViewModel}"
    x:Name="Root"
    Header="{I18N {x:Static pixeval:DownloadPageResources+OrdinaryDownloadsButton.Label}}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <Grid
                x:Name="FilterGrid"
                ColumnDefinitions="180,*,Auto"
                ColumnSpacing="8"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="8"
                SizeChanged="FilterGrid_OnSizeChanged">
                <controls:SymbolComboBox
                    x:Name="StatusFilter"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{I18N {x:Static pixeval:DownloadPageResources.StatusFilter}}"
                    IconMode="False"
                    ItemsSource="{markup:EnumResources x:TypeArguments=options:DownloadListOption}"
                    SelectedValue="{Binding CurrentOption, Mode=TwoWay}" />
                <TextBox
                    x:Name="FilterTextBox"
                    Grid.Column="1"
                    AutomationProperties.Name="{I18N {x:Static pixeval:DownloadPageResources+FilterAutoSuggestBox.PlaceholderText}}"
                    KeyDown="FilterTextBox_OnKeyDown"
                    PlaceholderText="{I18N {x:Static pixeval:DownloadPageResources+FilterAutoSuggestBox.PlaceholderText}}"
                    Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox
                    x:Name="DeleteLocalFilesCheckBox"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="{I18N {x:Static pixeval:DownloadPageResources+DeleteLocalFiles.Content}}"
                    IsChecked="{Binding #Root.DeleteLocalFiles, Mode=TwoWay}" />
            </Grid>

            <TextBlock
                IsVisible="{Binding !!#Root.SelectedCount}"
                Text="{Binding #Root.SelectedCount, Converter={x:Static local:DownloadItemView.SelectionCountLabelConverter}}"
                TextWrapping="Wrap" />
            <CommandBar
                x:Name="BulkCommands"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="True">
                <CommandBarButton
                    Click="SelectAllButton_OnClicked"
                    Icon="{icons:SymbolIcon SelectAllOn}"
                    Label="{I18N {x:Static pixeval:DownloadPageResources+SelectAllButton.Label}}"
                    ToolTip.Tip="{Binding Label, RelativeSource={RelativeSource Self}}" />
                <CommandBarButton
                    Click="InvertSelectionButton_OnClicked"
                    Icon="{icons:SymbolIcon CheckboxCheckedSync}"
                    Label="{I18N {x:Static pixeval:MiscResources.InvertSelection}}"
                    ToolTip.Tip="{Binding Label, RelativeSource={RelativeSource Self}}" />
                <CommandBarButton
                    Click="CancelSelectButton_OnClicked"
                    Icon="{icons:SymbolIcon SelectAllOff}"
                    IsEnabled="{Binding !!#Root.SelectedCount}"
                    Label="{I18N {x:Static pixeval:DownloadPageResources.CancelSelectionButtonDefaultLabel}}"
                    ToolTip.Tip="{Binding Label, RelativeSource={RelativeSource Self}}" />
                <CommandBarButton
                    Click="ResumeAllButton_OnClicked"
                    Icon="{icons:SymbolIcon Play}"
                    IsEnabled="{Binding !!#Root.SelectedCount}"
                    Label="{I18N {x:Static pixeval:DownloadPageResources+ResumeButton.Label}}"
                    ToolTip.Tip="{Binding Label, RelativeSource={RelativeSource Self}}" />
                <CommandBarButton
                    Click="PauseAllButton_OnClicked"
                    Icon="{icons:SymbolIcon Pause}"
                    IsEnabled="{Binding !!#Root.SelectedCount}"
                    Label="{I18N {x:Static pixeval:DownloadPageResources+PauseButton.Label}}"
                    ToolTip.Tip="{Binding Label, RelativeSource={RelativeSource Self}}" />
                <CommandBarButton
                    Click="CancelAllButton_OnClicked"
                    Icon="{icons:SymbolIcon Stop}"
                    IsEnabled="{Binding !!#Root.SelectedCount}"
                    Label="{I18N {x:Static pixeval:DownloadPageResources+StopButton.Label}}"
                    ToolTip.Tip="{Binding Label, RelativeSource={RelativeSource Self}}" />
                <CommandBarButton
                    Click="ResetAllButton_OnClicked"
                    Icon="{icons:SymbolIcon ArrowRepeatAll}"
                    IsEnabled="{Binding !!#Root.SelectedCount}"
                    Label="{I18N {x:Static pixeval:DownloadPageResources+ResetButton.Label}}"
                    ToolTip.Tip="{Binding Label, RelativeSource={RelativeSource Self}}" />
                <CommandBarButton
                    Click="DeleteAllButton_OnClicked"
                    Icon="{icons:SymbolIcon Delete}"
                    IsEnabled="{Binding !!#Root.SelectedCount}"
                    Label="{I18N {x:Static pixeval:DownloadPageResources+DeleteButton.Label}}"
                    ToolTip.Tip="{Binding Label, RelativeSource={RelativeSource Self}}" />
            </CommandBar>
        </StackPanel>

        <entry:EntryView HasNoItem="{Binding #Root.HasNoDownloadItem}">
            <ListBox
                x:Name="ListBox"
                ItemsSource="{Binding #Root.DownloadItemsSource}"
                KeyboardNavigation.TabNavigation="Continue"
                SelectionChanged="ListBox_OnSelectionChanged"
                SelectionMode="Multiple">
                <ListBox.Styles>
                    <controls:ItemsViewListBoxStyles />
                    <Style Selector="ListBoxItem">
                        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
                    </Style>
                </ListBox.Styles>
                <ListBox.DataTemplates>
                    <DataTemplate x:DataType="{x:Type download:DownloadItemSnapshot}">
                        <Border Padding="16" Background="Transparent">
                            <local:DownloadItem OpenIllustrationRequested="DownloadItem_OnOpenIllustrationRequested" />
                        </Border>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>
        </entry:EntryView>
    </DockPanel>
</ContentPage>
