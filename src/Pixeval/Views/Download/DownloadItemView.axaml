<ContentPage
    x:Class="Pixeval.Views.Download.DownloadItemView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entry="using:Pixeval.Views.Works"
    xmlns:icons="using:FluentIcons.Avalonia.Markup"
    xmlns:local="using:Pixeval.Views.Download"
    xmlns:markup="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:options="using:Pixeval.Config"
    xmlns:pixeval="using:Pixeval"
    xmlns:download="using:Pixeval.Download"
    xmlns:viewModels="using:Pixeval.ViewModels.Download"
    x:DataType="{x:Type viewModels:DownloadItemPageViewModel}"
    x:Name="Root"
    Header="{CompiledBinding [DownloadPage-OrdinaryDownloadsButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="True">
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Orientation="Horizontal"
                Spacing="5">
                <controls:SymbolComboBox
                    MinWidth="150"
                    IconMode="False"
                    ItemsSource="{markup:EnumResources x:TypeArguments=options:DownloadListOption}"
                    SelectedValue="{Binding CurrentOption, Mode=TwoWay}" />
                <TextBox
                    Width="260"
                    KeyDown="FilterTextBox_OnKeyDown"
                    PlaceholderText="{CompiledBinding [DownloadPage-FilterAutoSuggestBox-PlaceholderText], Source={x:Static loc:LocalizationManager.Instance}}"
                    Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox
                    VerticalAlignment="Center"
                    Content="{CompiledBinding [DownloadPage-DeleteLocalFiles-Content], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsChecked="{Binding #Root.DeleteLocalFiles, Mode=TwoWay}" />
            </StackPanel>

            <CommandBar IsDynamicOverflowEnabled="True">
                <CommandBarButton
                    Click="SelectAllButton_OnClicked"
                    Icon="{icons:SymbolIcon SelectAllOn}"
                    Label="{CompiledBinding [DownloadPage-SelectAllButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                <CommandBarButton
                    Click="InvertSelectionButton_OnClicked"
                    Icon="{icons:SymbolIcon CheckboxCheckedSync}"
                    Label="{CompiledBinding [Misc-InvertSelection], Source={x:Static loc:LocalizationManager.Instance}}" />
                <CommandBarButton
                    Click="CancelSelectButton_OnClicked"
                    Icon="{icons:SymbolIcon SelectAllOff}"
                    IsEnabled="{Binding !!#Root.SelectedCount}"
                    Label="{Binding #Root.SelectedCount, Converter={x:Static local:DownloadItemView.SelectionCountLabelConverter}}" />
                <CommandBarButton
                    Click="ResumeAllButton_OnClicked"
                    Icon="{icons:SymbolIcon Play}"
                    IsEnabled="{Binding !!#Root.SelectedCount}"
                    Label="{CompiledBinding [DownloadPage-ResumeButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                <CommandBarButton
                    Click="PauseAllButton_OnClicked"
                    Icon="{icons:SymbolIcon Pause}"
                    IsEnabled="{Binding !!#Root.SelectedCount}"
                    Label="{CompiledBinding [DownloadPage-PauseButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                <CommandBarButton
                    Click="CancelAllButton_OnClicked"
                    Icon="{icons:SymbolIcon Stop}"
                    IsEnabled="{Binding !!#Root.SelectedCount}"
                    Label="{CompiledBinding [DownloadPage-StopButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                <CommandBarButton
                    Click="ResetAllButton_OnClicked"
                    Icon="{icons:SymbolIcon ArrowRepeatAll}"
                    IsEnabled="{Binding !!#Root.SelectedCount}"
                    Label="{CompiledBinding [DownloadPage-ResetButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                <CommandBarButton
                    Click="DeleteAllButton_OnClicked"
                    Icon="{icons:SymbolIcon Delete}"
                    IsEnabled="{Binding !!#Root.SelectedCount}"
                    Label="{CompiledBinding [DownloadPage-DeleteButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
            </CommandBar>
        </DockPanel>

        <entry:EntryView HasNoItem="{Binding #Root.HasNoDownloadItem}">
            <ListBox
                x:Name="ListBox"
                ItemsSource="{Binding #Root.DownloadItemsSource}"
                SelectionChanged="ListBox_OnSelectionChanged"
                SelectionMode="Multiple">
                <ListBox.Styles>
                    <controls:ItemsViewListBoxStyles />
                </ListBox.Styles>
                <ListBox.DataTemplates>
                    <DataTemplate x:DataType="{x:Type download:DownloadItemSnapshot}">
                        <Border Padding="16" Background="Transparent">
                            <local:DownloadItem OpenIllustrationRequested="DownloadItem_OnOpenIllustrationRequested" />
                        </Border>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>
        </entry:EntryView>
    </DockPanel>
</ContentPage>
