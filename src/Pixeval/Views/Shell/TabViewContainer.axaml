<local:ViewContainerBase
    x:Class="Pixeval.Views.Shell.TabViewContainer"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:di="using:Pixeval.Common.Markup"
    xmlns:services="using:Pixeval.Services.Core"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:local="using:Pixeval.Views.Shell"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigation="using:Pixeval.Config"
    xmlns:pixeval="using:Pixeval"
    xmlns:tabView="using:TabView.Avalonia"
    xmlns:utilities="using:Pixeval.Common"
    xmlns:viewModels="using:Pixeval.ViewModels.Shell"
    x:DataType="{x:Type viewModels:TabViewContainerViewModel}"
    x:Name="Root"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <Panel>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding #TabsControl.CurrentPage, Converter={x:Static ObjectConverters.IsNull}}"
            Spacing="10">
            <TextBlock
                HorizontalAlignment="Center"
                Text="{CompiledBinding [MainPage-LoggingIn-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                Theme="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="LoggingInDescriptionTextBlock"
                MaxWidth="400"
                IsVisible="False"
                Text="{CompiledBinding [MainPage-LoggingIn-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                TextWrapping="Wrap" />
        </StackPanel>
        <tabView:TabsView
            x:Name="TabsControl"
            AddTabButtonClick="TabsView_OnAddTabButtonClick"
            Background="Transparent"
            IsKeyboardNavigationEnabled="False"
            LeftHeaderContentDraggable="True"
            TabClosing="TabsView_OnTabClosing">
            <tabView:TabsView.ShowDefaultAddButton>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsLoggedIn" DataType="{x:Type services:IUserSessionService}" Source="{di:Service Type={x:Type services:IUserSessionService}}" />
                    <Binding Path="CanCreateNewTab" />
                </MultiBinding>
            </tabView:TabsView.ShowDefaultAddButton>
            <tabView:TabsView.LeftHeaderContent>
                <Border
                    Width="25"
                    Height="25"
                    Margin="16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{SvgResource avares://Pixeval/Assets/logo.svg}"
                    CornerRadius="{StaticResource ControlCornerRadius}" />
            </tabView:TabsView.LeftHeaderContent>
            <tabView:TabsView.RightHeaderContent>
                <Button
                    MaxWidth="32"
                    MaxHeight="32"
                    Padding="1"
                    Background="Transparent"
                    CornerRadius="100">
                    <controls:AvatarImage Source="{Binding Avatar}" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem
                                Click="{x:Static utilities:AvaloniaHelper.CopyTagToClipboard}"
                                Header="{Binding IdText, StringFormat='ID: {0}'}"
                                Icon="{markup:SymbolIcon Guest}"
                                IsEnabled="{Binding IsLoggedIn, Source={di:Service Type={x:Type services:IUserSessionService}}, DataType={x:Type services:IUserSessionService}}"
                                Tag="{Binding IdText}" />
                            <MenuItem
                                Command="{Binding OpenMyPageCommand}"
                                Header="{CompiledBinding [MainPage-OpenMyPageItem-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                                Icon="{markup:SymbolIcon Open}"
                                IsEnabled="{Binding IsLoggedIn, Source={di:Service Type={x:Type services:IUserSessionService}}, DataType={x:Type services:IUserSessionService}}" />
                            <MenuItem
                                Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                                Header="{CompiledBinding [MainPage-OpenMyPageInBrowserItem-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                                Icon="{markup:SymbolIcon GlobeArrowUp}"
                                IsEnabled="{Binding IsLoggedIn, Source={di:Service Type={x:Type services:IUserSessionService}}, DataType={x:Type services:IUserSessionService}}"
                                Tag="{Binding Url}" />
                            <Separator />
                            <!--  该项不显示  -->
                            <MenuItem
                                Command="{Binding ToggleRestrictedModeCommand, Mode=OneTime}"
                                Header="{CompiledBinding [MainPage-RestrictedModeItem-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                                Icon="{markup:SymbolIcon PersonProhibited}"
                                IsChecked="{Binding RestrictedCache}"
                                IsEnabled="{Binding IsLoggedIn, Source={di:Service Type={x:Type services:IUserSessionService}}, DataType={x:Type services:IUserSessionService}}"
                                IsVisible="False"
                                ToggleType="CheckBox" />
                            <MenuItem
                                Command="{Binding ToggleAiShowCommand, Mode=OneTime}"
                                Header="{CompiledBinding [MainPage-AiShowItem-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                                Icon="{markup:SymbolIcon Bot}"
                                IsChecked="{Binding AiShowCache}"
                                IsEnabled="{Binding IsLoggedIn, Source={di:Service Type={x:Type services:IUserSessionService}}, DataType={x:Type services:IUserSessionService}}"
                                ToggleType="CheckBox" />
                            <MenuItem
                                Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                                Header="{CompiledBinding [MainPage-MoreViewingSettingsItem-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                                Icon="{markup:SymbolIcon MoreHorizontal}"
                                IsEnabled="{Binding IsLoggedIn, Source={di:Service Type={x:Type services:IUserSessionService}}, DataType={x:Type services:IUserSessionService}}"
                                Tag="https://www.pixiv.net/settings/viewing" />
                            <Separator />
                            <MenuItem
                                Command="{Binding SwitchAccountCommand}"
                                Header="{CompiledBinding [MainPage-SwitchAccountItem-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                                Icon="{markup:SymbolIcon PersonSwap}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </tabView:TabsView.RightHeaderContent>
            <tabView:TabsView.LeftContent>
                <DockPanel
                    Margin="5"
                    HorizontalAlignment="Stretch"
                    VerticalSpacing="5">
                    <DockPanel.DataTemplates>
                        <DataTemplate x:DataType="{x:Type navigation:NavigationPageItem}">
                            <Button
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                Command="{x:Static local:TabViewContainer.OpenNavigationItemCommand}"
                                CommandParameter="{Binding $self}">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                        <Binding Path="!NeedLogin" />
                                        <Binding Path="IsLoggedIn" DataType="{x:Type services:IUserSessionService}" Source="{di:Service Type={x:Type services:IUserSessionService}}" />
                                    </MultiBinding>
                                </Button.IsEnabled>
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                                    <fluent:SymbolIcon
                                        HorizontalAlignment="Center"
                                        IconVariant="Color"
                                        Symbol="{Binding Icon}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Text="{Binding Header}" />
                                </Grid>
                            </Button>
                        </DataTemplate>

                        <DataTemplate x:DataType="{x:Type navigation:NavigationFolderItem}">
                            <Button HorizontalAlignment="Stretch" Background="Transparent">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                        <Binding Path="!NeedLogin" />
                                        <Binding Path="IsLoggedIn" DataType="{x:Type services:IUserSessionService}" Source="{di:Service Type={x:Type services:IUserSessionService}}" />
                                    </MultiBinding>
                                </Button.IsEnabled>
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                                    <fluent:SymbolIcon
                                        HorizontalAlignment="Center"
                                        IconVariant="Color"
                                        Symbol="{Binding Icon}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Text="{Binding Header}" />
                                </Grid>
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding Children}" Placement="Right">
                                        <MenuFlyout.ItemContainerTheme>
                                            <!--  ItemContainerTheme好像会自动向下传递，不需要此处递归指定（也没法递归指定）  -->
                                            <ControlTheme
                                                x:DataType="{x:Type navigation:NavigationMenuItem}"
                                                BasedOn="{StaticResource {x:Type MenuItem}}"
                                                TargetType="{x:Type MenuItem}">
                                                <Setter Property="Command" Value="{x:Static local:TabViewContainer.OpenNavigationItemCommand}" />
                                                <Setter Property="CommandParameter" Value="{Binding $self}" />
                                                <Setter Property="Header" Value="{Binding Header}" />
                                                <Setter Property="Icon" Value="{Binding Icon, Converter={x:Static converters:PixevalConverters.ColorSymbolIconConverter}}" />
                                                <Setter Property="ItemsSource" Value="{Binding Children}" />
                                                <Setter Property="IsEnabled">
                                                    <Setter.Value>
                                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                            <Binding Path="!NeedLogin" />
                                                            <Binding Path="IsLoggedIn" DataType="{x:Type services:IUserSessionService}" Source="{di:Service Type={x:Type services:IUserSessionService}}" />
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                            </ControlTheme>
                                        </MenuFlyout.ItemContainerTheme>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </DataTemplate>
                    </DockPanel.DataTemplates>

                    <ItemsControl
                        HorizontalAlignment="Stretch"
                        DockPanel.Dock="Bottom"
                        ItemsSource="{Binding FooterNavigationItems}" />
                    <ItemsControl HorizontalAlignment="Stretch" ItemsSource="{Binding HeaderNavigationItems}" />
                </DockPanel>
            </tabView:TabsView.LeftContent>
        </tabView:TabsView>
    </Panel>
</local:ViewContainerBase>
