<views:IconContentPage
    x:Class="Pixeval.Views.Login.LoginPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:storage="using:Pixeval.Storage"
    xmlns:viewModels="using:Pixeval.ViewModels.Login"
    xmlns:views="using:Pixeval.Views.Shell"
    x:DataType="{x:Type viewModels:LoginPageViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <views:IconContentPage.Resources>
        <DataTemplate x:DataType="{x:Type storage:LoginUserRecord}" x:Key="LoginUserTemplate">
            <controls:UserBasicInfoPresenter Margin="20,5" User="{Binding TokenUser}" />
        </DataTemplate>
    </views:IconContentPage.Resources>
    <StackPanel
        Width="300"
        Margin="50"
        VerticalAlignment="Center"
        DockPanel.Dock="Right"
        Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon
                Width="82"
                Height="29"
                HorizontalAlignment="Left"
                Data="{markup1:SvgPath {x:Static pixeval:SvgResources.Pixiv}}"
                Foreground="{DynamicResource PixivLogo}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{CompiledBinding [LoginPage-LoginHeader], Source={x:Static loc:LocalizationManager.Instance}}"
                Theme="{StaticResource SubtitleTextBlockStyle}" />
        </StackPanel>
        <ContentControl
            Content="{Binding SelectedUser}"
            ContentTemplate="{StaticResource LoginUserTemplate}"
            IsVisible="{Binding HasSelectedUser}" />
        <AutoCompleteBox
            HorizontalAlignment="Stretch"
            FilterMode="Custom"
            IsEnabled="{Binding !IsLoginInProgress}"
            IsTextCompletionEnabled="False"
            ItemFilter="{x:Static viewModels:LoginPageViewModel.LoginUserFilter}"
            ItemSelector="{x:Static viewModels:LoginPageViewModel.LoginUserTextSelector}"
            ItemTemplate="{StaticResource LoginUserTemplate}"
            ItemsSource="{Binding Users}"
            MinimumPrefixLength="0"
            PlaceholderText="{CompiledBinding [LoginPage-RefreshTokenBox-PlaceholderText], Source={x:Static loc:LocalizationManager.Instance}}"
            SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
            Tapped="RefreshTokenBox_OnTapped"
            Text="{Binding RefreshToken, Mode=TwoWay}" />
        <Button
            HorizontalAlignment="Stretch"
            Click="LoginButton_OnClick"
            Content="{CompiledBinding [LoginPage-RefreshTokenButton-Content], Source={x:Static loc:LocalizationManager.Instance}}"
            IsEnabled="{Binding !IsLoginInProgress}" />
        <Button
            HorizontalAlignment="Stretch"
            Click="OpenWebView_OnClick"
            Content="{CompiledBinding [LoginPage-WebViewButton-Content], Source={x:Static loc:LocalizationManager.Instance}}"
            IsEnabled="{Binding !IsLoginInProgress}" />
        <ProgressBar
            HorizontalAlignment="Stretch"
            IsIndeterminate="True"
            IsVisible="{Binding IsLoginInProgress}" />
    </StackPanel>
</views:IconContentPage>
