<views:IconContentPage
    x:Class="Pixeval.Views.Login.LoginPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:database="using:Pixeval.Storage"
    xmlns:login="using:Pixeval.Views.Login"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:viewModels="using:Pixeval.ViewModels.Login"
    xmlns:views="using:Pixeval.Views.Shell"
    x:DataType="{x:Type viewModels:LoginPageViewModel}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:storage="using:Pixeval.Storage">
    <views:IconContentPage.Resources>
        <DataTemplate x:DataType="{x:Type database:LoginUserRecord}" x:Key="LoginUserTemplate">
            <controls:UserBasicInfoPresenter
                Margin="8,5"
                AutomationProperties.Name="{Binding Converter={x:Static login:TokenAutoCompleteBox.AccountNameConverter}}"
                ToolTip.Tip="{Binding Name}"
                User="{Binding TokenUser}" />
        </DataTemplate>
    </views:IconContentPage.Resources>
    <views:IconContentPage.Styles>
        <Style Selector="AutoCompleteBox /template/ TextBox">
            <Setter Property="PasswordChar" Value="•" />
            <Setter Property="RevealPassword" Value="False" />
        </Style>
        <Style Selector="Button.loginAction /template/ ContentPresenter">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </views:IconContentPage.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <m3:MaterialSurface
            MaxWidth="440"
            Margin="16"
            Padding="24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
            CornerRadius="24">
            <StackPanel Spacing="16">
                <WrapPanel ItemSpacing="12" LineSpacing="8">
                    <PathIcon
                        Width="82"
                        Height="29"
                        HorizontalAlignment="Left"
                        Data="{markup1:SvgPath {x:Static pixeval:SvgResources.Pixiv}}"
                        Foreground="{DynamicResource PixivLogo}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        m3:MaterialText.Style="{m3:Typography HeadlineSmall}"
                        Text="{CompiledBinding [LoginPage-LoginHeader], Source={x:Static loc:LocalizationManager.Instance}}"
                        TextWrapping="Wrap" />
                </WrapPanel>
                <ContentControl
                    AutomationProperties.Name="{Binding SelectedUser, Converter={x:Static login:TokenAutoCompleteBox.AccountNameConverter}}"
                    Content="{Binding SelectedUser}"
                    ContentTemplate="{StaticResource LoginUserTemplate}"
                    IsVisible="{Binding HasSelectedUser}" />
                <!--
                    The editor owns selection while typing. Feeding model deselection back here
                    restores AutoCompleteBox's previous SearchText and loses the new token.
                -->
                <login:TokenAutoCompleteBox
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{CompiledBinding [LoginPage-RefreshTokenBox-PlaceholderText], Source={x:Static loc:LocalizationManager.Instance}}"
                    FilterMode="Custom"
                    IsEnabled="{Binding !IsLoginInProgress}"
                    IsTextCompletionEnabled="False"
                    ItemFilter="{x:Static viewModels:LoginPageViewModel.LoginUserFilter}"
                    ItemSelector="{x:Static viewModels:LoginPageViewModel.LoginUserTextSelector}"
                    ItemTemplate="{StaticResource LoginUserTemplate}"
                    ItemsSource="{Binding Users}"
                    MinimumPrefixLength="0"
                    PlaceholderText="{CompiledBinding [LoginPage-RefreshTokenBox-PlaceholderText], Source={x:Static loc:LocalizationManager.Instance}}"
                    SelectedItem="{Binding SelectedUser, Mode=OneWayToSource}"
                    Tapped="RefreshTokenBox_OnTapped"
                    Text="{Binding RefreshToken, Mode=TwoWay}">
                    <login:TokenAutoCompleteBox.Styles>
                        <Style x:DataType="{x:Type database:LoginUserRecord}" Selector="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Converter={x:Static login:TokenAutoCompleteBox.AccountNameConverter}}" />
                        </Style>
                    </login:TokenAutoCompleteBox.Styles>
                </login:TokenAutoCompleteBox>
                <Button
                    HorizontalAlignment="Stretch"
                    Classes="loginAction"
                    Click="LoginButton_OnClick"
                    Content="{CompiledBinding [LoginPage-RefreshTokenButton-Content], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsEnabled="{Binding !IsLoginInProgress}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Classes="loginAction"
                    Click="OpenWebView_OnClick"
                    Content="{CompiledBinding [LoginPage-WebViewButton-Content], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsEnabled="{Binding !IsLoginInProgress}"
                    Theme="{StaticResource MaterialOutlinedButtonTheme}" />
                <StackPanel IsVisible="{Binding IsLoginInProgress}" Spacing="8">
                    <ProgressBar AutomationProperties.Name="{CompiledBinding [MainPage-LoggingIn-Header], Source={x:Static loc:LocalizationManager.Instance}}" IsIndeterminate="{Binding IsLoginInProgress}" />
                    <TextBlock
                        m3:MaterialText.Style="{m3:Typography BodyMedium}"
                        Text="{CompiledBinding [MainPage-LoggingIn-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </m3:MaterialSurface>
    </ScrollViewer>
</views:IconContentPage>
