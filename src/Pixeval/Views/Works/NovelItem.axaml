<work:WorkItem
    x:Class="Pixeval.Views.Works.NovelItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:di="using:Pixeval.Common.Markup"
    xmlns:commands="using:Pixeval.ViewModels.Works"
    xmlns:appCommon="using:Pixeval.Common"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:Pixeval.Pixiv"
    xmlns:novel="using:Pixeval.ViewModels.Works"
    xmlns:pixeval="using:Pixeval"
    xmlns:utilities="using:Pixeval.Common"
    xmlns:work="using:Pixeval.Views.Works"
    x:DataType="{x:Type mako:Novel}"
    AutomationProperties.Name="{Binding Title}"
    Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
    Design.DataContext="{x:Static utilities:DesignHelper.DesignNovelViewModel}"
    Theme="{StaticResource WorkCardButtonTheme}"
    ToolTip.Tip="{Binding Title}"
    mc:Ignorable="d"
    d:DesignHeight="200"
    d:DesignWidth="400"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:mako="using:Pixeval.Mako">
    <work:WorkItem.ContextMenu>
        <ContextMenu>
            <MenuItem
                controls:ArtworkStateBehavior.TrackBookmark="True" Command="{Binding BookmarkCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}"
                CommandParameter="{Binding}"
                controls:BookmarkTagSelectorBehavior.IsEnabled="True"
                Header="{CompiledBinding [EntryItem-AddToBookmark], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup1:SymbolIconEx Heart}"
                IsVisible="{Binding IsBookmarkSupported}" />
            <MenuItem
                controls:ArtworkStateBehavior.TrackWatchLater="True" Command="{Binding AddToWatchLaterCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}"
                CommandParameter="{Binding}"
                Header="{CompiledBinding [EntryItem-AddToWatchLater], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup1:SymbolIconEx Clock}" />
            <MenuItem
                Command="{Binding OpenUserInfoPageCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}" CommandParameter="{Binding}"
                Header="{CompiledBinding [EntryItem-OpenUserInfoPage], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon Person}" />
            <MenuItem
                Click="BlockAuthor_OnClicked"
                Header="{CompiledBinding [BlockedContent-BlockAuthor], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon PersonProhibited}"
                IsVisible="{Binding IsBookmarkSupported}" />
            <MenuItem
                Command="{Binding OpenSeriesPageCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}" CommandParameter="{Binding}"
                Header="{CompiledBinding [EntryItem-OpenSeries], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon SquareMultiple}"
                IsVisible="{Binding HasSeries}" />
            <Separator />
            <MenuItem
                Command="{Binding SaveCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}"
                CommandParameter="{Binding}"
                Header="{CompiledBinding [EntryItem-Save], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon Save}" />
            <Separator />
            <MenuItem
                Click="{x:Static appCommon:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                Header="{CompiledBinding [EntryItem-OpenInWebBrowser], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon GlobeArrowUp}"
                Tag="{Binding WebsiteUri}" />
            <MenuItem
                Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                Header="{CompiledBinding [EntryItem-GenerateWebLink], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon LinkMultiple}"
                Tag="{Binding WebsiteUri}" />
            <MenuItem
                Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                Header="{CompiledBinding [EntryItem-GenerateLink], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon Link}"
                Tag="{Binding AppUri}" />
        </ContextMenu>
    </work:WorkItem.ContextMenu>
    <ContentControl>
        <Grid ClipToBounds="True" ColumnDefinitions="Auto,*">

            <controls:ConstrainedBox
                x:Name="CoverBounds"
                Grid.Column="0"
                AspectRatio="427:600"
                PointerEntered="InputElement_OnPointerEntered"
                PointerExited="InputElement_OnPointerExited">
                <Panel>
                    <Image
                        x:Name="CoverImage"
                        controls:Source.Cache="{Binding ThumbnailUrl}"
                        Stretch="UniformToFill">
                        <Image.Transitions>
                            <Transitions>
                                <DoubleTransition
                                    Easing="CubicEaseOut"
                                    Property="Opacity"
                                    Duration="0:0:0.5" />
                            </Transitions>
                        </Image.Transitions>
                    </Image>
                    <controls:MarkdownBox
                        x:Name="DescriptionBlock"
                        Margin="0,30,0,10"
                        Padding="10,0"
                        FocusAdorner="{StaticResource WorkCardFocusAdorner}"
                        GotFocus="DescriptionBlock_OnGotFocus"
                        LostFocus="DescriptionBlock_OnLostFocus"
                        Markdown="{Binding Caption}"
                        Opacity="0">
                        <controls:MarkdownBox.Transitions>
                            <Transitions>
                                <DoubleTransition
                                    Easing="CubicEaseOut"
                                    Property="Opacity"
                                    Duration="0:0:0.5" />
                            </Transitions>
                        </controls:MarkdownBox.Transitions>
                    </controls:MarkdownBox>
                </Panel>
            </controls:ConstrainedBox>

            <Border
                Width="40"
                Height="40"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                DoubleTapped="BookmarkButtonHost_OnTapped"
                IsVisible="{Binding IsBookmarkSupported}"
                PointerPressed="BookmarkButtonHost_OnPointerPressed"
                Tapped="BookmarkButtonHost_OnTapped">
                <controls:HeartButton
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{CompiledBinding [EntryItem-AddToBookmark], Source={x:Static loc:LocalizationManager.Instance}}"
                    controls:ArtworkStateBehavior.TrackBookmark="True" Command="{Binding BookmarkCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}"
                    CommandParameter="{Binding}"
                    FocusAdorner="{StaticResource WorkCardFocusAdorner}"
                    IsVisible="{Binding IsBookmarkSupported}"
                    Theme="{StaticResource TransparentButtonStyle}"
                    ToolTip.Tip="{CompiledBinding [EntryItem-AddToBookmark], Source={x:Static loc:LocalizationManager.Instance}}">

                    <controls:HeartButton.CacheMode>
                        <BitmapCache RenderAtScale="1" SnapsToDevicePixels="False" />
                    </controls:HeartButton.CacheMode>
                </controls:HeartButton>
            </Border>

            <Grid
                Grid.Column="1"
                Margin="10"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="4">
                <TextBlock
                    Grid.Row="0"
                    MaxLines="2"
                    Text="{Binding Title, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Theme="{StaticResource CaptionStrongTextBlockStyle}" />
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="4">
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding CreateDate, Converter={x:Static converters:PixevalConverters.DateTimeShortDate}}"
                        TextTrimming="CharacterEllipsis"
                        Theme="{StaticResource BodyTextBlockStyle}" />
                    <Button
                        MinWidth="0"
                        MinHeight="32"
                        Padding="2"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.Name="{Binding User.Name}"
                        Click="AuthorButton_OnClick"
                        Theme="{StaticResource MaterialTextButtonTheme}"
                        ToolTip.Tip="{Binding User.Name}">
                        <TextBlock
                            x:Name="AuthorTextBlock"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Text="{Binding User.Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Theme="{StaticResource BodyTextBlockStyle}" />
                    </Button>
                </Grid>
                <WrapPanel
                    x:Name="StatisticsPanel"
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    ItemSpacing="8"
                    LineSpacing="4">
                    <controls:IconText
                        Symbol="Eye"
                        Text="{Binding TotalView, Converter={x:Static converters:PixevalConverters.NumberEllipsis}}"
                        ToolTip.Tip="{Binding TotalView}" />
                    <controls:IconText
                        Symbol="Heart"
                        Text="{Binding TotalBookmarks, Converter={x:Static converters:PixevalConverters.NumberEllipsis}}"
                        ToolTip.Tip="{Binding TotalBookmarks}" />
                    <controls:IconText
                        Symbol="TextAlignLeft"
                        Text="{Binding TextLength, Converter={x:Static converters:PixevalConverters.NumberEllipsis}}"
                        ToolTip.Tip="{Binding TextLength}" />
                    <controls:PixevalBadge IsVisible="{Binding IsAiGenerated}" Mode="Ai" />
                    <controls:PixevalBadge Mode="{Binding XRestrict, Converter={x:Static converters:PixevalConverters.RestrictBadgeModeConverter}}" />
                </WrapPanel>

                <ScrollViewer
                    x:Name="TagsScrollViewer"
                    Grid.Row="3"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TagsList" ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="5" LineSpacing="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type mako:Tag}">
                                <Button
                                    MaxWidth="{Binding $parent[ItemsControl].Bounds.Width}"
                                    Padding="2"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="{Binding ToolTip}"
                                    Background="Transparent"
                                    Click="TagButton_OnClicked"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    FocusAdorner="{StaticResource WorkCardFocusAdorner}"
                                    Theme="{StaticResource TransparentButtonStyle}"
                                    ToolTip.Tip="{Binding ToolTip}">
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        MaxLines="2"
                                        Text="{Binding ToolTip, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Theme="{StaticResource CaptionTextBlockStyle}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </ContentControl>
</work:WorkItem>
