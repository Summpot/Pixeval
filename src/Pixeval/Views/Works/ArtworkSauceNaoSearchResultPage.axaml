<ContentPage
    x:Class="Pixeval.Views.Works.ArtworkSauceNaoSearchResultPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:work="using:Pixeval.Views.Works"
    Header="{I18N {x:Static pixeval:MainPageResources+Tab.SauceNaoResult}}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <ContentPage.Icon>
        <Image
            Width="16"
            Height="16"
            Source="avares://Pixeval/Assets/Platforms/saucenao.png" />
    </ContentPage.Icon>
    <DockPanel VerticalSpacing="12">
        <StackPanel
            x:Name="FailurePanel"
            Margin="12"
            DockPanel.Dock="Top"
            IsVisible="False"
            Spacing="8">
            <controls:InfoBar x:Name="SearchError" Mode="Error" />
            <Button
                x:Name="RetryButton"
                HorizontalAlignment="Left"
                Click="RetryButton_OnClick"
                Content="{I18N {x:Static pixeval:SearchResources+SauceNAO.Retry}}" />
        </StackPanel>
        <work:WorkContainer x:Name="WorkContainer" IsRefreshEnabled="False" />
    </DockPanel>
</ContentPage>
