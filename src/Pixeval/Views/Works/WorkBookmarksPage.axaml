<views:IconContentPage
    x:Class="Pixeval.Views.Works.WorkBookmarksPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:capability="using:Pixeval.Views.Works"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:Pixeval.Pixiv"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:Pixeval.Mako"
    xmlns:pixeval="using:Pixeval"
    xmlns:views="using:Pixeval.Views.Shell"
    xmlns:work="using:Pixeval.Views.Works"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    xmlns:nativeMako="clr-namespace:Pixeval.Mako"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:settings="using:Pixeval.Config">
    <work:WorkContainer x:Name="WorkContainer" RefreshRequested="WorkContainer_OnRefreshRequested">
        <work:WorkContainer.CommandBarElements>
            <ComboBox
                x:Name="TagComboBox"
                Width="240"
                MinWidth="0"
                MaxWidth="{Binding $parent[WrapPanel].Bounds.Width}"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="{CompiledBinding [HomePage-Source-TagTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                ItemsSource="{x:Static capability:WorkBookmarksPage.DefaultTags}"
                SelectedIndex="0"
                SelectionChanged="TagComboBox_OnSelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:BookmarkTag}">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <controls:SymbolComboBox
                x:Name="PrivacyPolicyComboBox"
                AutomationProperties.Name="{CompiledBinding [HomePage-Source-PrivacyPolicyTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                ItemsSource="{markup1:EnumResources x:TypeArguments=nativeMako:PrivacyRestrict}"
                SelectionChanged="WorkTypeComboBox_OnSelectionChanged" />
            <controls:SymbolComboBox
                x:Name="SimpleWorkTypeComboBox"
                AutomationProperties.Name="{CompiledBinding [HomePage-Source-SimpleWorkTypeTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                ItemsSource="{markup1:EnumResources x:TypeArguments=nativeMako:SimpleWorkKind}"

                SelectionChanged="WorkTypeComboBox_OnSelectionChanged" />
        </work:WorkContainer.CommandBarElements>
        <work:WorkContainer.CommandBarSubElements>
            <CommandBarButton
                x:Name="AddSubscriptionButton"
                VerticalAlignment="Stretch"
                Command="{Binding $parent[work:WorkBookmarksPage].AddSubscriptionCommand}"
                Icon="{markup:SymbolIcon Alert}"
                Label="{CompiledBinding [WorkSubscriptionsSettingsExpander-AddSubscriptionButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
            <CommandBarButton
                x:Name="RemoveSubscriptionButton"
                VerticalAlignment="Stretch"
                Command="{Binding $parent[work:WorkBookmarksPage].RemoveSubscriptionCommand}"
                Icon="{markup:SymbolIcon AlertOff}"
                IsVisible="False"
                Label="{CompiledBinding [WorkSubscriptionsSettingsExpander-RemoveSubscriptionButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
        </work:WorkContainer.CommandBarSubElements>
    </work:WorkContainer>
</views:IconContentPage>
