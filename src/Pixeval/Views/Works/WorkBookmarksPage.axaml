<views:IconContentPage
    x:Class="Pixeval.Views.Works.WorkBookmarksPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:di="using:Pixeval.Common.Markup"
    xmlns:settings="using:Pixeval.Config"
    xmlns:capability="using:Pixeval.Views.Works"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:Pixeval.Pixiv"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:Mako.Model"
    xmlns:pixeval="using:Pixeval"
    xmlns:views="using:Pixeval.Views.Shell"
    xmlns:work="using:Pixeval.Views.Works"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <work:WorkContainer x:Name="WorkContainer" RefreshRequested="WorkContainer_OnRefreshRequested">
        <work:WorkContainer.CommandBarElements>
            <ComboBox
                x:Name="TagComboBox"
                Width="240"
                MinWidth="0"
                MaxWidth="{Binding $parent[WrapPanel].Bounds.Width}"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="{I18N {x:Static pixeval:HomePageResources+Source+TagTextBlock.Text}}"
                ItemsSource="{x:Static capability:WorkBookmarksPage.DefaultTags}"
                SelectedIndex="0"
                SelectionChanged="TagComboBox_OnSelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:BookmarkTag}">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <controls:SymbolComboBox
                x:Name="PrivacyPolicyComboBox"
                AutomationProperties.Name="{I18N {x:Static pixeval:HomePageResources+Source+PrivacyPolicyTextBlock.Text}}"
                ItemsSource="{markup1:EnumResources x:TypeArguments=enum:PrivacyPolicy}"
                SelectionChanged="WorkTypeComboBox_OnSelectionChanged" />
            <controls:SymbolComboBox
                x:Name="SimpleWorkTypeComboBox"
                AutomationProperties.Name="{I18N {x:Static pixeval:HomePageResources+Source+SimpleWorkTypeTextBlock.Text}}"
                ItemsSource="{markup1:EnumResources x:TypeArguments=enum:SimpleWorkType}"
                SelectedValue="{Binding SearchSettings.DefaultSimpleWorkType, Source={di:Service Type={x:Type settings:AppSettings}}, DataType={x:Type settings:AppSettings}, Mode=OneTime}"
                SelectionChanged="WorkTypeComboBox_OnSelectionChanged" />
        </work:WorkContainer.CommandBarElements>
        <work:WorkContainer.CommandBarSubElements>
            <CommandBarButton
                x:Name="AddSubscriptionButton"
                VerticalAlignment="Stretch"
                Command="{Binding $parent[work:WorkBookmarksPage].AddSubscriptionCommand}"
                Icon="{markup:SymbolIcon Alert}"
                Label="{I18N {x:Static pixeval:WorkSubscriptionsSettingsExpanderResources+AddSubscriptionButton.Label}}" />
            <CommandBarButton
                x:Name="RemoveSubscriptionButton"
                VerticalAlignment="Stretch"
                Command="{Binding $parent[work:WorkBookmarksPage].RemoveSubscriptionCommand}"
                Icon="{markup:SymbolIcon AlertOff}"
                IsVisible="False"
                Label="{I18N {x:Static pixeval:WorkSubscriptionsSettingsExpanderResources+RemoveSubscriptionButton.Label}}" />
        </work:WorkContainer.CommandBarSubElements>
    </work:WorkContainer>
</views:IconContentPage>
