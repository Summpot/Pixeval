<work:WorkItem
    x:Class="Pixeval.Views.Works.IllustrationItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:di="using:Pixeval.Common.Markup"
    xmlns:commands="using:Pixeval.ViewModels.Works"
    xmlns:appCommon="using:Pixeval.Common"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:utilities="using:Pixeval.Common"
    xmlns:viewModels="using:Pixeval.ViewModels.Works"
    xmlns:work="using:Pixeval.Views.Works"
    x:DataType="{x:Type mako:Illustration}"
    AutomationProperties.Name="{Binding Title}"
    Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
    Design.DataContext="{x:Static utilities:DesignHelper.DesignIllustrationViewModel}"
    RenderTransformOrigin="50%,50%"
    Theme="{StaticResource WorkCardButtonTheme}"
    ToolTip.Tip="{Binding Tooltip}"
    mc:Ignorable="d"
    d:DesignHeight="250"
    d:DesignWidth="300"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:mako="using:Pixeval.Mako">
    <work:WorkItem.ContextMenu>
        <ContextMenu>
            <MenuItem
                AutomationProperties.Name="{CompiledBinding [EntryItem-AddToBookmark], Source={x:Static loc:LocalizationManager.Instance}}"
                controls:ArtworkStateBehavior.TrackBookmark="True" Command="{Binding BookmarkCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}"
                CommandParameter="{Binding}"
                controls:BookmarkTagSelectorBehavior.IsEnabled="True"
                Header="{CompiledBinding [EntryItem-AddToBookmark], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup1:SymbolIconEx Heart}"
                IsVisible="{Binding IsBookmarkSupported}" />
            <MenuItem
                controls:ArtworkStateBehavior.TrackWatchLater="True" Command="{Binding AddToWatchLaterCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}"
                CommandParameter="{Binding}"
                Header="{CompiledBinding [EntryItem-AddToWatchLater], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup1:SymbolIconEx Clock}" />
            <MenuItem
                Command="{Binding OpenUserInfoPageCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}" CommandParameter="{Binding}"
                Header="{CompiledBinding [EntryItem-OpenUserInfoPage], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon Person}" />
            <MenuItem
                Click="BlockAuthor_OnClicked"
                Header="{CompiledBinding [BlockedContent-BlockAuthor], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon PersonProhibited}"
                IsVisible="{Binding IsBookmarkSupported}" />
            <MenuItem
                Command="{Binding OpenSeriesPageCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}" CommandParameter="{Binding}"
                Header="{CompiledBinding [EntryItem-OpenSeries], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon SquareMultiple}"
                IsVisible="{Binding HasSeries}" />
            <Separator />
            <MenuItem
                Command="{Binding CopyCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}"
                CommandParameter="{Binding #ThumbnailImage, Mode=OneTime}"
                Header="{CompiledBinding [EntryItem-Copy], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon Copy}"
                IsEnabled="{Binding #ThumbnailImage.(controls:Source.Loaded)}" />
            <MenuItem
                Command="{Binding SaveCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}"
                CommandParameter="{Binding}"
                Header="{CompiledBinding [EntryItem-Save], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon Save}" />
            <Separator />
            <MenuItem
                Click="{x:Static appCommon:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                Header="{CompiledBinding [EntryItem-OpenInWebBrowser], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon GlobeArrowUp}"
                Tag="{Binding WebsiteUri}" />
            <MenuItem
                Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                Header="{CompiledBinding [EntryItem-GenerateWebLink], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon LinkMultiple}"
                Tag="{Binding WebsiteUri}" />
            <MenuItem
                Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                Header="{CompiledBinding [EntryItem-GenerateLink], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon Link}"
                Tag="{Binding AppUri}" />
        </ContextMenu>
    </work:WorkItem.ContextMenu>
    <ContentControl ClipToBounds="True">

        <Border HorizontalAlignment="Stretch">
            <Panel>
                <controls:ConstrainedBox
                    x:Name="ThumbnailBounds"
                    AspectRatio="{Binding AspectRatio, Converter={x:Static converters:PixevalConverters.ToAspectRatio}}"
                    RestrictArrange="False">
                    <Image
                        x:Name="ThumbnailImage"
                        controls:Source.Cache="{Binding ThumbnailUrl}"
                        controls:Source.DecodeTarget="{Binding #ThumbnailBounds}"
                        Stretch="UniformToFill" />
                </controls:ConstrainedBox>
                <controls:Skeleton IsVisible="{Binding !#ThumbnailImage.(controls:Source.Loaded)}" />
                <Border
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    DoubleTapped="BookmarkButtonHost_OnTapped"
                    IsVisible="{Binding IsBookmarkSupported}"
                    PointerPressed="BookmarkButtonHost_OnPointerPressed"
                    Tapped="BookmarkButtonHost_OnTapped">
                    <controls:HeartButton
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{CompiledBinding [EntryItem-AddToBookmark], Source={x:Static loc:LocalizationManager.Instance}}"
                        controls:ArtworkStateBehavior.TrackBookmark="True" Command="{Binding BookmarkCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}"
                        CommandParameter="{Binding}"
                        FocusAdorner="{StaticResource WorkCardFocusAdorner}"
                        IsVisible="{Binding IsBookmarkSupported}"
                        Theme="{StaticResource TransparentButtonStyle}"
                        ToolTip.Tip="{CompiledBinding [EntryItem-AddToBookmark], Source={x:Static loc:LocalizationManager.Instance}}">

                        <controls:HeartButton.CacheMode>
                            <BitmapCache RenderAtScale="1" SnapsToDevicePixels="False" />
                        </controls:HeartButton.CacheMode>
                    </controls:HeartButton>
                </Border>
                <Border
                    Margin="5"
                    Padding="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ControlOnImageFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    IsVisible="{Binding HasSeries}">
                    <fluent:SymbolIcon
                        FontSize="{StaticResource SmallIconFontSize}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Symbol="SquareMultiple" />
                </Border>
                <DockPanel
                    Margin="10"
                    VerticalAlignment="Bottom"
                    HorizontalSpacing="3"
                    LastChildFill="False">
                    <controls:PixevalBadge
                        DockPanel.Dock="Left"
                        IsVisible="{Binding IsAiGenerated}"
                        Mode="Ai" />
                    <controls:PixevalBadge DockPanel.Dock="Left" Mode="{Binding SafeRating, Converter={x:Static converters:PixevalConverters.SafeBadgeModeConverter}}" />
                </DockPanel>
                <Border
                    Margin="5"
                    Padding="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource ControlOnImageFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    IsVisible="{Binding !IsPicOne}">
                    <Panel>
                        <controls:IconText
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            IsVisible="{Binding IsPicSet}"
                            Symbol="ImageMultiple"
                            Text="{Binding PageCount}" />
                        <fluent:SymbolIcon
                            FontSize="{StaticResource SmallIconFontSize}"
                            IsVisible="{Binding IsPicGif}"
                            Symbol="Gif" />
                    </Panel>
                </Border>
            </Panel>
        </Border>
    </ContentControl>
</work:WorkItem>
