<views:IconContentPage
    x:Class="Pixeval.Views.Works.WorkRankingPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:nativeMako="clr-namespace:Pixeval.Mako"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:di="using:Pixeval.Common.Markup"
    xmlns:settings="using:Pixeval.Config"
    xmlns:capability="using:Pixeval.Views.Works"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:Pixeval.Pixiv"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Pixeval.Views.Shell"
    xmlns:work="using:Pixeval.Views.Works"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <work:WorkContainer x:Name="WorkContainer" RefreshRequested="WorkContainer_OnRefreshRequested">
        <work:WorkContainer.CommandBarElements>
            <CalendarDatePicker
                x:Name="RankDateTimeCalendarDatePicker"
                Width="240"
                MinWidth="0"
                MaxWidth="{Binding $parent[WrapPanel].Bounds.Width}"
                AutomationProperties.Name="{I18N {x:Static pixeval:HomePageResources+Source+RankingDateTextBlock.Text}}"
                DateValidationError="RankDateTimeCalendarDatePicker_OnDateValidationError"
                DisplayDateEnd="{x:Static capability:WorkRankingPage.MaxDate}"
                SelectedDate="{x:Static capability:WorkRankingPage.MaxDate}"
                SelectedDateChanged="CalendarDatePicker_OnSelectedDateChanged"
                SelectedDateFormat="Short"
                TemplateApplied="RankDateTimeCalendarDatePicker_OnTemplateApplied" />
            <controls:SymbolComboBox
                x:Name="RankOptionComboBox"
                Width="240"
                MinWidth="0"
                MaxWidth="{Binding $parent[WrapPanel].Bounds.Width}"
                AutomationProperties.Name="{I18N {x:Static pixeval:HomePageResources+Source+RankOptionTextBlock.Text}}"
                IconMode="False"
                SelectionChanged="RankOptionComboBox_OnSelectionChanged">
                <controls:SymbolComboBox.TextItemTemplate>
                    <DataTemplate x:DataType="{x:Type controls:SymbolComboBoxItem}">
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    </DataTemplate>
                </controls:SymbolComboBox.TextItemTemplate>
            </controls:SymbolComboBox>
            <controls:SymbolComboBox
                x:Name="SimpleWorkTypeComboBox"
                ItemsSource="{markup1:EnumResources x:TypeArguments=nativeMako:SimpleWorkKind}"
                SelectedValue="{Binding SearchSettings.DefaultSimpleWorkType, Source={di:Service Type={x:Type settings:AppSettings}}, DataType={x:Type settings:AppSettings}, Mode=OneTime}"
                SelectionChanged="SimpleWorkTypeComboBox_OnSelectionChanged" />
        </work:WorkContainer.CommandBarElements>
    </work:WorkContainer>
</views:IconContentPage>
