<entry:EntryItem
    x:Class="Pixeval.Views.Works.SeriesItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entry="using:Pixeval.Views.Works"
    xmlns:mako="using:Pixeval.Mako"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:utilities="using:Pixeval.Common"
    xmlns:di="using:Pixeval.Common.Markup"
    xmlns:viewModels="using:Pixeval.ViewModels.Works"
    x:DataType="{x:Type mako:Series}"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
    Design.DataContext="{x:Static utilities:DesignHelper.DesignSeriesViewModel}"
    Theme="{StaticResource RoundedButtonStyle}"
    mc:Ignorable="d"
    d:DesignHeight="220"
    d:DesignWidth="360">
    <Grid ClipToBounds="True" ColumnDefinitions="Auto,*">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem
                    Click="LatestContentButton_OnClick"
                    Header="{I18N {x:Static pixeval:SeriesPageResources.ViewLatestContent}}"
                    Icon="{markup:SymbolIcon ArrowRight}" />
                <MenuItem
                    Command="{Binding OpenUserInfoPageCommand, Source={di:Service Type={x:Type viewModels:WorkCommands}}, DataType={x:Type viewModels:WorkCommands}}"
                    CommandParameter="{Binding}"
                    Header="{I18N {x:Static pixeval:EntryItemResources.OpenUserInfoPage}}"
                    Icon="{markup:SymbolIcon Person}" />
                <Separator />
                <MenuItem
                    Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                    Header="{I18N {x:Static pixeval:EntryItemResources.OpenInWebBrowser}}"
                    Icon="{markup:SymbolIcon GlobeArrowUp}"
                    Tag="{Binding WebsiteUri}" />
                <MenuItem
                    Click="{x:Static utilities:AvaloniaHelper.CopyTagToClipboard}"
                    Header="{I18N {x:Static pixeval:EntryItemResources.GenerateWebLink}}"
                    Icon="{markup:SymbolIcon LinkMultiple}"
                    Tag="{Binding WebsiteUri}" />
                <MenuItem
                    Click="{x:Static utilities:AvaloniaHelper.CopyTagToClipboard}"
                    Header="{I18N {x:Static pixeval:EntryItemResources.GenerateLink}}"
                    Icon="{markup:SymbolIcon Link}"
                    Tag="{Binding AppUri}" />
            </ContextMenu>
        </Grid.ContextMenu>
        <controls:ConstrainedBox AspectRatio="427:600">
            <Image controls:Source.Cache="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
        </controls:ConstrainedBox>
        <Grid
            Grid.Column="1"
            Margin="12"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="7">
            <TextBlock
                MaxLines="5"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Theme="{StaticResource BodyLargeStrongTextBlockStyle}" />
            <DockPanel Grid.Row="1" HorizontalSpacing="8">
                <TextBlock
                    VerticalAlignment="Bottom"
                    DockPanel.Dock="Right"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding LastPublishedContentDatetime, Converter={x:Static converters:PixevalConverters.DateTimeShortDate}}"
                    TextTrimming="CharacterEllipsis"
                    Theme="{StaticResource CaptionTextBlockStyle}" />
                <Button Padding="2" Command="{Binding OpenUserInfoPageCommand, Source={di:Service Type={x:Type viewModels:WorkCommands}}, DataType={x:Type viewModels:WorkCommands}}" CommandParameter="{Binding}">
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Text="{Binding User.Value.Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Button>
            </DockPanel>
            <DockPanel Grid.Row="3" HorizontalSpacing="8">
                <Button
                    HorizontalAlignment="Right"
                    Click="LatestContentButton_OnClick"
                    DockPanel.Dock="Right">
                    <controls:IconText Symbol="ArrowRight" Text="{I18N {x:Static pixeval:SeriesPageResources.ViewLatestContent}}" />
                </Button>
                <controls:IconText
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="SquareMultiple"
                    Text="{Binding PublishedContentCount}" />
            </DockPanel>
        </Grid>
    </Grid>
</entry:EntryItem>
