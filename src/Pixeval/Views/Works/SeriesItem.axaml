<m3:Card
    x:Class="Pixeval.Views.Works.SeriesItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:appCommon="using:Pixeval.Common"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:utilities="using:Pixeval.Common"
    xmlns:viewModels="using:Pixeval.ViewModels.Works"
    x:DataType="{x:Type mako:Series}"
    Padding="0"
    AutomationProperties.Name="{Binding Title}"
    Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
    Design.DataContext="{x:Static utilities:DesignHelper.DesignSeriesViewModel}"
    Theme="{StaticResource ContentCardTheme}"
    ToolTip.Tip="{Binding Title}"
    mc:Ignorable="d"
    d:DesignHeight="220"
    d:DesignWidth="360"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:entry="using:Pixeval.Views.Works"
    xmlns:mako="using:Pixeval.Mako"
    xmlns:di="using:Pixeval.Common.Markup">
    <m3:Card.ContextMenu>
        <ContextMenu>
            <MenuItem
                Click="LatestContentButton_OnClick"
                Header="{CompiledBinding [SeriesPage-ViewLatestContent], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon ArrowRight}" />
            <MenuItem
                Click="AuthorButton_OnClick"
                Header="{CompiledBinding [EntryItem-OpenUserInfoPage], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon Person}" />
            <Separator />
            <MenuItem
                Click="{x:Static appCommon:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                Header="{CompiledBinding [EntryItem-OpenInWebBrowser], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon GlobeArrowUp}"
                Tag="{Binding WebsiteUri}" />
            <MenuItem
                Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                Header="{CompiledBinding [EntryItem-GenerateWebLink], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon LinkMultiple}"
                Tag="{Binding WebsiteUri}" />
            <MenuItem
                Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                Header="{CompiledBinding [EntryItem-GenerateLink], Source={x:Static loc:LocalizationManager.Instance}}"
                Icon="{markup:SymbolIcon Link}"
                Tag="{Binding AppUri}" />
        </ContextMenu>
    </m3:Card.ContextMenu>
    <Grid
        x:Name="SeriesLayout"
        ClipToBounds="True"
        ColumnDefinitions="96,*">
        <Border ClipToBounds="True">
            <Image controls:Source.Cache="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
        </Border>
        <Grid
            Grid.Column="1"
            Margin="10"
            RowDefinitions="Auto,Auto,Auto,*"
            RowSpacing="4">
            <TextBlock
                MaxLines="3"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Theme="{StaticResource BodyLargeStrongTextBlockStyle}" />
            <Button
                x:Name="AuthorButton"
                Grid.Row="1"
                Padding="0"
                HorizontalContentAlignment="Left"
                AutomationProperties.Name="{Binding User.Value.Name}"
                Click="AuthorButton_OnClick"
                Theme="{StaticResource MaterialTextButtonTheme}"
                ToolTip.Tip="{Binding User.Value.Name}">
                <TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Text="{Binding User.Value.Name}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Button>
            <Grid
                Grid.Row="2"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="8">
                <controls:IconText
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="SquareMultiple"
                    Text="{Binding PublishedContentCount}" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding LastPublishedContentDatetime, Converter={x:Static converters:PixevalConverters.DateTimeShortDate}}"
                    TextTrimming="CharacterEllipsis"
                    Theme="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
            <Button
                x:Name="LatestContentButton"
                Grid.Row="3"
                Padding="12,4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="{CompiledBinding [SeriesPage-ViewLatestContent], Source={x:Static loc:LocalizationManager.Instance}}"
                Click="LatestContentButton_OnClick"
                Theme="{StaticResource MaterialTonalButtonTheme}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{CompiledBinding [SeriesPage-ViewLatestContent], Source={x:Static loc:LocalizationManager.Instance}}"
                        TextWrapping="Wrap" />
                    <ContentControl
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="{markup:SymbolIcon ArrowRight}" />
                </Grid>
            </Button>
        </Grid>
    </Grid>
</m3:Card>
