<views:IconContentPage
    x:Class="Pixeval.Views.Works.UserFollowingPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entry="using:Pixeval.Views.Works"
    xmlns:enum="using:Pixeval.Pixiv"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:views="using:Pixeval.Views.Shell"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    xmlns:nativeMako="clr-namespace:Pixeval.Mako">
    <entry:UserContainer x:Name="UserContainer" RefreshRequested="UserContainer_OnRefreshRequested">
        <entry:UserContainer.CommandBarElements>
            <controls:SymbolComboBox
                x:Name="PrivacyPolicyComboBox"
                AutomationProperties.Name="{CompiledBinding [HomePage-Source-PrivacyPolicyTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                ItemsSource="{markup1:EnumResources x:TypeArguments=nativeMako:PrivacyRestrict}"
                SelectionChanged="WorkTypeComboBox_OnSelectionChanged" />
        </entry:UserContainer.CommandBarElements>
    </entry:UserContainer>
</views:IconContentPage>
