<views:IconContentPage
    x:Class="Pixeval.Views.Works.SeriesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entry="using:Pixeval.Views.Works"
    xmlns:enum="using:Pixeval.Pixiv"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:views="using:Pixeval.Views.Shell"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    xmlns:nativeMako="clr-namespace:Pixeval.Mako"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:settings="using:Pixeval.Config">
    <DockPanel>
        <Grid
            Margin="12,8"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8"
            DockPanel.Dock="Top">
            <CommandBar
                Grid.Column="1"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="True">
                <CommandBarButton
                    x:Name="RefreshButton"
                    AutomationProperties.Name="{CompiledBinding [WorkContainer-RefreshButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="RefreshButton_OnClick"
                    Icon="{markup:SymbolIcon ArrowClockwise}"
                    Label="{CompiledBinding [WorkContainer-RefreshButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
            </CommandBar>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">
                <controls:SymbolComboBox
                    x:Name="SimpleWorkTypeComboBox"
                    AutomationProperties.Name="{CompiledBinding [HomePage-Source-SimpleWorkTypeTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                    ItemsSource="{markup1:EnumResources x:TypeArguments=nativeMako:SimpleWorkKind}"

                    SelectionChanged="SimpleWorkTypeComboBox_OnSelectionChanged" />
            </StackPanel>
        </Grid>
        <entry:SeriesView x:Name="SeriesView" />
    </DockPanel>
</views:IconContentPage>
