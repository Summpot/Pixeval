<views:IconContentPage
    x:Class="Pixeval.Views.Viewers.NovelViewerPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:settings="using:Pixeval.Config"
    xmlns:commands="using:Pixeval.ViewModels.Works"
    xmlns:appCommon="using:Pixeval.Common"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:FluentIcons.Common"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pixeval.Views.Viewers"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:novel="using:Pixeval.ViewModels.Works"
    xmlns:pixeval="using:Pixeval"
    xmlns:utilities="using:Pixeval.Common"
    xmlns:viewers="using:Pixeval.ViewModels.Viewers"
    xmlns:views="using:Pixeval.Views"
    xmlns:work="using:Pixeval.Views.Works"
    x:DataType="{x:Type viewers:NovelViewerPageViewModel}"
    Header="{Binding CurrentNovel.Value.Title, FallbackValue={x:Null}}"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    xmlns:nativeMako="clr-namespace:Pixeval.Mako"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:capability="using:Pixeval.Views.Works"
    xmlns:di="using:Pixeval.Common.Markup"
    xmlns:mako="using:Pixeval.Mako"
    xmlns:config="using:Pixeval.Config"
    xmlns:shell="using:Pixeval.Views.Shell">
    <views:IconContentPage.Styles>
        <Style Selector="controls|PageButton:focus-visible">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </views:IconContentPage.Styles>
    <Grid RowDefinitions="*,Auto,Auto" SizeChanged="ReaderLayout_OnSizeChanged">
        <SplitView
            x:Name="InfoSplitView"
            Grid.Row="0"
            DisplayMode="Inline"
            IsPaneOpen="{Binding OpenWorkInfo, Source={di:Service Type={x:Type settings:PixevalSettings}}, DataType={x:Type settings:PixevalSettings}, Mode=TwoWay}">
            <SplitView.Pane>
                <DockPanel>
                    <local:WorkSeriesInfoPane DataContext="{Binding SeriesInfo}" DockPanel.Dock="Bottom" />
                    <TabbedPage Pages="{Binding PanePages}" TabPlacement="Bottom" />
                </DockPanel>
            </SplitView.Pane>

            <DockPanel>
                <CommandBar
                    x:Name="ReaderCommands"
                    Margin="8"
                    HorizontalAlignment="Center"
                    Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainer}}"
                    DefaultLabelPosition="Collapsed"
                    DockPanel.Dock="Top"
                    IsDynamicOverflowEnabled="True">
                    <CommandBarButton
                        x:Name="ReloadButton"
                        Command="{Binding RetryCommand}"
                        Icon="{markup:SymbolIcon ArrowClockwise}"
                        IsVisible="{Binding LoadErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Label="{CompiledBinding [WorkContainer-RefreshButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <CommandBarButton
                        Command="{Binding BookmarkCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}"
                        CommandParameter="{Binding CurrentNovel}"
                        ContextRequested="AddToBookmarkButton_OnClick"
                        Icon="{markup1:SymbolIconEx Heart,
                                                    IconVariant={Binding CurrentUiState.BookmarkState,
                                                                         Converter={x:Static converters:PixevalConverters.StateToIconVariant}}}"
                        IsVisible="{Binding CurrentNovel.Value.IsBookmarkSupported, FallbackValue={x:False}}"
                        Label="{CompiledBinding [EntryItem-AddToBookmark], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <CommandBarSeparator />
                    <CommandBarButton
                        Command="{Binding SaveCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}"
                        CommandParameter="{Binding CurrentNovel}"
                        Icon="{markup:SymbolIcon Save}"
                        Label="{CompiledBinding [EntryItem-Save], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <CommandBarSeparator />
                    <CommandBarButton
                        x:Name="TranslationButton"
                        Command="{Binding ToggleTranslationCommand}"
                        CommandParameter="{Binding $self, Mode=OneTime}"
                        Icon="{markup1:SymbolIconEx Symbol={markup1:EitherBinding {Binding IsTranslationShown},
                                                                                  TranslateOff,
                                                                                  TranslateAuto,
                                                                                  x:TypeArguments=common:Symbol}}"
                        IsVisible="{Binding IsTranslationAvailable}"
                        Label="{Binding TranslationButtonText}">
                        <CommandBarButton.ContextMenu>
                            <ContextMenu ItemsSource="{Binding TransformerExtensionItems}">
                                <ContextMenu.ItemContainerTheme>
                                    <ControlTheme
                                        x:DataType="{x:Type viewers:TextTransformerExtensionCommandItem}"
                                        BasedOn="{StaticResource {x:Type MenuItem}}"
                                        TargetType="{x:Type MenuItem}">
                                        <Setter Property="Command" Value="{Binding Command}" />
                                        <Setter Property="CommandParameter" Value="{Binding $self}" />
                                        <Setter Property="Tag" Value="{Binding Extension}" />
                                        <Setter Property="Header" Value="{Binding Label}" />
                                        <Setter Property="Icon" Value="{Binding Symbol, Converter={x:Static converters:PixevalConverters.SymbolIconConverter}}" />
                                        <Setter Property="ToolTip.Tip" Value="{Binding Description}" />
                                    </ControlTheme>
                                </ContextMenu.ItemContainerTheme>
                            </ContextMenu>
                        </CommandBarButton.ContextMenu>
                    </CommandBarButton>
                    <CommandBarButton
                        x:Name="CancelTranslationButton"
                        Command="{Binding ToggleTranslationCancelCommand}"
                        Icon="{markup:SymbolIcon Dismiss}"
                        IsVisible="{Binding ToggleTranslationCommand.IsRunning}"
                        Label="{CompiledBinding [NovelViewerPage-CancelTranslation], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <CommandBarSeparator IsVisible="{Binding IsTranslationAvailable}" />
                    <CommandBarButton
                        Command="{Binding AddToWatchLaterCommand, Source={di:Service Type={x:Type commands:WorkCommands}}, DataType={x:Type commands:WorkCommands}}"
                        CommandParameter="{Binding CurrentNovel}"
                        Icon="{markup1:SymbolIconEx Clock,
                                                    IconVariant={Binding CurrentUiState.IsInWatchLater,
                                                                         Converter={x:Static converters:PixevalConverters.BoolToIconVariant}}}"
                        Label="{CompiledBinding [EntryItem-AddToWatchLater], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <!--<CommandBarButton
                            Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                            Icon="{markup:SymbolIcon Link}"
                            Label="{CompiledBinding [EntryItem-GenerateLink], Source={x:Static loc:LocalizationManager.Instance}}"
                            Tag="{Binding CurrentNovel.Value.AppUri}" />-->
                    <CommandBarButton
                        Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                        Icon="{markup:SymbolIcon LinkMultiple}"
                        Label="{CompiledBinding [EntryItem-GenerateWebLink], Source={x:Static loc:LocalizationManager.Instance}}"
                        Tag="{Binding CurrentNovel.Value.WebsiteUri, FallbackValue={x:Null}}" />
                    <CommandBarButton
                        Click="{x:Static appCommon:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Icon="{markup:SymbolIcon GlobeArrowUp}"
                        Label="{CompiledBinding [EntryItem-OpenInWebBrowser], Source={x:Static loc:LocalizationManager.Instance}}"
                        Tag="{Binding CurrentNovel.Value.WebsiteUri, FallbackValue={x:Null}}" />
                </CommandBar>

                <Border Background="{Binding NovelBackground, Converter={x:Static converters:PixevalConverters.OptionalColorToBrush}}">
                    <Panel>
                        <controls:NovelMarkdownBox
                            x:Name="ReaderMarkdown"
                            MaxWidth="{Binding NovelMaxWidth}"
                            Margin="40,20"
                            HyperlinkClicked="MarkdownBox_OnHyperlinkClicked"
                            Markdown="{Binding CurrentMarkdown}"
                            MarkdownFontFamily="{Binding NovelFontFamilyObject}"
                            MarkdownFontSize="{Binding NovelFontSize}"
                            MarkdownFontWeight="{Binding NovelFontWeight}"
                            MarkdownForeground="{Binding NovelFontColor, Converter={x:Static converters:PixevalConverters.OptionalColorToBrush}}"
                            MarkdownLineHeight="{Binding NovelLineHeight}" />

                        <controls:ViewerStateOverlay ErrorMessage="{Binding LoadErrorMessage}" IsLoading="{Binding IsLoading}" />

                        <controls:PageButton
                            x:Name="PreviousPageButton"
                            Width="40"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="{Binding PrevButtonText}"
                            Command="{Binding PrevCommand}"
                            ContextRequested="PrevButton_OnRightClick"
                            FontSize="24"
                            IsVisible="{Binding PrevButtonText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Symbol="ChevronLeft"
                            ToolTipText="{Binding PrevButtonText}" />
                        <controls:PageButton
                            x:Name="NextPageButton"
                            Width="40"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="{Binding NextButtonText}"
                            Command="{Binding NextCommand}"
                            ContextRequested="NextButton_OnRightClick"
                            FontSize="24"
                            IsVisible="{Binding NextButtonText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Symbol="ChevronRight"
                            ToolTipText="{Binding NextButtonText}" />
                        <ProgressBar
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            IsIndeterminate="True"
                            IsVisible="{Binding ToggleTranslationCommand.IsRunning}" />
                    </Panel>
                </Border>
            </DockPanel>
        </SplitView>

        <ListBox
            x:Name="NovelList"
            Grid.Row="1"
            Height="90"
            Margin="5,0"
            Padding="0,0,0,5"
            HorizontalAlignment="Stretch"
            controls:IncrementalLoadingBehavior.IsEnabled="True"
            controls:IncrementalLoadingBehavior.Threshold="100"
            AutomationProperties.Name="{CompiledBinding [Misc-OpenBottomList], Source={x:Static loc:LocalizationManager.Instance}}"
            IsVisible="{Binding IsBottomListOpen}"
            ItemsSource="{Binding Novels}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            SelectedIndex="{Binding CurrentWorkIndex}"
            SelectionMode="Single">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="5" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerTheme>
                <ControlTheme
                    x:DataType="{x:Type nativeMako:Novel}"
                    BasedOn="{StaticResource {x:Type ListBoxItem}}"
                    TargetType="{x:Type ListBoxItem}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Setter Property="ToolTip.Tip" Value="{Binding Title}" />
                </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="{x:Type nativeMako:Novel}">
                    <Image
                        Width="80"
                        Height="80"
                        controls:Source.Cache="{Binding ThumbnailUrl}"
                        Stretch="UniformToFill" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border
            x:Name="ReaderStatusBar"
            Grid.Row="2"
            MinHeight="56"
            Margin="8"
            Padding="8,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainer}}"
            CornerRadius="16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <CommandBar
                    Grid.Column="0"
                    DefaultLabelPosition="Collapsed"
                    IsDynamicOverflowEnabled="True">
                    <CommandBarToggleButton
                        x:Name="InformationButton"
                        Icon="{markup:SymbolIcon Info}"
                        IsChecked="{Binding #InfoSplitView.IsPaneOpen}"
                        Label="{CompiledBinding [EntryViewerPage-InfoAndComments], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <CommandBarToggleButton
                        x:Name="BottomListButton"
                        Icon="{markup:SymbolIcon PanelBottomExpand}"
                        IsChecked="{Binding IsBottomListOpen}"
                        Label="{CompiledBinding [Misc-OpenBottomList], Source={x:Static loc:LocalizationManager.Instance}}" />
                </CommandBar>
                <TextBlock
                    x:Name="ReaderTitle"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    m3:MaterialText.Style="{m3:Typography TitleSmall}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    IsVisible="{Binding CurrentNovel.Value.Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue={x:Null}}"
                    Text="{Binding CurrentNovel.Value.Title, FallbackValue={x:Null}}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding CurrentNovel.Value.Title, FallbackValue={x:Null}}" />

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="20">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        IsVisible="{Binding IsMultiPage}">
                        <Run Text="{Binding CurrentPageIndex, Mode=OneWay, Converter={x:Static converters:PixevalConverters.PlusOne}}" />
                        <Run Text="/" />
                        <Run Text="{Binding PageCount}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:IconContentPage>
