<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:appCommon="using:Pixeval.Common"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Common.Converters"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:misaki="using:Misaki"
    xmlns:pixeval="using:Pixeval"
    xmlns:utilities="using:Pixeval.Common"
    xmlns:viewers="using:Pixeval.Views.Viewers"
    xmlns:loc="using:Pixeval.Localization">

    <Design.PreviewWith>
        <viewers:WorkInfoPane />
    </Design.PreviewWith>

    <DataTemplate x:DataType="{x:Type viewers:WorkInfoUser}" x:Key="UserCardDataTemplate">
        <Button
            Padding="8"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding $parent[viewers:WorkInfoPane].OpenAuthorCommand}"
            CommandParameter="{Binding RawUser}"
            Theme="{StaticResource TransparentButtonStyle}">
            <Grid ColumnDefinitions="50,*" ColumnSpacing="12">
                <controls:AvatarImage
                    Width="50"
                    VerticalAlignment="Top"
                    controls:Source.Cache="{Binding AvatarUrl}" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock
                        Text="{Binding Name}"
                        TextWrapping="Wrap"
                        Theme="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Id}" />
                        <Button
                            MinWidth="40"
                            MinHeight="40"
                            Padding="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{CompiledBinding [WorkInfoPage-CopyId], Source={x:Static loc:LocalizationManager.Instance}}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                            Tag="{Binding Id}"
                            Theme="{StaticResource TransparentButtonStyle}"
                            ToolTip.Tip="{CompiledBinding [WorkInfoPage-CopyId], Source={x:Static loc:LocalizationManager.Instance}}">
                            <markup:SymbolIcon FontSize="12" Symbol="Copy" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Command="{Binding $parent[viewers:WorkInfoPane].BlockUserCommand}"
                        CommandParameter="{Binding RawUser}"
                        Header="{CompiledBinding [BlockedContent-BlockUser], Source={x:Static loc:LocalizationManager.Instance}}"
                        Icon="{markup:SymbolIcon PersonProhibited}" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </DataTemplate>

    <DataTemplate x:DataType="{x:Type viewers:WorkInfoUser}" x:Key="LiteUserCardDataTemplate">
        <Button
            Padding="8"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding $parent[viewers:WorkInfoPane].OpenAuthorCommand}"
            CommandParameter="{Binding RawUser}"
            Theme="{StaticResource TransparentButtonStyle}">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                <controls:AvatarImage
                    Width="28"
                    VerticalAlignment="Top"
                    controls:Source.Cache="{Binding AvatarUrl}" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock
                        Text="{Binding Name}"
                        TextWrapping="Wrap"
                        Theme="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </Grid>
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Command="{Binding $parent[viewers:WorkInfoPane].BlockUserCommand}"
                        CommandParameter="{Binding RawUser}"
                        Header="{CompiledBinding [BlockedContent-BlockUser], Source={x:Static loc:LocalizationManager.Instance}}"
                        Icon="{markup:SymbolIcon PersonProhibited}" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="StackLayout">
        <StackPanel Spacing="5" />
    </ItemsPanelTemplate>

    <ControlTheme x:Key="{x:Type viewers:WorkInfoPane}" TargetType="{x:Type viewers:WorkInfoPane}">
        <Setter Property="Template">
            <ControlTemplate>
                <ScrollViewer
                    Name="WIPHostScroller"
                    AutomationProperties.Name="{Binding WorkTitle, RelativeSource={RelativeSource TemplatedParent}}"
                    Focusable="True"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:DataType="{x:Type viewers:WorkInfoPane}"
                        Margin="16,12"
                        DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <SelectableTextBlock
                                HorizontalAlignment="Left"
                                controls:TranslatableTextBlockBehavior.IsEnabled="True"
                                controls:TranslatableTextBlockBehavior.TextType="WorkTitle"
                                IsVisible="{Binding WorkTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Text="{Binding WorkTitle}"
                                TextWrapping="Wrap"
                                Theme="{StaticResource TitleTextBlockStyle}" />
                            <ContentPresenter
                                Grid.Column="1"
                                Content="{TemplateBinding ActionZone}"
                                ContentTemplate="{TemplateBinding ActionZoneTemplate}" />
                        </Grid>

                        <ScrollViewer
                            MaxHeight="{Binding #WIPHostScroller.Bounds, Converter={x:Static viewers:WorkInfoPane.HalfVerticalSpaceConverter}}"
                            Margin="0,5,0,0"
                            AutomationProperties.Name="{Binding WorkTitle}"
                            Focusable="True"
                            HorizontalScrollBarVisibility="Disabled"
                            IsVisible="{Binding WorkDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <SelectableTextBlock
                                controls:TranslatableTextBlockBehavior.IsEnabled="True"
                                controls:TranslatableTextBlockBehavior.TextType="WorkCaption"
                                Text="{Binding WorkDescription, Converter={x:Static converters:PixevalConverters.HtmlToPlainText}}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>

                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="ID " />
                                <Run Text="{Binding WorkId}" />
                            </TextBlock>
                            <Button
                                MinWidth="40"
                                MinHeight="40"
                                Padding="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{CompiledBinding [WorkInfoPage-CopyId], Source={x:Static loc:LocalizationManager.Instance}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                                Content="{markup:SymbolIcon Copy,
                                                            FontSize=12}"
                                Tag="{Binding WorkId}"
                                Theme="{StaticResource TransparentButtonStyle}"
                                ToolTip.Tip="{CompiledBinding [WorkInfoPage-CopyId], Source={x:Static loc:LocalizationManager.Instance}}" />
                        </StackPanel>

                        <WrapPanel ItemSpacing="20" LineSpacing="8">
                            <controls:IconText Symbol="Eye" Text="{Binding TotalView, Converter={x:Static converters:PixevalConverters.IntToString}}" />
                            <controls:IconText Symbol="Heart" Text="{Binding TotalFavorite, Converter={x:Static converters:PixevalConverters.IntToString}}" />
                            <controls:IconText Symbol="Clock" Text="{Binding CreateDate, Converter={x:Static converters:PixevalConverters.DateTimeShortDate}}" />
                        </WrapPanel>

                        <ItemsControl
                            IsVisible="{Binding !!Authors.Count}"
                            ItemTemplate="{StaticResource UserCardDataTemplate}"
                            ItemsPanel="{StaticResource StackLayout}"
                            ItemsSource="{Binding Authors}" />
                        <ItemsControl
                            IsVisible="{Binding !!Uploaders.Count}"
                            ItemTemplate="{StaticResource UserCardDataTemplate}"
                            ItemsPanel="{StaticResource StackLayout}"
                            ItemsSource="{Binding Uploaders}" />

                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <controls:PixevalBadge IsVisible="{Binding IsAiGenerated}" Mode="Ai" />
                            <controls:PixevalBadge Mode="{Binding SafeRating, Converter={x:Static converters:PixevalConverters.SafeBadgeModeConverter}}" />
                        </StackPanel>

                        <ItemsControl ItemsPanel="{StaticResource StackLayout}" ItemsSource="{Binding TagGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewers:WorkInfoTagGroup">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="10"
                                            HorizontalAlignment="Left"
                                            controls:TranslatableTextBlockBehavior.IsEnabled="True"
                                            controls:TranslatableTextBlockBehavior.PretranslatedText="{Binding Key}"
                                            controls:TranslatableTextBlockBehavior.TextType="WorkTag"
                                            IsVisible="{Binding Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Text="{Binding Key}"
                                            Theme="{StaticResource BodyStrongTextBlockStyle}" />
                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="{x:Type viewers:WorkInfoTag}">
                                                    <m3:SuggestionChip
                                                        MaxWidth="{Binding $parent[ItemsControl].Bounds.Width}"
                                                        Command="{Binding $parent[viewers:WorkInfoPane].OpenTagCommand}"
                                                        CommandParameter="{Binding}">
                                                        <TextBlock
                                                            controls:TranslatableTextBlockBehavior.IsEnabled="True"
                                                            controls:TranslatableTextBlockBehavior.PretranslatedText="{Binding TranslatedName}"
                                                            controls:TranslatableTextBlockBehavior.TextType="WorkTag"
                                                            Text="{Binding Name}"
                                                            TextWrapping="Wrap" />
                                                        <m3:SuggestionChip.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem
                                                                    Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                                                                    Header="{CompiledBinding [WorkInfoPage-CopyOriginalTagMenuItem-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                                                                    Icon="{markup:SymbolIcon Copy}"
                                                                    Tag="{Binding Name}" />
                                                                <MenuItem
                                                                    Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                                                                    Header="{CompiledBinding [WorkInfoPage-CopyTranslatedTagMenuItem-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                                                                    Icon="{markup:SymbolIcon CopyAdd}"
                                                                    IsVisible="{Binding TranslatedName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                    Tag="{Binding TranslatedName}" />
                                                                <MenuItem
                                                                    Command="{Binding $parent[viewers:WorkInfoPane].BlockTagCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Header="{CompiledBinding [BlockedContent-BlockTag], Source={x:Static loc:LocalizationManager.Instance}}"
                                                                    Icon="{markup:SymbolIcon TagDismiss}" />
                                                            </ContextMenu>
                                                        </m3:SuggestionChip.ContextMenu>
                                                    </m3:SuggestionChip>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="LiteWorkInfoPaneStyle" TargetType="{x:Type viewers:WorkInfoPane}">
        <Setter Property="Template">
            <ControlTemplate>
                <ScrollViewer
                    AutomationProperties.Name="{Binding WorkTitle, RelativeSource={RelativeSource TemplatedParent}}"
                    Focusable="True"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:DataType="{x:Type viewers:WorkInfoPane}"
                        Margin="16,12"
                        DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                        Spacing="5">
                        <Grid ColumnDefinitions="* Auto">
                            <TextBlock
                                HorizontalAlignment="Left"
                                IsVisible="{Binding WorkTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                MaxLines="2"
                                Text="{Binding WorkTitle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Theme="{StaticResource TitleTextBlockStyle}"
                                ToolTip.Tip="{Binding WorkTitle}" />
                            <ContentPresenter
                                Grid.Column="1"
                                Content="{TemplateBinding ActionZone}"
                                ContentTemplate="{TemplateBinding ActionZoneTemplate}" />
                        </Grid>

                        <ScrollViewer
                            MaxHeight="100"
                            Margin="0,5,0,0"
                            AutomationProperties.Name="{Binding WorkTitle}"
                            Focusable="True"
                            HorizontalScrollBarVisibility="Disabled"
                            IsVisible="{Binding WorkDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding WorkDescription, Converter={x:Static converters:PixevalConverters.HtmlToPlainText}}" TextWrapping="Wrap" />
                        </ScrollViewer>

                        <WrapPanel ItemSpacing="20" LineSpacing="8">
                            <controls:IconText Symbol="Eye" Text="{Binding TotalView, Converter={x:Static converters:PixevalConverters.IntToString}}" />
                            <controls:IconText Symbol="Heart" Text="{Binding TotalFavorite, Converter={x:Static converters:PixevalConverters.IntToString}}" />
                            <controls:IconText Symbol="Clock" Text="{Binding CreateDate, Converter={x:Static converters:PixevalConverters.DateTimeShortDate}}" />
                        </WrapPanel>

                        <ItemsControl
                            IsVisible="{Binding !!Authors.Count}"
                            ItemTemplate="{StaticResource LiteUserCardDataTemplate}"
                            ItemsPanel="{StaticResource StackLayout}"
                            ItemsSource="{Binding Authors}" />
                        <ItemsControl
                            IsVisible="{Binding !!Uploaders.Count}"
                            ItemTemplate="{StaticResource LiteUserCardDataTemplate}"
                            ItemsPanel="{StaticResource StackLayout}"
                            ItemsSource="{Binding Uploaders}" />

                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <controls:PixevalBadge IsVisible="{Binding IsAiGenerated}" Mode="Ai" />
                            <controls:PixevalBadge Mode="{Binding SafeRating, Converter={x:Static converters:PixevalConverters.SafeBadgeModeConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
