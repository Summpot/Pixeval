<UserControl
    x:Class="Pixeval.Views.Viewers.IllustrationViewerInfoPane"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:common="using:FluentIcons.Common"
    xmlns:capability="using:Pixeval.Views.Works"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pixeval.Views.Viewers"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:utilities="using:Pixeval.Common"
    xmlns:viewModels="using:Pixeval.ViewModels.Works"
    xmlns:viewers="using:Pixeval.ViewModels.Viewers"
    xmlns:mako="using:Pixeval.Mako"
    xmlns:pixiv="using:Pixeval.Pixiv"
    xmlns:booru="using:Pixeval.Booru"
    x:DataType="{x:Type viewers:IllustrationViewerPageViewModel}"
    Name="InfoPaneRoot"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <UserControl.Styles>
        <Style Selector="local|IllustrationViewerInfoPane#InfoPaneRoot">
            <Style Selector="^ local|WorkInfoPane#InfoPaneSection">
                <Setter Property="Theme" Value="{StaticResource LiteWorkInfoPaneStyle}" />
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ TabbedPage#TabbedPageSection">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="^:docked">
                <Style Selector="^ local|WorkInfoPane#InfoPaneSection">
                    <!-- <Setter Property="Theme" Value="{StaticResource {x:Type local:WorkInfoPane}}" /> -->
                    <Setter Property="Theme" Value="{StaticResource LiteWorkInfoPaneStyle}" />
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^ TabbedPage#TabbedPageSection">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </Style>
        </Style>

    </UserControl.Styles>

    <Grid>
        <DockPanel>
            <StackPanel ClipToBounds="True" DockPanel.Dock="Bottom">
                <ListBox
                    x:Name="ThumbnailListBox"
                    Height="85"
                    Margin="5,0"
                    Padding="0,0,0,5"
                    HorizontalAlignment="Stretch"
                    controls:IncrementalLoadingBehavior.IsEnabled="True"
                    controls:IncrementalLoadingBehavior.Threshold="100"
                    ItemsSource="{Binding Illustrations}"
                    ScrollViewer.HorizontalScrollBarVisibility="Visible"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectedIndex="{Binding CurrentWorkIndex}"
                    SelectionMode="Single">
                    <ListBox.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="#InfoPaneRoot.IsDocked" />
                            <Binding Converter="{x:Static ObjectConverters.IsNotNull}" Path="Illustrations" />
                        </MultiBinding>
                    </ListBox.IsVisible>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingStackPanel Orientation="Horizontal" Spacing="5" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.DataTemplates>
                        <DataTemplate x:DataType="{x:Type mako:Illustration}">
                            <Border
                                Width="80"
                                Height="80"
                                ClipToBounds="True"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Image controls:Source.Cache="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:DataType="{x:Type booru:BooruPost}">
                            <Border
                                Width="80"
                                Height="80"
                                ClipToBounds="True"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Image controls:Source.Cache="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                            </Border>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
                <CommandBar
                    x:Name="BottomActionBar"
                    Margin="32,0"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    DefaultLabelPosition="Collapsed"
                    IsDynamicOverflowEnabled="False">
                    <CommandBarButton
                        Command="{Binding BookmarkCommand, Source={markup1:Service Type={x:Type viewModels:WorkCommands}}, DataType={x:Type viewModels:WorkCommands}}"
                        CommandParameter="{Binding CurrentIllustration}"
                        ContextRequested="AddToBookmarkButton_OnRightClick"
                        Icon="{markup1:SymbolIconEx Heart,
                                                    IconVariant={Binding CurrentUiState.BookmarkState,
                                                                         Converter={x:Static converters:PixevalConverters.StateToIconVariant}}}"
                        IsVisible="{Binding IsBookmarkSupported, FallbackValue={x:False}}"
                        Label="{CompiledBinding [EntryItem-AddToBookmark], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <CommandBarButton
                        Command="{Binding SaveCommand, Source={markup1:Service Type={x:Type viewModels:WorkCommands}}, DataType={x:Type viewModels:WorkCommands}}"
                        CommandParameter="{Binding CurrentIllustration}"
                        Icon="{markup:SymbolIcon SaveMultiple}"
                        Label="{CompiledBinding [EntryItem-Save], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <CommandBarSeparator />
                    <CommandBarButton
                        Command="{Binding AddToWatchLaterCommand, Source={markup1:Service Type={x:Type viewModels:WorkCommands}}, DataType={x:Type viewModels:WorkCommands}}"
                        CommandParameter="{Binding CurrentIllustration}"
                        Icon="{markup1:SymbolIconEx Clock,
                                                    IconVariant={Binding CurrentUiState.IsInWatchLater,
                                                                         Converter={x:Static converters:PixevalConverters.BoolToIconVariant}}}"
                        Label="{CompiledBinding [EntryItem-AddToWatchLater], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <!--<CommandBarButton
                            Click="{x:Static utilities:AvaloniaHelper.CopyTagToClipboard}"
                            Icon="{markup:SymbolIcon Link}"
                            Label="{CompiledBinding [EntryItem-GenerateLink], Source={x:Static loc:LocalizationManager.Instance}}"
                            Tag="{Binding CurrentIllustration.AppUri, FallbackValue={x:Null}}" />-->
                    <CommandBarButton
                        Click="{x:Static utilities:AvaloniaHelper.CopyTagToClipboard}"
                        Icon="{markup:SymbolIcon LinkMultiple}"
                        Label="{CompiledBinding [EntryItem-GenerateWebLink], Source={x:Static loc:LocalizationManager.Instance}}"
                        Tag="{Binding WebsiteUri, FallbackValue={x:Null}}" />
                    <CommandBarButton
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Icon="{markup:SymbolIcon GlobeArrowUp}"
                        Label="{CompiledBinding [EntryItem-OpenInWebBrowser], Source={x:Static loc:LocalizationManager.Instance}}"
                        Tag="{Binding WebsiteUri, FallbackValue={x:Null}}" />
                </CommandBar>
            </StackPanel>

            <DockPanel VerticalAlignment="Stretch" ClipToBounds="True">
                <local:WorkSeriesInfoPane DataContext="{Binding SeriesInfo}" DockPanel.Dock="Bottom" />
                <Panel>
                    <local:WorkInfoPane Name="InfoPaneSection" ArtworkInfo="{Binding CurrentIllustration, FallbackValue={x:Null}}">
                        <local:WorkInfoPane.ActionZone>
                            <Border
                                Width="32"
                                Height="32"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False" />
                        </local:WorkInfoPane.ActionZone>
                    </local:WorkInfoPane>

                    <TabbedPage
                        Name="TabbedPageSection"
                        Background="Transparent"
                        IsVisible="{Binding #InfoPaneRoot.IsDocked}"
                        TabPlacement="Top">
                        <TabbedPage.Resources>
                            <Thickness x:Key="TabbedPageTabStripPadding">0,0,60,0</Thickness>
                        </TabbedPage.Resources>
                        <local:WorkInfoPage
                            controls:TabPageInclusion.IsIncluded="{Binding CurrentIllustration, Converter={x:Static converters:PixevalConverters.IsIllustration}}"
                            Work="{Binding CurrentIllustration}">
                            <local:WorkInfoPage.ActionZone>
                                <Border
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False" />
                            </local:WorkInfoPage.ActionZone>
                        </local:WorkInfoPage>
                        <local:CommentsPage
                            controls:TabPageInclusion.IsIncluded="{Binding CurrentIllustration, Converter={x:Static converters:PixevalConverters.IsInteractiveIllustration}}"
                            ParentId="{Binding CurrentIllustration, Converter={x:Static converters:PixevalConverters.IllustrationId}}"
                            ParentType="{x:Static pixiv:SimpleWorkType.Illustration}" />
                        <capability:WorkRelatedPage
                            controls:TabPageInclusion.IsIncluded="{Binding CurrentIllustration, Converter={x:Static converters:PixevalConverters.IsInteractiveIllustration}}"
                            IsCommandBarCollapsed="True"
                            WorkId="{Binding CurrentIllustration, Converter={x:Static converters:PixevalConverters.IllustrationId}}"
                            WorkType="{x:Static pixiv:SimpleWorkType.Illustration}" />
                    </TabbedPage>
                </Panel>
            </DockPanel>
        </DockPanel>

        <ToggleButton
            Margin="14"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Content="{markup1:SymbolIconEx Symbol={markup1:EitherBinding {Binding #InfoPaneRoot.IsLocked},
                                                                         PinOff,
                                                                         Pin,
                                                                         x:TypeArguments=common:Symbol}}"
            IsChecked="{Binding #InfoPaneRoot.IsLocked, Mode=TwoWay}"
            IsVisible="{Binding #InfoPaneRoot.IsDocked, Converter={x:Static BoolConverters.Not}}"
            Theme="{StaticResource TransparentButtonStyle}"
            ToolTip.Tip="{CompiledBinding [EntryViewerPage-Pin], Source={x:Static loc:LocalizationManager.Instance}}" />
        <Button
            Width="32"
            Height="32"
            Margin="14"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="ChevronButtonClicked"
            Content="{markup1:SymbolIconEx Symbol={markup1:EitherBinding {Binding #InfoPaneRoot.IsDocked},
                                                                         ChevronUp,
                                                                         ChevronDown,
                                                                         x:TypeArguments=common:Symbol}}"
            Theme="{StaticResource TransparentButtonStyle}"
            ToolTip.Tip="{CompiledBinding [EntryViewerPage-InfoAndComments], Source={x:Static loc:LocalizationManager.Instance}}" />
    </Grid>
</UserControl>
