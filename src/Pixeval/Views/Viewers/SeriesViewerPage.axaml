<views:IconContentPage
    x:Class="Pixeval.Views.Viewers.SeriesViewerPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:viewModels="using:Pixeval.ViewModels.Viewers"
    xmlns:views="using:Pixeval.Views"
    x:DataType="{x:Type viewModels:SeriesViewerPageViewModel}"
    x:Name="SeriesPage"
    Header="{Binding Header}"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="1200">
    <Grid>
        <DockPanel IsVisible="{Binding SeriesDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Expander
                x:Name="SeriesInfoExpander"
                Padding="0"
                HorizontalAlignment="Stretch"
                DockPanel.Dock="Top"
                ExpandDirection="Up"
                IsExpanded="True">
                <Expander.Header>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <CommandBar
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True"
                            ItemWidthRight="280">
                            <CommandBarButton
                                Command="{Binding AddToWatchlistCommand}"
                                DataContext="{Binding #SeriesPage.DataContext}"
                                Icon="{markup:SymbolIcon Alert}"
                                IsVisible="{Binding !IsWatchlistAdded}"
                                Label="{I18N {x:Static pixeval:SeriesViewerPageResources.AddToWatchlist}}" />
                            <CommandBarButton
                                Command="{Binding RemoveFromWatchlistCommand}"
                                DataContext="{Binding #SeriesPage.DataContext}"
                                Icon="{markup:SymbolIcon AlertOff}"
                                IsVisible="{Binding IsWatchlistAdded}"
                                Label="{I18N {x:Static pixeval:SeriesViewerPageResources.RemoveFromWatchlist}}" />
                        </CommandBar>
                        <StackPanel
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <StackPanel
                                MaxWidth="320"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !#SeriesInfoExpander.IsExpanded}"
                                Spacing="4">
                                <TextBlock
                                    MaxLines="1"
                                    Text="{Binding SeriesDetail?.Title}"
                                    TextTrimming="CharacterEllipsis"
                                    Theme="{StaticResource CaptionStrongTextBlockStyle}"
                                    ToolTip.Tip="{Binding SeriesDetail?.Title}" />
                                <TextBlock
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding AuthorName}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <controls:IconText
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="SquareMultiple"
                                Text="{Binding ContentCountText}" />
                        </StackPanel>
                        <ProgressBar
                            Grid.Row="2"
                            Height="4"
                            AutomationProperties.Name="{I18N {x:Static pixeval:EntryViewerPageResources+LoadingTextBlock.Text}}"
                            IsIndeterminate="True"
                            IsVisible="{Binding IsChangingWatchlist}" />
                    </Grid>
                </Expander.Header>
                <Border
                    Margin="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="16">
                    <ScrollViewer
                        MaxHeight="280"
                        AutomationProperties.Name="{Binding Header}"
                        Focusable="True"
                        HorizontalScrollBarVisibility="Disabled">
                        <Grid
                            x:Name="ProfileGrid"
                            Margin="16"
                            ColumnDefinitions="72,*"
                            ColumnSpacing="16"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="8"
                            SizeChanged="ProfileGrid_OnSizeChanged">
                            <Image
                                Width="72"
                                Height="96"
                                VerticalAlignment="Top"
                                controls:Source.Cache="{Binding CoverUrl}"
                                Stretch="Uniform" />
                            <StackPanel
                                x:Name="ProfileText"
                                Grid.Column="1"
                                MaxWidth="650"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <TextBlock
                                    Text="{Binding SeriesDetail?.Title}"
                                    TextWrapping="Wrap"
                                    Theme="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding AuthorName}"
                                    TextWrapping="Wrap" />
                                <SelectableTextBlock Text="{Binding Caption, Converter={x:Static converters:PixevalConverters.HtmlToPlainText}}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Expander>
            <ContentControl x:Name="SeriesContainerHost" />
        </DockPanel>
        <controls:ViewerStateOverlay ErrorMessage="{Binding LoadErrorMessage}" IsLoading="{Binding IsLoading}" />
    </Grid>
</views:IconContentPage>
