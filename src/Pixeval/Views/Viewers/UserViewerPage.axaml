<ContentPage
    x:Class="Pixeval.Views.Viewers.UserViewerPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:settings="using:Pixeval.Config"
    xmlns:appCommon="using:Pixeval.Common"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:utilities="using:Pixeval.Common"
    xmlns:viewers="using:Pixeval.ViewModels.Viewers"
    xmlns:views="using:Pixeval.Config"
    x:DataType="{x:Type viewers:UserViewerPageViewModel}"
    Design.DataContext="{x:Static utilities:DesignHelper.DesignUserViewerPageViewModel}"
    Header="{Binding Header}"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:capability="using:Pixeval.Views.Works"
    xmlns:di="using:Pixeval.Common.Markup">
    <ContentPage.Icon>
        <Image
            Width="16"
            Height="16"
            Source="avares://Pixeval/Assets/Platforms/pixiv.png" />
    </ContentPage.Icon>
    <Grid>
        <DockPanel IsVisible="{Binding UserDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Expander
                x:Name="UserInfoExpander"
                Padding="0"
                HorizontalAlignment="Stretch"
                controls:Source.BackgroundCache="{Binding BackgroundUrl}"
                DockPanel.Dock="Top"
                ExpandDirection="Up"
                IsExpanded="{Binding OpenUserInfo, Source={di:Service Type={x:Type settings:PixevalSettings}}, DataType={x:Type settings:PixevalSettings}, Mode=TwoWay}"
                Theme="{StaticResource UserInfoExpanderTheme}">
                <Expander.Header>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <CommandBar
                            x:Name="ProfileCommands"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True"
                            ItemWidthRight="240">
                            <CommandBarButton
                                Command="{Binding FollowCommand}"
                                Icon="{markup:SymbolIcon PersonAdd}"
                                IsVisible="{Binding !IsFollowed}"
                                Label="{CompiledBinding [UserViewerPage-Follow], Source={x:Static loc:LocalizationManager.Instance}}" />
                            <CommandBarButton
                                Command="{Binding FollowPrivatelyCommand}"
                                Icon="{markup:SymbolIcon PersonLock}"
                                IsVisible="{Binding !IsFollowed}"
                                Label="{CompiledBinding [UserViewerPage-PrivateFollow], Source={x:Static loc:LocalizationManager.Instance}}" />
                            <CommandBarButton
                                Command="{Binding UnfollowCommand}"
                                Icon="{markup:SymbolIcon PersonDelete}"
                                IsVisible="{Binding IsFollowed}"
                                Label="{CompiledBinding [UserViewerPage-Unfollow], Source={x:Static loc:LocalizationManager.Instance}}" />
                            <CommandBarSeparator />
                            <CommandBarButton
                                Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                                Icon="{markup:SymbolIcon Link}"
                                Label="{CompiledBinding [EntryItem-GenerateLink], Source={x:Static loc:LocalizationManager.Instance}}"
                                Tag="{Binding UserDetail.Value.UserEntity.AppUri, FallbackValue={x:Null}}" />
                            <CommandBarButton
                                Click="{x:Static appCommon:AvaloniaHelper.CopyTagToClipboard}"
                                Icon="{markup:SymbolIcon LinkMultiple}"
                                Label="{CompiledBinding [EntryItem-GenerateWebLink], Source={x:Static loc:LocalizationManager.Instance}}"
                                Tag="{Binding UserDetail.Value.UserEntity.WebsiteUri, FallbackValue={x:Null}}" />
                            <CommandBarButton
                                Click="{x:Static appCommon:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                                Icon="{markup:SymbolIcon GlobeArrowUp}"
                                Label="{CompiledBinding [EntryItem-OpenInWebBrowser], Source={x:Static loc:LocalizationManager.Instance}}"
                                Tag="{Binding UserDetail.Value.UserEntity.WebsiteUri, FallbackValue={x:Null}}" />
                            <CommandBar.SecondaryCommands>
                                <CommandBarButton
                                    Command="{Binding BlockUserCommand}"
                                    Icon="{markup:SymbolIcon PersonProhibited}"
                                    Label="{CompiledBinding [BlockedContent-BlockUser], Source={x:Static loc:LocalizationManager.Instance}}" />
                            </CommandBar.SecondaryCommands>
                        </CommandBar>

                        <WrapPanel
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            ItemSpacing="16"
                            LineSpacing="8">
                            <!--  头像  -->
                            <controls:AvatarImage
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                controls:Source.Cache="{Binding AvatarUrl}"
                                IsVisible="{Binding !#UserInfoExpander.IsExpanded}" />

                            <!--  用户名、ID、简介  -->
                            <StackPanel
                                MaxWidth="150"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !#UserInfoExpander.IsExpanded}"
                                Spacing="6">
                                <TextBlock
                                    MaxLines="1"
                                    Text="{Binding UserDetail.Value.UserEntity.Name, FallbackValue={x:Null}}"
                                    TextTrimming="CharacterEllipsis"
                                    Theme="{StaticResource CaptionStrongTextBlockStyle}"
                                    ToolTip.Tip="{Binding UserDetail.Value.UserEntity.Name, FallbackValue={x:Null}}" />
                                <SelectableTextBlock
                                    x:Name="CollapsedProfileIdText"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Id}" />
                            </StackPanel>
                            <controls:IconText
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="PersonHeart"
                                Text="{Binding UserDetail.Value.UserProfile.TotalFollowUsers, FallbackValue={x:Null}}" />
                            <controls:IconText
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="People"
                                Text="{Binding UserDetail.Value.UserProfile.TotalMyPixivUsers, FallbackValue={x:Null}}" />
                            <controls:IconText
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="Image"
                                Text="{Binding UserDetail.Value.UserProfile.TotalIllustrations, FallbackValue={x:Null}}" />
                            <controls:IconText
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="ImageMultiple"
                                Text="{Binding UserDetail.Value.UserProfile.TotalManga, FallbackValue={x:Null}}" />
                            <controls:IconText
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="BookOpen"
                                Text="{Binding UserDetail.Value.UserProfile.TotalNovelSeries, FallbackValue={x:Null}}" />
                        </WrapPanel>
                        <ProgressBar
                            Grid.Row="2"
                            Height="4"
                            AutomationProperties.Name="{CompiledBinding [EntryViewerPage-LoadingTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                            IsIndeterminate="True"
                            IsVisible="{Binding IsChangingFollow}" />
                    </Grid>
                </Expander.Header>
                <Border MinHeight="210" Background="{DynamicResource PixevalTranslucentBackground}">
                    <ScrollViewer
                        x:Name="ProfileDetailsScroller"
                        MaxHeight="280"
                        AutomationProperties.Name="{Binding Header}"
                        Focusable="True"
                        HorizontalScrollBarVisibility="Disabled">
                        <!--  用户信息  -->
                        <Grid
                            Margin="16"
                            VerticalAlignment="Stretch"
                            ColumnDefinitions="64,*"
                            ColumnSpacing="16">
                            <!--  头像  -->
                            <controls:AvatarImage
                                Width="64"
                                Height="64"
                                VerticalAlignment="Top"
                                controls:Source.Cache="{Binding AvatarUrl}" />

                            <!--  用户名、ID、简介  -->
                            <Border
                                Grid.Column="1"
                                MaxWidth="650"
                                Padding="12"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="16">
                                <StackPanel Spacing="6">
                                    <DockPanel HorizontalSpacing="8">
                                        <controls:PixevalBadge
                                            DockPanel.Dock="Right"
                                            IsVisible="{Binding UserDetail.Value.UserProfile.IsPremium, FallbackValue={x:Null}}"
                                            Mode="Premium" />
                                        <TextBlock
                                            x:Name="ProfileName"
                                            Text="{Binding UserDetail.Value.UserEntity.Name, FallbackValue={x:Null}}"
                                            TextWrapping="Wrap"
                                            Theme="{StaticResource TitleTextBlockStyle}" />
                                    </DockPanel>
                                    <SelectableTextBlock
                                        x:Name="ProfileIdText"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Id}" />
                                    <SelectableTextBlock
                                        controls:TranslatableTextBlockBehavior.IsEnabled="True"
                                        controls:TranslatableTextBlockBehavior.TextType="UserComment"
                                        Text="{Binding UserDetail.Value.UserEntity.Description, FallbackValue={x:Null}}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Expander>
            <TabbedPage Pages="{Binding TabPages}" />
        </DockPanel>
        <controls:ViewerStateOverlay ErrorMessage="{Binding LoadErrorMessage}" IsLoading="{Binding IsLoading}" />
    </Grid>
</ContentPage>
