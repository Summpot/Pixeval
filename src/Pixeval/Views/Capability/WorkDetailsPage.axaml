<UserControl
    x:Class="Pixeval.Views.Capability.WorkDetailsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Pixeval.ViewModels.WorkDetails"
    d:DesignHeight="720"
    d:DesignWidth="1080"
    x:DataType="vm:WorkDetailsViewModel"
    mc:Ignorable="d">
    <Grid>
        <ProgressBar
            Margin="0,0,0,8"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            IsVisible="{Binding IsLoading}" />

        <ScrollViewer Margin="0,12,0,0">
            <StackPanel Margin="0,0,0,20" Spacing="14">
                <Border
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="24">
                    <Grid ColumnDefinitions="1.35*,420" MinHeight="430">
                        <Grid>
                            <Border
                                x:Name="HeroImageViewport"
                                ClipToBounds="True"
                                CornerRadius="24,0,0,24"
                                DoubleTapped="HeroImageViewport_OnDoubleTapped"
                                PointerWheelChanged="HeroImageViewport_OnPointerWheelChanged">
                                <Image
                                    x:Name="HeroImage"
                                    RenderTransformOrigin="0.5,0.5"
                                    Source="{Binding MainImage}"
                                    Stretch="UniformToFill">
                                    <Image.RenderTransform>
                                        <ScaleTransform
                                            ScaleX="1"
                                            ScaleY="1" />
                                    </Image.RenderTransform>
                                </Image>
                            </Border>

                            <Border
                                Background="#40000000"
                                CornerRadius="24,0,0,24" />

                            <Border
                                Margin="20"
                                Padding="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#AA101318"
                                CornerRadius="999">
                                <controls:ToolBar>
                                    <Button
                                        x:Name="HeroZoomOutButton"
                                        Click="HeroZoomOutButton_OnClick"
                                        ToolTip.Tip="缩小">
                                        <fluent:SymbolIcon Symbol="ZoomOut" />
                                    </Button>
                                    <Border
                                        Padding="10,0"
                                        Background="#33FFFFFF"
                                        CornerRadius="999">
                                        <TextBlock
                                            x:Name="HeroZoomText"
                                            VerticalAlignment="Center"
                                            Foreground="#FFFFFFFF"
                                            Text="100%" />
                                    </Border>
                                    <Button
                                        x:Name="HeroZoomResetButton"
                                        Click="HeroZoomResetButton_OnClick"
                                        ToolTip.Tip="重置缩放">
                                        <fluent:SymbolIcon Symbol="ArrowReset" />
                                    </Button>
                                    <Button
                                        x:Name="HeroZoomInButton"
                                        Click="HeroZoomInButton_OnClick"
                                        ToolTip.Tip="放大">
                                        <fluent:SymbolIcon Symbol="ZoomIn" />
                                    </Button>
                                </controls:ToolBar>
                            </Border>

                            <StackPanel Margin="20" VerticalAlignment="Bottom" Spacing="12">
                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                    <Border
                                        Padding="12,5"
                                        Background="#AA101318"
                                        CornerRadius="999">
                                        <TextBlock Foreground="White" Text="{Binding KindText}" />
                                    </Border>
                                    <Border
                                        Padding="12,5"
                                        Background="#AA101318"
                                        CornerRadius="999">
                                        <TextBlock Foreground="White" Text="{Binding WorkId, StringFormat='ID {0}'}" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <Border
                            Grid.Column="1"
                            Padding="24"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="0,24,24,0">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Text="{Binding Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="16"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Author}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding CreateDateText}" />

                                <WrapPanel ItemSpacing="8" LineSpacing="8">
                                    <Button
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Click="DownloadButton_OnClick"
                                        IsEnabled="{Binding CanDownload}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <fluent:SymbolIcon Foreground="#FFFFFFFF" Symbol="Save" />
                                            <TextBlock Foreground="#FFFFFFFF" Text="{Binding DownloadButtonText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="DownloadAsButton_OnClick" IsEnabled="{Binding CanDownload}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <fluent:SymbolIcon Symbol="FolderOpen" />
                                            <TextBlock Text="另存到…" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OpenInBrowserButton_OnClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <fluent:SymbolIcon Symbol="GlobeArrowUp" />
                                            <TextBlock Text="在浏览器中打开" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="CopyAppLinkButton_OnClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <fluent:SymbolIcon Symbol="Link" />
                                            <TextBlock Text="复制 App 链接" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="提示：在大图区域滚轮缩放，双击可快速重置。" />

                                <ItemsControl ItemsSource="{Binding Metrics}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WorkDetailsStatItemViewModel">
                                            <Border
                                                MinWidth="98"
                                                Padding="12,10"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="14">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontSize="12" Opacity="0.7" Text="{Binding Label}" />
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Value}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border
                                    Padding="14"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="16">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="作品简介" />
                                        <TextBlock MaxLines="8" Text="{Binding Description}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding StatsText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border
                    Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="18">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="Bold" Text="标签" />
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10,4"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="999">
                                        <TextBlock Text="{Binding .}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border
                    Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="18"
                    IsVisible="{Binding HasPageImages}">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="Bold" Text="{Binding PageSectionTitle}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding PageImages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkDetailsImageItemViewModel">
                                        <StackPanel Width="200" Spacing="8">
                                            <Border
                                                Height="220"
                                                ClipToBounds="True"
                                                CornerRadius="14">
                                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border
                    Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="18"
                    IsVisible="{Binding HasRelatedWorks}">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="Bold" Text="{Binding RelatedSectionTitle}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RelatedWorks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RelatedWorkCardViewModel">
                                        <Button
                                            Width="236"
                                            Padding="0"
                                            Background="Transparent"
                                            Click="RelatedWorkButton_OnClick">
                                            <Border
                                                Padding="10"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                CornerRadius="16">
                                                <StackPanel Spacing="10">
                                                    <Border
                                                        Height="156"
                                                        ClipToBounds="True"
                                                        CornerRadius="12">
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            MaxLines="2"
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Author}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding KindText}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding StatsText}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border
                    Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="18"
                    IsVisible="{Binding IsNovel}">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="Bold" Text="小说正文" />
                        <Border
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="16">
                            <SelectableTextBlock FontFamily="Consolas" Text="{Binding NovelText}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border
                    Padding="12"
                    Background="IndianRed"
                    CornerRadius="16"
                    IsVisible="{Binding !!ErrorMessage}">
                    <TextBlock Foreground="White" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
