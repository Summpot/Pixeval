<views:IconContentPage
    x:Class="Pixeval.Views.Capability.WorkFollowingPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:di="using:Pixeval.Views.Markup"
    xmlns:settings="using:Pixeval.AppManagement.Settings"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:Pixeval.Models.Pixiv"
    xmlns:markup1="using:Pixeval.Views.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Pixeval.Views"
    xmlns:work="using:Pixeval.Views.Work"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <work:WorkContainer x:Name="WorkContainer" RefreshRequested="WorkContainer_OnRefreshRequested">
        <work:WorkContainer.CommandBarElements>
            <controls:SymbolComboBox
                x:Name="PrivacyPolicyComboBox"
                ItemsSource="{markup1:EnumResources x:TypeArguments=enum:PrivacyPolicy}"
                SelectionChanged="WorkTypeComboBox_OnSelectionChanged" />
            <controls:SymbolComboBox
                x:Name="SimpleWorkTypeComboBox"
                ItemsSource="{markup1:EnumResources x:TypeArguments=enum:SimpleWorkType}"
                SelectedValue="{Binding SearchSettings.DefaultSimpleWorkType, Source={di:Service Type={x:Type settings:AppSettings}}, DataType={x:Type settings:AppSettings}, Mode=OneTime}"
                SelectionChanged="WorkTypeComboBox_OnSelectionChanged" />
        </work:WorkContainer.CommandBarElements>
    </work:WorkContainer>
</views:IconContentPage>
