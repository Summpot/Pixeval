<ContentPage
    x:Class="Pixeval.Views.Settings.NavigationSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:FluentIcons.Common"
    xmlns:controls="using:CommunityToolkit.Avalonia.Controls"
    xmlns:controls1="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:edit="using:AvaloniaEdit"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigation="using:Pixeval.Models.Navigation"
    xmlns:pixeval="using:Pixeval"
    xmlns:settings="using:Pixeval.Views.Settings"
    xmlns:utilities="using:Pixeval.Utilities"
    x:DataType="{x:Type settings:NavigationSettingsPage}"
    Header="{I18N {x:Static pixeval:MainPageResources+Tab.NavigationSettings}}"
    mc:Ignorable="d"
    d:DesignHeight="720"
    d:DesignWidth="1100">
    <ContentPage.Styles>
        <Style Selector="ScrollViewer#ReferenceScroller">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
        <Style Selector="Grid#EditorLayout.narrow &gt; ScrollViewer#ReferenceScroller">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.Row" Value="2" />
            <Setter Property="Grid.RowSpan" Value="1" />
            <Setter Property="MaxHeight" Value="220" />
        </Style>
    </ContentPage.Styles>
    <NavigationPage.TopCommandBar>
        <!--  Native overflow estimates uniform slots; reserve enough for the localized reset label.  -->
        <CommandBar DefaultLabelPosition="Right" ItemWidthRight="240">
            <CommandBarButton
                x:Name="CanApplyButton"
                Click="ApplyButton_OnClicked"
                Icon="{markup:SymbolIcon Checkmark}"
                Label="{I18N {x:Static pixeval:NavigationSettingsPageResources+ApplyButton.Content}}"
                ToolTip.Tip="{I18N {x:Static pixeval:NavigationSettingsPageResources+ApplyButton.ToolTip}}" />
            <CommandBarButton
                Click="FormatButton_OnClicked"
                Icon="{markup:SymbolIcon TextNumberFormat}"
                Label="{I18N {x:Static pixeval:NavigationSettingsPageResources+FormatButton.Content}}"
                ToolTip.Tip="{I18N {x:Static pixeval:NavigationSettingsPageResources+FormatButton.ToolTip}}" />
            <CommandBarButton
                Click="ResetButton_OnClicked"
                Icon="{markup:SymbolIcon ArrowReset}"
                Label="{I18N {x:Static pixeval:NavigationSettingsPageResources+ResetButton.Content}}"
                ToolTip.Tip="{I18N {x:Static pixeval:NavigationSettingsPageResources+ResetButton.ToolTip}}" />
            <CommandBarButton
                Click="InsertFolderButton_OnClicked"
                Icon="{markup:SymbolIcon DocumentFolder}"
                Label="{I18N {x:Static pixeval:NavigationSettingsPageResources+InsertFolderButton.Content}}"
                ToolTip.Tip="{I18N {x:Static pixeval:NavigationSettingsPageResources+InsertFolderButton.ToolTip}}" />
        </CommandBar>
    </NavigationPage.TopCommandBar>
    <Grid
        x:Name="EditorLayout"
        Margin="12"
        ColumnDefinitions="*,320"
        ColumnSpacing="12"
        RowDefinitions="*,Auto,Auto"
        RowSpacing="12"
        SizeChanged="EditorLayout_OnSizeChanged">
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Padding="8"
            Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLowest}}"
            BorderBrush="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OutlineVariant}}"
            BorderThickness="1"
            CornerRadius="16">
            <edit:TextEditor
                x:Name="YamlEditor"
                Background="Transparent"
                FontSize="14"
                HorizontalScrollBarVisibility="Auto"
                ShowLineNumbers="True"
                TextChanged="YamlEditor_OnTextChanged"
                VerticalScrollBarVisibility="Auto">
                <edit:TextEditor.Options>
                    <edit:TextEditorOptions
                        AllowScrollBelowDocument="False"
                        ConvertTabsToSpaces="True"
                        IndentationSize="2" />
                </edit:TextEditor.Options>
            </edit:TextEditor>
        </Border>

        <ScrollViewer x:Name="ReferenceScroller">
            <StackPanel Spacing="12">
                <controls:SettingsExpander Header="{I18N {x:Static pixeval:NavigationSettingsPageResources+ReferencePages.Header}}" HeaderIcon="{markup:SymbolIcon DocumentBulletList}">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            Padding="8"
                            HorizontalContentAlignment="Stretch"
                            ContentAlignment="Vertical">
                            <ItemsControl ItemsSource="{x:Static utilities:NavigationPageRegistry.Pages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Type navigation:NavigationPageDefinition}">
                                        <m3:Card
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="{Binding Header}"
                                            Click="{x:Static utilities:AvaloniaHelper.CopyTagToClipboard}"
                                            Tag="{Binding Key, StringFormat='- page: {0}'}"
                                            Theme="{StaticResource ContentCardTheme}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <fluent:SymbolIcon
                                                    Grid.Column="0"
                                                    FontSize="16"
                                                    IconVariant="Color"
                                                    Symbol="{Binding Icon}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding Header}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Key}" />
                                            </Grid>
                                        </m3:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <controls:SettingsExpander Header="{I18N {x:Static pixeval:NavigationSettingsPageResources+ReferenceIcons.Header}}" HeaderIcon="{markup:SymbolIcon Icons}">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            Padding="8"
                            HorizontalContentAlignment="Stretch"
                            ContentAlignment="Vertical">
                            <ItemsControl ItemsSource="{x:Static utilities:NavigationPageRegistry.ColorSymbols}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Type common:Symbol}">
                                        <Button
                                            Width="48"
                                            Height="48"
                                            Padding="2"
                                            AutomationProperties.Name="{Binding StringFormat={}{0}}"
                                            Click="{x:Static utilities:AvaloniaHelper.CopyTagToClipboard}"
                                            Tag="{Binding StringFormat={}{0}}"
                                            Theme="{StaticResource TransparentButtonStyle}"
                                            ToolTip.Tip="{Binding}">
                                            <fluent:SymbolIcon IconVariant="Color" Symbol="{Binding}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls1:AdaptiveGrid
                                            ItemSize="48"
                                            ItemSpacing="0"
                                            LineSize="48"
                                            LineSpacing="0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer
            x:Name="DiagnosticsScroller"
            Grid.Row="1"
            Grid.Column="0"
            MaxHeight="160"
            Focusable="True"
            HorizontalScrollBarVisibility="Disabled"
            IsVisible="{Binding #StatusInfoBar.IsVisible}">
            <controls1:InfoBar
                x:Name="StatusInfoBar"
                IsVisible="False"
                Mode="Error" />
        </ScrollViewer>
    </Grid>
</ContentPage>
