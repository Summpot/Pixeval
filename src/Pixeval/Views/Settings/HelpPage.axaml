<views:IconContentPage
    x:Class="Pixeval.Views.Settings.HelpPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:controls="using:CommunityToolkit.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pixeval.Controls"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:settings="using:Pixeval.Views.Settings"
    xmlns:views="using:Pixeval.Views.Shell"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="600">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="{StaticResource SettingStackPanelSpacing}">
            <controls:SettingsExpander Header="{CompiledBinding [HelpPage-DownloadMacroHelpExpander-Header], Source={x:Static loc:LocalizationManager.Instance}}" HeaderIcon="{markup:SymbolIcon Rename}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Left">
                        <local:MarkdownBox Markdown="{CompiledBinding [DownloadMacroHelp], Source={x:Static loc:LocalizedHelp.Instance}}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <controls:SettingsExpander Header="{CompiledBinding [HelpPage-QueryFilterHelpExpander-Header], Source={x:Static loc:LocalizationManager.Instance}}" HeaderIcon="{markup:SymbolIcon Filter}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                        <controls:SettingsCard.Header>
                            <TextBlock
                                Margin="0,10"
                                Text="{CompiledBinding [HelpPage-QueryFilterSimpleHelpHeader-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                                Theme="{StaticResource SubtitleTextBlockStyle}" />
                        </controls:SettingsCard.Header>
                        <local:MarkdownBox Markdown="{CompiledBinding [QueryFilterSimpleHelp], Source={x:Static loc:LocalizedHelp.Instance}}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                        <controls:SettingsCard.Header>
                            <TextBlock
                                Margin="0,10"
                                Text="{CompiledBinding [HelpPage-QueryFilterHelpHeader-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                                Theme="{StaticResource SubtitleTextBlockStyle}" />
                        </controls:SettingsCard.Header>
                        <local:MarkdownBox Markdown="{CompiledBinding [QueryFilterHelp], Source={x:Static loc:LocalizedHelp.Instance}}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <controls:SettingsExpander Header="{CompiledBinding [HelpPage-WorkSubscriptionsHelpExpander-Header], Source={x:Static loc:LocalizationManager.Instance}}" HeaderIcon="{markup:SymbolIcon Alert}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Left">
                        <local:MarkdownBox Markdown="{CompiledBinding [WorkSubscriptionsHelp], Source={x:Static loc:LocalizedHelp.Instance}}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <controls:SettingsExpander Header="{CompiledBinding [HelpPage-ExtensionsHelpExpander-Header], Source={x:Static loc:LocalizationManager.Instance}}" HeaderIcon="{markup:SymbolIcon PuzzlePiece}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Left">
                        <local:MarkdownBox Markdown="{CompiledBinding [ExtensionsHelp], Source={x:Static loc:LocalizedHelp.Instance}}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <settings:McpHelpSection />
        </StackPanel>
    </ScrollViewer>
</views:IconContentPage>
