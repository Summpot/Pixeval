<views:IconContentPage
    x:Class="Pixeval.Views.Settings.HelpPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pixeval.Controls"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:settings="using:Pixeval.Views.Settings"
    xmlns:views="using:Pixeval.Views.Shell"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="600"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:controls="using:CommunityToolkit.Avalonia.Controls"
    xmlns:markup="using:FluentIcons.Avalonia.Markup">
    <views:IconContentPage.Styles>
        <Style Selector="Expander.documentation-section">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Expander.documentation-section /template/ ToggleButton#ExpanderHeader">
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Expander.documentation-section:expanded /template/ ToggleButton#ExpanderHeader">
            <Setter Property="CornerRadius" Value="16,16,0,0" />
        </Style>
    </views:IconContentPage.Styles>
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="{StaticResource SettingStackPanelSpacing}">
            <Expander Classes="documentation-section">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <m3:MaterialSymbol Symbol="Edit" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{CompiledBinding [HelpPage-DownloadMacroHelpExpander-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Expander.Header>
                <local:MarkdownBox Markdown="{CompiledBinding [DownloadMacroHelp], Source={x:Static loc:LocalizedHelp.Instance}}" />
            </Expander>
            <Expander Classes="documentation-section">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <m3:MaterialSymbol Symbol="FilterAlt" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{CompiledBinding [HelpPage-QueryFilterHelpExpander-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="{CompiledBinding [HelpPage-QueryFilterSimpleHelpHeader-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                        TextWrapping="Wrap"
                        Theme="{StaticResource SubtitleTextBlockStyle}" />
                    <local:MarkdownBox Markdown="{CompiledBinding [QueryFilterSimpleHelp], Source={x:Static loc:LocalizedHelp.Instance}}" />
                    <TextBlock
                        Text="{CompiledBinding [HelpPage-QueryFilterHelpHeader-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                        TextWrapping="Wrap"
                        Theme="{StaticResource SubtitleTextBlockStyle}" />
                    <local:MarkdownBox Markdown="{CompiledBinding [QueryFilterHelp], Source={x:Static loc:LocalizedHelp.Instance}}" />
                </StackPanel>
            </Expander>
            <Expander Classes="documentation-section">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <m3:MaterialSymbol Symbol="Notifications" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{CompiledBinding [HelpPage-WorkSubscriptionsHelpExpander-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Expander.Header>
                <local:MarkdownBox Markdown="{CompiledBinding [WorkSubscriptionsHelp], Source={x:Static loc:LocalizedHelp.Instance}}" />
            </Expander>
            <Expander Classes="documentation-section">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <m3:MaterialSymbol Symbol="Extension" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{CompiledBinding [HelpPage-ExtensionsHelpExpander-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Expander.Header>
                <local:MarkdownBox Markdown="{CompiledBinding [ExtensionsHelp], Source={x:Static loc:LocalizedHelp.Instance}}" />
            </Expander>
            <settings:McpHelpSection />
        </StackPanel>
    </ScrollViewer>
</views:IconContentPage>
