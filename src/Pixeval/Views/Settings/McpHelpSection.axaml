<UserControl
    x:Class="Pixeval.Views.Settings.McpHelpSection"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:controls="using:CommunityToolkit.Avalonia.Controls"
    xmlns:local="using:Pixeval.Controls"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mcpServer="using:Pixeval.ViewModels.Settings"
    xmlns:pixeval="using:Pixeval"
    xmlns:settings="using:Pixeval.Views.Settings">
    <StackPanel Spacing="10">
        <controls:SettingsExpander Header="{CompiledBinding [HelpPage-McpHelpExpander-Header], Source={x:Static loc:LocalizationManager.Instance}}" HeaderIcon="{markup:SymbolIcon Bot}">
            <controls:SettingsExpander.Items>
                <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Left">
                    <local:MarkdownBox Markdown="{CompiledBinding [McpHelp], Source={x:Static loc:LocalizedHelp.Instance}}" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>
        <controls:SettingsExpander Description="{CompiledBinding [HelpPage-McpToolsExpander-Description], Source={x:Static loc:LocalizationManager.Instance}}" Header="{CompiledBinding [HelpPage-McpToolsExpander-Header], Source={x:Static loc:LocalizationManager.Instance}}">
            <controls:SettingsExpander.HeaderIcon>
                <PathIcon Data="{markup1:SvgPath {x:Static pixeval:SvgResources.MCP}}" />
            </controls:SettingsExpander.HeaderIcon>
            <m3:IconButton
                x:Name="RefreshMcpToolsButton"
                AutomationProperties.Name="{Binding (ToolTip.Tip), RelativeSource={RelativeSource Self}}"
                Click="RefreshMcpToolsButton_OnClicked"
                Symbol="Sync"
                ToolTip.Tip="{CompiledBinding [HelpPage-McpToolsRefreshButton-ToolTip], Source={x:Static loc:LocalizationManager.Instance}}" />
            <controls:SettingsExpander.Items>
                <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding $parent[settings:McpHelpSection].McpToolsStatus}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding $parent[settings:McpHelpSection].McpTools}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="{x:Type mcpServer:McpToolItemViewModel}">
                                    <m3:MaterialSurface
                                        Padding="16"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="12">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3">
                                            <TextBlock
                                                FontFamily="{DynamicResource PixevalMonospaceFontFamily}"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                IsVisible="{Binding HasTitle}"
                                                Text="{Binding TitleText}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                IsVisible="{Binding HasDescription}"
                                                Text="{Binding DescriptionText}"
                                                TextWrapping="Wrap" />
                                            <StackPanel
                                                Grid.Row="3"
                                                Margin="0,6,0,0"
                                                Spacing="6">
                                                <ItemsControl IsVisible="{Binding HasParameters}" ItemsSource="{Binding Parameters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="{x:Type mcpServer:McpToolParameterItemViewModel}">
                                                            <Grid Margin="0,0,0,4" RowDefinitions="Auto,Auto">
                                                                <TextBlock
                                                                    FontFamily="{DynamicResource PixevalMonospaceFontFamily}"
                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                    Text="{Binding Signature}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    Grid.Row="1"
                                                                    Margin="12,1,0,0"
                                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                    IsVisible="{Binding HasDescription}"
                                                                    Text="{Binding DescriptionText}"
                                                                    TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    IsVisible="{Binding HasNoParameters}"
                                                    Text="{CompiledBinding [HelpPage-McpToolsParameters-Empty], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </m3:MaterialSurface>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Grid>
        </m3:MaterialSurface>
    </StackPanel>
</UserControl>
