<UserControl
    x:Class="Pixeval.Views.Settings.McpHelpSection"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pixeval.Controls"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mcpServer="using:Pixeval.ViewModels.Settings"
    xmlns:pixeval="using:Pixeval"
    xmlns:settings="using:Pixeval.Views.Settings"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:controls="using:CommunityToolkit.Avalonia.Controls"
    xmlns:markup="using:FluentIcons.Avalonia.Markup">
    <StackPanel Spacing="10">
        <Expander Classes="documentation-section">
            <Expander.Header>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <m3:MaterialSymbol Symbol="SmartToy" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{CompiledBinding [HelpPage-McpHelpExpander-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        TextWrapping="Wrap" />
                </Grid>
            </Expander.Header>
            <local:MarkdownBox Markdown="{CompiledBinding [McpHelp], Source={x:Static loc:LocalizedHelp.Instance}}" />
        </Expander>
        <m3:MaterialSurface Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16">
            <Grid ColumnDefinitions="*,Auto">
                <m3:IconButton
                    x:Name="RefreshMcpToolsButton"
                    Grid.Column="1"
                    Margin="4"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{Binding (ToolTip.Tip), RelativeSource={RelativeSource Self}}"
                    Click="RefreshMcpToolsButton_OnClicked"
                    Symbol="Sync"
                    ToolTip.Tip="{CompiledBinding [HelpPage-McpToolsRefreshButton-ToolTip], Source={x:Static loc:LocalizationManager.Instance}}" />
                <Expander x:Name="ToolsExpander">
                    <Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <PathIcon Data="{markup1:SvgPath {x:Static pixeval:SvgResources.MCP}}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{CompiledBinding [HelpPage-McpToolsExpander-Header], Source={x:Static loc:LocalizationManager.Instance}}" TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{CompiledBinding [HelpPage-McpToolsExpander-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                                    TextWrapping="Wrap"
                                    Theme="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="10">
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding $parent[settings:McpHelpSection].McpToolsStatus}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding $parent[settings:McpHelpSection].McpTools}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="{x:Type mcpServer:McpToolItemViewModel}">
                                    <m3:MaterialSurface
                                        Padding="16"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="12">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3">
                                            <TextBlock
                                                FontFamily="{DynamicResource PixevalMonospaceFontFamily}"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                IsVisible="{Binding HasTitle}"
                                                Text="{Binding TitleText}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                IsVisible="{Binding HasDescription}"
                                                Text="{Binding DescriptionText}"
                                                TextWrapping="Wrap" />
                                            <StackPanel
                                                Grid.Row="3"
                                                Margin="0,6,0,0"
                                                Spacing="6">
                                                <ItemsControl IsVisible="{Binding HasParameters}" ItemsSource="{Binding Parameters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="{x:Type mcpServer:McpToolParameterItemViewModel}">
                                                            <Grid Margin="0,0,0,4" RowDefinitions="Auto,Auto">
                                                                <TextBlock
                                                                    FontFamily="{DynamicResource PixevalMonospaceFontFamily}"
                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                    Text="{Binding Signature}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    Grid.Row="1"
                                                                    Margin="12,1,0,0"
                                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                    IsVisible="{Binding HasDescription}"
                                                                    Text="{Binding DescriptionText}"
                                                                    TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    IsVisible="{Binding HasNoParameters}"
                                                    Text="{CompiledBinding [HelpPage-McpToolsParameters-Empty], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </m3:MaterialSurface>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Grid>
        </m3:MaterialSurface>
    </StackPanel>
</UserControl>
