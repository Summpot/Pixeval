<controls:SettingsExpander
    x:Class="Pixeval.Views.Settings.WorkSubscriptionsSettingsExpander"
    xmlns="https://github.com/avaloniaui"
    xmlns:nativeStorage="using:Pixeval.Storage"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="using:AutoSettingsPage.Avalonia"
    xmlns:controls="using:CommunityToolkit.Avalonia.Controls"
    xmlns:controls1="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entries="using:Pixeval.Config"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:local="using:Pixeval.Views.Settings"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:options="using:Pixeval.Config"
    xmlns:pixeval="using:Pixeval"
    x:DataType="{x:Type entries:WorkSubscriptionsSettingsEntry}"
    x:Name="Root"
    Description="{Binding Converter={x:Static avalonia:SettingsEntryHelper.DescriptionConverter}}"
    Header="{Binding Header}"
    Tag="{Binding Token}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:converters="using:Pixeval.Common.Converters"
    xmlns:storage="using:Pixeval.Storage">
    <controls:SettingsExpander.HeaderIcon>
        <fluent:SymbolIcon Symbol="{Binding Icon}" />
    </controls:SettingsExpander.HeaderIcon>
    <controls:SettingsExpander.Content>
        <m3:IconButton
            x:Name="SyncAllSubscriptionsButton"
            AutomationProperties.Name="{Binding (ToolTip.Tip), RelativeSource={RelativeSource Self}}"
            Click="SyncAllButton_OnClicked"
            Symbol="Sync"
            ToolTip.Tip="{CompiledBinding [WorkSubscriptionsSettingsExpander-SyncAllSubscriptionsButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
    </controls:SettingsExpander.Content>
    <controls:SettingsExpander.Items>
        <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Left">
            <Grid
                x:Name="EditorGrid"
                ColumnDefinitions="180,*,*,Auto"
                ColumnSpacing="8"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                RowSpacing="8"
                SizeChanged="EditorGrid_OnSizeChanged">
                <TextBox
                    x:Name="TargetIdTextBox"
                    AutomationProperties.Name="{CompiledBinding [WorkSubscriptionsSettingsExpander-TargetIdTextBox-PlaceholderText], Source={x:Static loc:LocalizationManager.Instance}}"
                    PlaceholderText="{CompiledBinding [WorkSubscriptionsSettingsExpander-TargetIdTextBox-PlaceholderText], Source={x:Static loc:LocalizationManager.Instance}}" />
                <controls1:SymbolComboBox
                    x:Name="SubscriptionTypeComboBox"
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{CompiledBinding [WorkSubscriptionsSettingsExpander-SubscriptionType], Source={x:Static loc:LocalizationManager.Instance}}"
                    IconMode="False"
                    ItemsSource="{markup1:EnumResources x:TypeArguments=options:WorkSubscriptionType}"
                    SelectedIndex="0"
                    SelectionChanged="SubscriptionTypeComboBox_OnSelectionChanged" />
                <controls1:SymbolComboBox
                    x:Name="WorkKindComboBox"
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{CompiledBinding [WorkSubscriptionsSettingsExpander-WorkKind], Source={x:Static loc:LocalizationManager.Instance}}"
                    IconMode="False"
                    SelectedIndex="0" />
                <m3:IconButton
                    x:Name="AddSubscriptionButton"
                    Grid.Row="0"
                    Grid.Column="3"
                    AutomationProperties.Name="{CompiledBinding [WorkSubscriptionsSettingsExpander-AddSubscriptionButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="AddButton_OnClicked"
                    IsEnabled="{Binding !#Root.IsAdding}"
                    Symbol="Add"
                    Theme="{StaticResource MaterialTonalIconButtonTheme}"
                    ToolTip.Tip="{CompiledBinding [WorkSubscriptionsSettingsExpander-AddSubscriptionButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                <controls1:InfoBar
                    x:Name="ErrorTextBlock"
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    IsVisible="False"
                    Mode="Error" />
                <ProgressBar
                    x:Name="AddProgress"
                    Grid.Row="4"
                    Grid.ColumnSpan="4"
                    AutomationProperties.Name="{CompiledBinding [WorkSubscriptionsSettingsExpander-AddSubscriptionButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                    IsIndeterminate="True"
                    IsVisible="{Binding #Root.IsAdding}" />
            </Grid>
        </controls:SettingsCard>
        <controls:SettingsCard
            HorizontalContentAlignment="Stretch"
            ContentAlignment="Left"
            IsVisible="{Binding !!$parent[local:WorkSubscriptionsSettingsExpander].Subscriptions.Count}">
            <ItemsControl x:Name="SubscriptionItemsControl" ItemsSource="{Binding $parent[local:WorkSubscriptionsSettingsExpander].Subscriptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type nativeStorage:WorkSubscriptionRecord}">
                        <Grid
                            Margin="4"
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="8"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="4">
                            <controls1:UserBasicInfoPresenter
                                Grid.Column="0"
                                AutomationProperties.Name="{Binding DisplayName}"
                                ToolTip.Tip="{Binding DisplayName}"
                                User="{Binding}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap">
                                <Run Text="{Binding SubscriptionTypeText}" /><Run Text=" · " />
                                <Run Text="{Binding WorkKindText}" />
                            </TextBlock>
                            <m3:IconButton
                                x:Name="SyncSubscriptionButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding (ToolTip.Tip), RelativeSource={RelativeSource Self}}"
                                Click="SyncSubscriptionButton_OnClicked"
                                Symbol="Sync"
                                Tag="{Binding}"
                                ToolTip.Tip="{CompiledBinding [DownloadPage-SyncSubscriptionButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                            <m3:IconButton
                                x:Name="DeleteSubscriptionButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{CompiledBinding [WorkSubscriptionsSettingsExpander-RemoveSubscriptionButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                                Click="DeleteButton_OnClicked"
                                Symbol="Delete"
                                Tag="{Binding}"
                                ToolTip.Tip="{CompiledBinding [WorkSubscriptionsSettingsExpander-RemoveSubscriptionButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </controls:SettingsCard>
    </controls:SettingsExpander.Items>
</controls:SettingsExpander>
