<ContentPage
    x:Class="Pixeval.Views.Settings.SettingsMainView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:appManagement="using:Pixeval.Services.Core"
    xmlns:controls="using:CommunityToolkit.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:Pixeval.Services.Background"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AutoSettingsPage.Models"
    xmlns:options="using:Pixeval.Config"
    xmlns:pixeval="using:Pixeval"
    xmlns:pixevalControls="using:Pixeval.Controls"
    xmlns:utilities="using:Pixeval.Common"
    xmlns:viewModels="using:Pixeval.ViewModels.Settings"
    x:DataType="{x:Type viewModels:SettingsPageViewModel}"
    Header="{CompiledBinding [MainPage-Tab-Settings], Source={x:Static loc:LocalizationManager.Instance}}"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="{StaticResource SettingStackPanelSpacing}">
            <controls:SettingsExpander HeaderIcon="{markup:SymbolIcon ArrowSync}">
                <controls:SettingsExpander.Header>
                    <HyperlinkButton
                        Padding="0"
                        Command="{Binding ShowReleaseNotesCommand}"
                        Content="{Binding CurrentVersion, Mode=OneTime}" />
                </controls:SettingsExpander.Header>
                <controls:SettingsExpander.Description>
                    <StackPanel Spacing="3">
                        <TextBlock>
                            <Run Text="{CompiledBinding [SettingsMainView-LastCheckedPrefix], Source={x:Static loc:LocalizationManager.Instance}}" />
                            <Run Text="{Binding LastCheckedUpdate}" />
                        </TextBlock>
                    </StackPanel>
                </controls:SettingsExpander.Description>
                <controls:SettingsExpander.Content>
                    <Button Command="{Binding CheckForUpdateCommand}" Content="{CompiledBinding [SettingsMainView-CheckForUpdatesButton-Content], Source={x:Static loc:LocalizationManager.Instance}}" />
                </controls:SettingsExpander.Content>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{CompiledBinding [SettingsMainView-OpenTempEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-OpenTempEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon FolderLightning}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.TempFolder}" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon ChevronRight}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="ms-windows-store://pdp/?ProductId=9P1RZL9Z8454"
                        Header="{CompiledBinding [SettingsMainView-MsStoreCheckForUpdatesEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon StoreMicrosoft}"
                        IsClickEnabled="True"
                        Tag="ms-windows-store://pdp/?ProductId=9P1RZL9Z8454" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon ChevronRight}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="https://github.com/Pixeval/Pixeval/releases"
                        Header="{CompiledBinding [SettingsMainView-GitHubCheckForUpdatesEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        IsClickEnabled="True"
                        Tag="https://github.com/Pixeval/Pixeval/releases">
                        <controls:SettingsCard.HeaderIcon>
                            <PathIcon Data="{markup1:SvgPath {x:Static pixeval:SvgResources.GitHub}}" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <pixevalControls:InfoBar Mode="{Binding UpdateStatusMode}" Text="{Binding UpdateStatusText}" />

            <controls:SettingsExpander
                Description="{CompiledBinding [SettingsMainView-BugReportEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                Header="{CompiledBinding [SettingsMainView-BugReportEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                HeaderIcon="{markup:SymbolIcon Bug}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Description="{CompiledBinding [SettingsMainView-BugReportChannelsEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-BugReportChannelsEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon Send}">
                        <CommandBar
                            Background="Transparent"
                            DefaultLabelPosition="Collapsed"
                            IsDynamicOverflowEnabled="True">
                            <CommandBarButton
                                Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                                Tag="https://github.com/Pixeval/Pixeval/issues/new/choose"
                                ToolTip.Tip="{CompiledBinding [SettingsMainView-GitHubBugReportEntry-ToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                                <CommandBarButton.Icon>
                                    <PathIcon Data="{markup1:SvgPath {x:Static pixeval:SvgResources.GitHub}}" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                            <CommandBarButton
                                Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                                Icon="{markup:SymbolIcon Mail}"
                                Tag="mailto:poker_sang@outlook.com"
                                ToolTip.Tip="{CompiledBinding [SettingsMainView-EMailBugReportEntry-ToolTip], Source={x:Static loc:LocalizationManager.Instance}}" />
                            <CommandBarButton
                                Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                                Tag="https://jq.qq.com/?_wv=1027&amp;k=trDeCrog"
                                ToolTip.Tip="{CompiledBinding [SettingsMainView-QQBugReportEntry-ToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                                <CommandBarButton.Icon>
                                    <PathIcon Data="{markup1:SvgPath {x:Static pixeval:SvgResources.QQ}}" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                        </CommandBar>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{CompiledBinding [SettingsMainView-OpenLogEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-OpenLogEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon FolderList}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.LogsFolder}" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{CompiledBinding [SettingsMainView-OpenTempEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-OpenTempEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon FolderLightning}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.TempFolder}" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{CompiledBinding [SettingsMainView-OpenLocalEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-OpenLocalEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon FolderBriefcase}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.ApplicationFolderPath}" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{CompiledBinding [SettingsMainView-OpenExtensionsEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-OpenExtensionsEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon FolderAdd}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.ExtensionsFolder}" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{CompiledBinding [SettingsMainView-OpenSettingsEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-OpenSettingsEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon FolderPerson}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.SettingsFolder}" />
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsCard
                ActionIcon="{markup:SymbolIcon Open}"
                Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                Description="{CompiledBinding [SettingsMainView-RateEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                Header="{CompiledBinding [SettingsMainView-RateEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                HeaderIcon="{markup:SymbolIcon Star}"
                IsClickEnabled="True"
                Tag="ms-windows-store://pdp/?ProductId=9P1RZL9Z8454" />

            <controls:SettingsCard
                ActionIcon="{markup:SymbolIcon ChevronRight}"
                pixevalControls:ClickCommandBehavior.Command="{Binding SwitchAccountCommand}"
                Description="{CompiledBinding [SettingsMainView-SwitchAccountEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                Header="{CompiledBinding [SettingsMainView-SwitchAccountEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                HeaderIcon="{markup:SymbolIcon PersonSwap}"
                IsClickEnabled="True" />

            <controls:SettingsCard
                ActionIcon="{markup:SymbolIcon ArrowReset}"
                pixevalControls:ClickCommandBehavior.Command="{Binding ResetDefaultSettingsCommand}"
                Description="{CompiledBinding [SettingsMainView-ResetDefaultSettingsEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                Header="{CompiledBinding [SettingsMainView-ResetDefaultSettingsEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                HeaderIcon="{markup:SymbolIcon Apps}"
                IsClickEnabled="True" />

            <controls:SettingsExpander
                Description="{CompiledBinding [SettingsMainView-BackupSettingsEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                Header="{CompiledBinding [SettingsMainView-BackupSettingsEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                HeaderIcon="{markup:SymbolIcon ClipboardSettings}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                        Description="{CompiledBinding [SettingsMainView-OpenSettingsEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-OpenSettingsEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon FolderPerson}"
                        IsClickEnabled="True"
                        Tag="{x:Static appManagement:AppInfo.SettingsFolder}" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        pixevalControls:ClickCommandBehavior.Command="{Binding ExportSettingsCommand}"
                        Description="{CompiledBinding [SettingsMainView-ExportSettingsPlaintextEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-ExportSettingsPlaintextEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon ArrowExport}"
                        IsClickEnabled="True" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon Open}"
                        pixevalControls:ClickCommandBehavior.Command="{Binding ImportSettingsCommand}"
                        Description="{CompiledBinding [SettingsMainView-ImportSettingsPlaintextEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-ImportSettingsPlaintextEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon ArrowImport}"
                        IsClickEnabled="True" />
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="{CompiledBinding [SettingsMainView-DeleteHistoriesEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}" HeaderIcon="{markup:SymbolIcon HistoryDismiss}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon ChevronRight}"
                        pixevalControls:ClickCommandBehavior.Command="{Binding ClearDataCommand}" pixevalControls:ClickCommandBehavior.CommandParameter="{x:Static options:ClearDataKind.FileCache}"
                        Description="{CompiledBinding [SettingsMainView-DeleteFileCacheEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-DeleteFileCacheEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon HistoryDismiss}"
                        IsClickEnabled="True" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon ChevronRight}"
                        pixevalControls:ClickCommandBehavior.Command="{Binding ClearDataCommand}" pixevalControls:ClickCommandBehavior.CommandParameter="{x:Static options:ClearDataKind.SearchHistory}"
                        Description="{CompiledBinding [SettingsMainView-DeleteSearchHistoriesEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-DeleteSearchHistoriesEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon HistoryDismiss}"
                        IsClickEnabled="True" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon ChevronRight}"
                        pixevalControls:ClickCommandBehavior.Command="{Binding ClearDataCommand}" pixevalControls:ClickCommandBehavior.CommandParameter="{x:Static options:ClearDataKind.BrowseHistory}"
                        Description="{CompiledBinding [SettingsMainView-DeleteBrowseHistoriesEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-DeleteBrowseHistoriesEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon HistoryDismiss}"
                        IsClickEnabled="True" />
                    <controls:SettingsCard
                        ActionIcon="{markup:SymbolIcon ChevronRight}"
                        pixevalControls:ClickCommandBehavior.Command="{Binding ClearDataCommand}" pixevalControls:ClickCommandBehavior.CommandParameter="{x:Static options:ClearDataKind.DownloadHistory}"
                        Description="{CompiledBinding [SettingsMainView-DeleteDownloadHistoriesEntry-Description], Source={x:Static loc:LocalizationManager.Instance}}"
                        Header="{CompiledBinding [SettingsMainView-DeleteDownloadHistoriesEntry-Header], Source={x:Static loc:LocalizationManager.Instance}}"
                        HeaderIcon="{markup:SymbolIcon HistoryDismiss}"
                        IsClickEnabled="True" />
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <controls:SettingsCard
                ActionIcon="{markup:SymbolIcon ChevronRight}"
                pixevalControls:ClickCommandBehavior.Command="{Binding #Root.OpenAboutCommand}"
                Header="{CompiledBinding [MainPage-Tab-About], Source={x:Static loc:LocalizationManager.Instance}}"
                HeaderIcon="{markup:SymbolIcon PersonStarburst,
                                               IconVariant=Color}"
                IsClickEnabled="True" />
            <controls:SettingsCard
                ActionIcon="{markup:SymbolIcon ChevronRight}"
                pixevalControls:ClickCommandBehavior.Command="{Binding #Root.OpenHelpCommand}"
                Header="{CompiledBinding [MainPage-Tab-Help], Source={x:Static loc:LocalizationManager.Instance}}"
                HeaderIcon="{markup:SymbolIcon ChatBubblesQuestion,
                                               IconVariant=Color}"
                IsClickEnabled="True" />
            <controls:SettingsCard
                ActionIcon="{markup:SymbolIcon ChevronRight}"
                pixevalControls:ClickCommandBehavior.Command="{Binding #Root.OpenNavigationSettingsCommand}"
                Header="{CompiledBinding [MainPage-Tab-NavigationSettings], Source={x:Static loc:LocalizationManager.Instance}}"
                HeaderIcon="{markup:SymbolIcon LocationRipple,
                                               IconVariant=Color}"
                IsClickEnabled="True" />
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource SettingStackPanelSpacing}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate x:DataType="{x:Type extensions:ExtensionSettingsGroup}">
                        <controls:SettingsCard
                            ActionIcon="{markup:SymbolIcon ChevronRight}"
                            pixevalControls:ClickCommandBehavior.Command="{Binding #Root.OpenGroupCommand}"
                            pixevalControls:ClickCommandBehavior.CommandParameter="{Binding}"
                            Description="{Binding Description}"
                            Header="{Binding Header}"
                            HeaderIcon="{Binding Icon}"
                            IsClickEnabled="True" />
                    </DataTemplate>
                    <DataTemplate x:DataType="{x:Type models:ISettingsGroup}">
                        <controls:SettingsCard
                            ActionIcon="{markup:SymbolIcon ChevronRight}"
                            pixevalControls:ClickCommandBehavior.Command="{Binding #Root.OpenGroupCommand}"
                            pixevalControls:ClickCommandBehavior.CommandParameter="{Binding}"
                            Description="{Binding Description}"
                            Header="{Binding Header}"
                            IsClickEnabled="True">
                            <controls:SettingsCard.HeaderIcon>
                                <fluent:SymbolIcon IconVariant="Color" Symbol="{Binding Icon}" />
                            </controls:SettingsCard.HeaderIcon>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</ContentPage>
