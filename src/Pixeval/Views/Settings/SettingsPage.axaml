<NavigationPage
    x:Class="Pixeval.Views.Settings.SettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:di="using:Pixeval.Common.Markup"
    xmlns:viewModels="using:Pixeval.ViewModels.Settings"
    x:DataType="{x:Type viewModels:SettingsPageViewModel}"
    DataContext="{di:Service Type={x:Type viewModels:SettingsPageViewModel}}"
    HasShadow="True"
    Header="{CompiledBinding [MainPage-Tab-Settings], Source={x:Static loc:LocalizationManager.Instance}}"
    Icon="{markup:SymbolIcon Settings,
                             FontSize=16,
                             IconVariant=Color}"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800" />
