<views:IconContentPage
    x:Class="Pixeval.Views.Settings.AboutPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:appCommon="using:Pixeval.Common"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pixeval.Controls"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:settings="using:Pixeval.Views.Settings"
    xmlns:utilities="using:Pixeval.Common"
    xmlns:views="using:Pixeval.Views.Shell"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="800"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:controls="using:CommunityToolkit.Avalonia.Controls"
    xmlns:markup="using:FluentIcons.Avalonia.Markup">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">
            <StackPanel Spacing="10">
                <TextBlock Text="Pixeval" Theme="{StaticResource TitleTextBlockStyle}" />
                <SelectableTextBlock
                    VerticalAlignment="Bottom"
                    Text="{Binding $parent[settings:AboutPage].CurrentVersionText}"
                    Theme="{StaticResource CaptionTextBlockStyle}" />

                <TextBlock
                    DockPanel.Dock="Top"
                    Text="{CompiledBinding [AboutPage-AppDescriptionTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                    TextWrapping="Wrap" />

                <!--  Special Thanks  -->
                <TextBlock Text="{CompiledBinding [AboutPage-SpecialThanksSubtitleTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}" Theme="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{Binding $parent[settings:AboutPage].Supporters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="10" LineSpacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type settings:Supporter}">
                            <m3:Card
                                Width="140"
                                MinHeight="160"
                                Padding="12"
                                AutomationProperties.Name="{Binding Nickname}"
                                Click="{x:Static appCommon:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                                IsClickable="True"
                                Tag="{Binding ProfileUri}"
                                ToolTip.Tip="{Binding ProfileUri}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <local:AvatarImage
                                        Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        local:Source.Cache="{Binding LocalProfilePicture}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Text="{Binding Nickname}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Theme="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding AtName}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Theme="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </m3:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Dependencies  -->
                <TextBlock Text="{CompiledBinding [AboutPage-DependenciesSubtitleTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}" Theme="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Static settings:DependencyViewModel.DependencyViewModels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource SettingStackPanelSpacing}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type settings:DependencyViewModel}">
                            <m3:MaterialSurface Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Expander>
                                        <Expander.Header>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Author}"
                                                    TextWrapping="Wrap"
                                                    Theme="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <local:MarkdownBox Markdown="{Binding License}" />
                                    </Expander>
                                    <m3:IconButton
                                        Grid.Column="1"
                                        Margin="4"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="{Binding Url}"
                                        Click="{x:Static appCommon:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                                        Symbol="OpenInNew"
                                        Tag="{Binding Url}"
                                        ToolTip.Tip="{Binding Url}" />
                                </Grid>
                            </m3:MaterialSurface>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Open Source License  -->
                <TextBlock Text="{CompiledBinding [AboutPage-OpenSourceLicenseSubtitleTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}" Theme="{StaticResource SubtitleTextBlockStyle}" />
                <local:MarkdownBox x:Name="LicenseTextBlock" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</views:IconContentPage>
