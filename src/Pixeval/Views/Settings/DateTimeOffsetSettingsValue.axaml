<TextBox
    x:Class="Pixeval.Views.Settings.DateTimeOffsetSettingsValue"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AutoSettingsPage.Models"
    xmlns:system="using:System"
    x:DataType="{x:Type models:ISingleValueSettingsEntry,
                        x:TypeArguments=system:DateTimeOffset}"
    MinWidth="320"
    AutomationProperties.Name="{Binding Header}"
    PlaceholderText="{Binding Placeholder}" />
