<views:IconContentPage
    x:Class="Pixeval.Views.Settings.ExtensionsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:localSettings="using:Pixeval.Views.Settings"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.Avalonia.Controls"
    xmlns:converters="using:Pixeval.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:Pixeval.Services.Background"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:views="using:Pixeval.Views"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="600"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:shell="using:Pixeval.Views.Shell"
    xmlns:settings="using:Pixeval.Views.Settings">
    <DockPanel>
        <WrapPanel
            Margin="20"
            DockPanel.Dock="Top"
            ItemSpacing="20"
            LineSpacing="8"
            Orientation="Horizontal">
            <TextBlock
                MaxWidth="{Binding $parent[WrapPanel].Bounds.Width}"
                Text="{CompiledBinding [ExtensionsPage-TitleTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}"
                TextWrapping="Wrap"
                Theme="{StaticResource TitleTextBlockStyle}" />
            <TextBlock VerticalAlignment="Bottom" Theme="{StaticResource SubtitleTextBlockStyle}">
                <Run Text="{CompiledBinding [ExtensionsPage-SubtitleTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}" />
                <Run Text="{x:Static extensions:ExtensionService.CurrentVersion}" />
            </TextBlock>
        </WrapPanel>
        <CommandBar
            x:Name="ManagementCommandBar"
            DefaultLabelPosition="Right"
            DockPanel.Dock="Top"
            IsDynamicOverflowEnabled="True"
            ItemWidthRight="320">
            <CommandBarButton
                Click="AddExtensionsOnClick"
                Icon="{markup:SymbolIcon PlugConnectedAdd}"
                Label="{CompiledBinding [ExtensionsPage-AddExtensionsButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
            <CommandBarButton
                Click="OpenExtensionsOnClick"
                Icon="{markup:SymbolIcon FolderAdd}"
                Label="{CompiledBinding [ExtensionsPage-OpenExtensionsButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
            <CommandBarButton
                Click="UninstallAllExtensionsOnClick"
                Icon="{markup:SymbolIcon Delete}"
                Label="{CompiledBinding [ExtensionsPage-UninstallAllExtensionsButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
            <CommandBarButton
                Click="UninstallOutdatedExtensionsOnClick"
                Icon="{markup:SymbolIcon Alert}"
                Label="{CompiledBinding [ExtensionsPage-UninstallOutdatedExtensionsButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
        </CommandBar>
        <ScrollViewer Margin="20,10,20,20">
            <ItemsControl ItemsSource="{Binding $parent[localSettings:ExtensionsPage].Models}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type extensions:ExtensionsHostModel}">
                        <controls:SettingsCard
                            Margin="0,0,0,8"
                            Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
                            BorderBrush="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OutlineVariant}}"
                            CornerRadius="16"
                            Description="{Binding Description}"
                            HeaderIcon="{Binding Icon}">
                            <controls:SettingsCard.Header>
                                <StackPanel Spacing="4">
                                    <HyperlinkButton
                                        Padding="4,2"
                                        HorizontalContentAlignment="Left"
                                        Content="{Binding Name}"
                                        CornerRadius="4"
                                        FontWeight="Bold"
                                        NavigateUri="{Binding Link}" />
                                    <TextBlock
                                        Foreground="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.OnSurfaceVariant}}"
                                        Text="{Binding Author}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ToggleSwitch AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsActive, Mode=TwoWay}" />
                                <CommandBar DefaultLabelPosition="Collapsed">
                                    <CommandBarButton
                                        Click="ExtensionsPriorityUpOnClick"
                                        Icon="{markup:SymbolIcon ChevronUp}"
                                        Label="{CompiledBinding [ExtensionsPage-ExtensionsPriorityUpButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                                        ToolTip.Tip="{CompiledBinding [ExtensionsPage-ExtensionsPriorityUpButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                                    <CommandBarButton
                                        Click="ExtensionsPriorityDownOnClick"
                                        Icon="{markup:SymbolIcon ChevronDown}"
                                        Label="{CompiledBinding [ExtensionsPage-ExtensionsPriorityDownButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                                        ToolTip.Tip="{CompiledBinding [ExtensionsPage-ExtensionsPriorityDownButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                                    <CommandBar.SecondaryCommands>
                                        <CommandBarButton
                                            Click="ExtensionsHelpOnClick"
                                            Icon="{markup:SymbolIcon BookQuestionMark}"
                                            IsVisible="{Binding HelpLink, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Label="{CompiledBinding [ExtensionsPage-ExtensionsHelpButton-Label], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Tag="{Binding HelpLink}" />
                                        <CommandBarButton
                                            Click="ExtensionsPriorityTopOnClick"
                                            Icon="{markup:SymbolIcon ChevronDoubleUp}"
                                            Label="{CompiledBinding [ExtensionsPage-ExtensionsPriorityTopButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                                        <CommandBarButton
                                            Click="ExtensionsPriorityBottomOnClick"
                                            Icon="{markup:SymbolIcon ChevronDoubleDown}"
                                            Label="{CompiledBinding [ExtensionsPage-ExtensionsPriorityBottomButton-Label], Source={x:Static loc:LocalizationManager.Instance}}" />
                                        <CommandBarButton
                                            Click="UninstallHostOnClick"
                                            Icon="{Binding UninstallCommandIcon, Converter={x:Static converters:PixevalConverters.SymbolIconConverter}}"
                                            Label="{Binding UninstallCommandLabel}" />
                                    </CommandBar.SecondaryCommands>
                                </CommandBar>
                            </StackPanel>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</views:IconContentPage>
