<views:IconContentPage
    x:Class="Pixeval.Views.HistoryPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:Mako.Global.Enum"
    xmlns:markup1="using:Pixeval.Views.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:views="using:Pixeval.Views"
    xmlns:work="using:Pixeval.Views.Work"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <work:WorkContainer x:Name="WorkContainer" RefreshRequested="WorkContainer_OnRefreshRequested">
        <work:WorkContainer.CommandBarElements>
            <controls:SymbolComboBox
                x:Name="SimpleWorkTypeComboBox"
                Width="180"
                MinWidth="0"
                MaxWidth="{Binding $parent[WrapPanel].Bounds.Width}"
                AutomationProperties.Name="{I18N {x:Static pixeval:HomePageResources+Source+WorkTypeTextBlock.Text}}"
                IconMode="False"
                ItemsSource="{markup1:EnumResources x:TypeArguments=enum:SimpleWorkType}"
                SelectedValue="{x:Static views:PixevalSettings.SimpleWorkType}"
                SelectionChanged="SimpleWorkTypeComboBox_OnSelectionChanged">
                <controls:SymbolComboBox.TextItemTemplate>
                    <DataTemplate x:DataType="{x:Type controls:SymbolComboBoxItem}">
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    </DataTemplate>
                </controls:SymbolComboBox.TextItemTemplate>
            </controls:SymbolComboBox>
        </work:WorkContainer.CommandBarElements>
    </work:WorkContainer>
</views:IconContentPage>
