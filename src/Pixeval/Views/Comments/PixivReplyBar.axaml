<UserControl
    x:Class="Pixeval.Views.Comments.PixivReplyBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comment="using:Pixeval.Views.Comments"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pixeval="using:Pixeval"
    xmlns:utilities="using:Pixeval.Mako"
    x:Name="ReplyBarRoot"
    mc:Ignorable="d"
    d:DesignHeight="40"
    d:DesignWidth="350"
    xmlns:loc="using:Pixeval.Localization"
    xmlns:views="using:Pixeval.Views.Comments">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
        <DockPanel HorizontalSpacing="8" LastChildFill="True">
            <Button
                x:Name="EmojiButton"
                MinWidth="40"
                MinHeight="40"
                Padding="8"
                VerticalAlignment="Center"
                AutomationProperties.Name="{CompiledBinding [PixivReplyBar-OpenEmoji], Source={x:Static loc:LocalizationManager.Instance}}"
                Background="Transparent"
                BorderThickness="0"
                DockPanel.Dock="Left"
                IsEnabled="{Binding !#ReplyBarRoot.IsSubmitting}"
                Theme="{StaticResource TransparentButtonStyle}"
                ToolTip.Tip="{CompiledBinding [PixivReplyBar-OpenEmoji], Source={x:Static loc:LocalizationManager.Instance}}">
                <markup:SymbolIcon FontSize="16" Symbol="Emoji" />
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedLeft">
                        <TabControl
                            Width="300"
                            MaxWidth="{Binding #ReplyBarRoot.Bounds.Width}"
                            SelectedIndex="0">
                            <TabItem Header="{CompiledBinding [CommentRepliesBlock-EmojiButtonFlyoutEmojiSectionNavigationViewItem-Content], Source={x:Static loc:LocalizationManager.Instance}}">
                                <ScrollViewer
                                    Width="300"
                                    Height="150"
                                    MaxWidth="{Binding #ReplyBarRoot.Bounds.Width}"
                                    HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{x:Static utilities:CommentImageHelper.EmojiIds}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="{x:Type x:Int32}">
                                                <Button
                                                    Padding="0"
                                                    Click="EmojiImage_OnClick"
                                                    Theme="{StaticResource TransparentButtonStyle}">
                                                    <Image
                                                        Width="35"
                                                        Height="35"
                                                        controls:Source.Cache="{Binding Converter={x:Static converters:PixevalConverters.StringFormatConverter}, ConverterParameter={x:Static utilities:CommentImageHelper.EmojiDownloadUrl}}"
                                                        Stretch="Uniform" />
                                                    <Button.Styles>
                                                        <Style Selector="Image">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                        </Style>
                                                    </Button.Styles>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="{CompiledBinding [CommentRepliesBlock-EmojiButtonFlyoutStickersSectionNavigationViewItem-Content], Source={x:Static loc:LocalizationManager.Instance}}">
                                <ScrollViewer
                                    Width="300"
                                    Height="150"
                                    MaxWidth="{Binding #ReplyBarRoot.Bounds.Width}"
                                    HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{x:Static utilities:CommentImageHelper.StickerIds}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="{x:Type x:Int32}">
                                                <Button
                                                    Padding="0"
                                                    Click="StickerImage_OnClick"
                                                    Theme="{StaticResource TransparentButtonStyle}">
                                                    <Image
                                                        Width="83"
                                                        Height="83"
                                                        controls:Source.Cache="{Binding Converter={x:Static converters:PixevalConverters.StringFormatConverter}, ConverterParameter={x:Static utilities:CommentImageHelper.StickerDownloadUrl}}"
                                                        Stretch="Uniform" />
                                                    <Button.Styles>
                                                        <Style Selector="Image">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                        </Style>
                                                    </Button.Styles>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button
                x:Name="SendButton"
                MinWidth="40"
                MinHeight="40"
                Padding="8"
                VerticalAlignment="Center"
                AutomationProperties.Name="{CompiledBinding [PixivReplyBar-SendButton-ToolTip], Source={x:Static loc:LocalizationManager.Instance}}"
                Background="Transparent"
                BorderThickness="0"
                Click="SendButton_OnClicked"
                Content="{markup:SymbolIcon Send,
                                            FontSize=16}"
                DockPanel.Dock="Right"
                IsEnabled="{Binding !#ReplyBarRoot.IsSubmitting}"
                Theme="{StaticResource TransparentButtonStyle}"
                ToolTip.Tip="{CompiledBinding [PixivReplyBar-SendButton-ToolTip], Source={x:Static loc:LocalizationManager.Instance}}" />
            <TextBox
                x:Name="ReplyContentTextBox"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AutomationProperties.Name="{CompiledBinding [PixivReplyBar-ReplyContentRichEditBox-PlaceholderText], Source={x:Static loc:LocalizationManager.Instance}}"
                MaxLength="140"
                Text="{Binding #ReplyBarRoot.ReplyText, Mode=TwoWay}"
                PlaceholderText="{CompiledBinding [PixivReplyBar-ReplyContentRichEditBox-PlaceholderText], Source={x:Static loc:LocalizationManager.Instance}}" />
        </DockPanel>
        <ProgressBar
            Grid.Row="1"
            Height="3"
            AutomationProperties.Name="{CompiledBinding [EntryViewerPage-LoadingTextBlock-Text], Source={x:Static loc:LocalizationManager.Instance}}"
            IsIndeterminate="True"
            IsVisible="{Binding #ReplyBarRoot.IsSubmitting}" />
    </Grid>
</UserControl>
