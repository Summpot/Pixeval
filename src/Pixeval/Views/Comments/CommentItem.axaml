<UserControl
    x:Class="Pixeval.Views.Comments.CommentItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Common.Markup"
    xmlns:mako="using:Pixeval.Mako"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Pixeval.Services.Core"
    x:DataType="{x:Type mako:CommentRecord}"
    mc:Ignorable="d"
    d:DesignHeight="120"
    d:DesignWidth="350">
    <DockPanel Margin="8" LastChildFill="True">
        <!--  Bottom: Comment content or stamp  -->
        <Panel Margin="57,5,0,0" DockPanel.Dock="Bottom">
            <TextBlock
                controls:TranslatableTextBlockBehavior.IsEnabled="True"
                controls:TranslatableTextBlockBehavior.TextType="Comment"
                IsVisible="{Binding !IsStamp}"
                Text="{Binding DisplayText}"
                TextWrapping="Wrap" />
            <Image
                x:Name="StickerImage"
                MaxHeight="100"
                HorizontalAlignment="Left"
                controls:Source.Cache="{Binding StampUrl}"
                IsVisible="{Binding IsStamp}"
                Stretch="Uniform" />
        </Panel>

            <!--  Right: Action buttons  -->
            <StackPanel
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Spacing="3">
                <Button
                    x:Name="DeleteButton"
                    MinWidth="40"
                    MinHeight="40"
                    Padding="6"
                    AutomationProperties.Name="{I18N {x:Static pixeval:CommentItemResources.Delete}}"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="DeleteReplyButton_OnClicked"
                    Content="{markup:SymbolIcon Delete}"
                    IsEnabled="{Binding !IsDeleting}"
                    IsVisible="{Binding IsMe}"
                    Theme="{StaticResource TransparentButtonStyle}"
                    ToolTip.Tip="{I18N {x:Static pixeval:CommentItemResources.Delete}}" />
                <Button
                    x:Name="RepliesButton"
                    MinWidth="40"
                    MinHeight="40"
                    Padding="6"
                    AutomationProperties.Name="{I18N {x:Static pixeval:CommentItemResources.Replies}}"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OpenRepliesButton_OnClicked"
                    Content="{markup1:EitherBinding {Binding HasReplies},
                                                    {markup:SymbolIcon Chat,
                                                                       IconVariant=Color},
                                                    {markup:SymbolIcon ChatAdd},
                                                    x:TypeArguments=fluent:SymbolIcon}"
                    IsVisible="{Binding IsTopComment}"
                    Theme="{StaticResource TransparentButtonStyle}"
                    ToolTip.Tip="{I18N {x:Static pixeval:CommentItemResources.Replies}}" />
            </StackPanel>

            <!--  Poster info  -->
            <Button
                x:Name="AuthorButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{Binding User}"
                Background="Transparent"
                BorderThickness="0"
                Click="DeleteReplyButton_OnClicked"
                Content="{markup:SymbolIcon Delete}"
                Theme="{StaticResource TransparentButtonStyle}">
                <Button.IsVisible>
                    <MultiBinding Converter="{x:Static converters:PixevalConverters.LongEquals}">
                        <Binding Path="User.Id" />
                        <Binding Path="CurrentUserId" DataType="{x:Type services:IUserSessionService}" Source="{markup1:Service Type={x:Type services:IUserSessionService}}" />
                    </MultiBinding>
                </Button.IsVisible>
            </Button>
            <Button
                x:Name="OpenRepliesButton"
                Padding="6"
                Background="Transparent"
                BorderThickness="0"
                Click="OpenRepliesButton_OnClicked"
                IsVisible="False"
                Content="{markup1:EitherBinding {Binding HasReplies},
                                                {markup:SymbolIcon Chat,
                                                                   IconVariant=Color},
                                                {markup:SymbolIcon ChatAdd},
                                                x:TypeArguments=fluent:SymbolIcon}"
                Theme="{StaticResource TransparentButtonStyle}" />
        </StackPanel>

        <!--  Poster info  -->
        <Button
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Click="PosterButton_OnClicked"
            Theme="{StaticResource TransparentButtonStyle}">
            <DockPanel HorizontalSpacing="10" LastChildFill="False">
                <controls:AvatarImage
                    Width="35"
                    controls:Source.Cache="{Binding User.ProfileImageUrls.Medium}"
                    DockPanel.Dock="Left" />
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding User.Name}" Theme="{StaticResource CaptionStrongTextBlockStyle}" />
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding PostedAt, Converter={x:Static converters:PixevalConverters.DateTimeShortDate}}"
                        Theme="{StaticResource CaptionStrongTextBlockStyle}" />
                </StackPanel>
            </DockPanel>
        </Button>
    </DockPanel>
</UserControl>
