<work:WorkItem
    x:Class="Pixeval.Views.Work.NovelItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixeval.Controls"
    xmlns:converters="using:Pixeval.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m3="https://github.com/Shirasagi0012/Material3Expressive.Avalonia"
    xmlns:markup="using:FluentIcons.Avalonia.Markup"
    xmlns:markup1="using:Pixeval.Views.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:Mako.Model"
    xmlns:novel="using:Pixeval.ViewModels"
    xmlns:pixeval="using:Pixeval"
    xmlns:utilities="using:Pixeval.Utilities"
    xmlns:work="using:Pixeval.Views.Work"
    x:DataType="{x:Type novel:NovelItemViewModel}"
    AutomationProperties.Name="{Binding Entry.Title}"
    Background="{m3:Token {x:Static m3:MaterialTokens+Sys+Color.SurfaceContainerLow}}"
    Design.DataContext="{x:Static utilities:DesignHelper.DesignNovelViewModel}"
    Theme="{StaticResource WorkCardButtonTheme}"
    ToolTip.Tip="{Binding Entry.Title}"
    mc:Ignorable="d"
    d:DesignHeight="200"
    d:DesignWidth="400">
    <work:WorkItem.ContextMenu>
        <ContextMenu>
            <MenuItem
                Command="{Binding BookmarkCommand}"
                CommandParameter="{Binding $self, Mode=OneTime}"
                ContextRequested="AddToBookmark_OnRightClick"
                Header="{I18N {x:Static pixeval:EntryItemResources.AddToBookmark}}"
                Icon="{markup1:SymbolIconEx Heart,
                                            IconVariant={Binding IsBookmarkedDisplay,
                                                                 Converter={x:Static converters:PixevalConverters.StateToIconVariant}}}"
                IsVisible="{Binding IsBookmarkSupported}" />
            <MenuItem
                Command="{Binding AddToWatchLaterCommand}"
                CommandParameter="{Binding $self, Mode=OneTime}"
                Header="{I18N {x:Static pixeval:EntryItemResources.AddToWatchLater}}"
                Icon="{markup1:SymbolIconEx Clock,
                                            IconVariant={Binding IsInWatchLater,
                                                                 Converter={x:Static converters:PixevalConverters.BoolToIconVariant}}}" />
            <MenuItem
                Click="OpenUserInfoPage_OnClicked"
                Header="{I18N {x:Static pixeval:EntryItemResources.OpenUserInfoPage}}"
                Icon="{markup:SymbolIcon Person}" />
            <MenuItem
                Click="BlockAuthor_OnClicked"
                Header="{I18N {x:Static pixeval:BlockedContentResources.BlockAuthor}}"
                Icon="{markup:SymbolIcon PersonProhibited}"
                IsVisible="{Binding CanBlockAuthor}" />
            <MenuItem
                Click="OpenSeriesPage_OnClicked"
                Header="{I18N {x:Static pixeval:EntryItemResources.OpenSeries}}"
                Icon="{markup:SymbolIcon SquareMultiple}"
                IsVisible="{Binding HasSeries}" />
            <Separator />
            <MenuItem
                Command="{Binding SaveCommand}"
                CommandParameter="{Binding $self, Mode=OneTime}"
                Header="{I18N {x:Static pixeval:EntryItemResources.Save}}"
                Icon="{markup:SymbolIcon Save}" />
            <Separator />
            <MenuItem
                Click="{x:Static utilities:AvaloniaHelper.LaunchUriTagInWebBrowser}"
                Header="{I18N {x:Static pixeval:EntryItemResources.OpenInWebBrowser}}"
                Icon="{markup:SymbolIcon GlobeArrowUp}"
                Tag="{Binding WebsiteUri}" />
            <MenuItem
                Click="{x:Static utilities:AvaloniaHelper.CopyTagToClipboard}"
                Header="{I18N {x:Static pixeval:EntryItemResources.GenerateWebLink}}"
                Icon="{markup:SymbolIcon LinkMultiple}"
                Tag="{Binding WebsiteUri}" />
            <MenuItem
                Click="{x:Static utilities:AvaloniaHelper.CopyTagToClipboard}"
                Header="{I18N {x:Static pixeval:EntryItemResources.GenerateLink}}"
                Icon="{markup:SymbolIcon Link}"
                Tag="{Binding AppUri}" />
        </ContextMenu>
    </work:WorkItem.ContextMenu>
    <ContentControl>
        <Grid ClipToBounds="True" ColumnDefinitions="Auto,*">

            <controls:ConstrainedBox
                x:Name="CoverBounds"
                Grid.Column="0"
                AspectRatio="427:600"
                PointerEntered="InputElement_OnPointerEntered"
                PointerExited="InputElement_OnPointerExited">
                <Panel>
                    <Image
                        x:Name="CoverImage"
                        controls:Source.Cache="{Binding ThumbnailUrl}"
                        Stretch="UniformToFill">
                        <Image.Transitions>
                            <Transitions>
                                <DoubleTransition
                                    Easing="CubicEaseOut"
                                    Property="Opacity"
                                    Duration="0:0:0.5" />
                            </Transitions>
                        </Image.Transitions>
                    </Image>
                    <controls:MarkdownBox
                        x:Name="DescriptionBlock"
                        Margin="0,30,0,10"
                        Padding="10,0"
                        FocusAdorner="{StaticResource WorkCardFocusAdorner}"
                        GotFocus="DescriptionBlock_OnGotFocus"
                        LostFocus="DescriptionBlock_OnLostFocus"
                        Markdown="{Binding Entry.Description}"
                        Opacity="0">
                        <controls:MarkdownBox.Transitions>
                            <Transitions>
                                <DoubleTransition
                                    Easing="CubicEaseOut"
                                    Property="Opacity"
                                    Duration="0:0:0.5" />
                            </Transitions>
                        </controls:MarkdownBox.Transitions>
                    </controls:MarkdownBox>
                </Panel>
            </controls:ConstrainedBox>

            <Border
                Width="40"
                Height="40"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                DoubleTapped="BookmarkButtonHost_OnTapped"
                IsVisible="{Binding IsBookmarkSupported}"
                PointerPressed="BookmarkButtonHost_OnPointerPressed"
                Tapped="BookmarkButtonHost_OnTapped">
                <controls:HeartButton
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{I18N {x:Static pixeval:EntryItemResources.AddToBookmark}}"
                    Command="{Binding BookmarkCommand}"
                    CommandParameter="{Binding $self, Mode=OneTime}"
                    FocusAdorner="{StaticResource WorkCardFocusAdorner}"
                    IsVisible="{Binding IsBookmarkSupported}"
                    State="{Binding IsBookmarkedDisplay}"
                    Theme="{StaticResource TransparentButtonStyle}"
                    ToolTip.Tip="{I18N {x:Static pixeval:EntryItemResources.AddToBookmark}}">

                    <controls:HeartButton.CacheMode>
                        <BitmapCache RenderAtScale="1" SnapsToDevicePixels="False" />
                    </controls:HeartButton.CacheMode>
                </controls:HeartButton>
            </Border>

            <Grid
                Grid.Column="1"
                Margin="10"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="4">
                <TextBlock
                    Grid.Row="0"
                    MaxLines="2"
                    Text="{Binding Entry.Title, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Theme="{StaticResource CaptionStrongTextBlockStyle}" />
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="4">
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Entry.CreateDate, Converter={x:Static converters:PixevalConverters.DateTimeShortDate}}"
                        TextTrimming="CharacterEllipsis"
                        Theme="{StaticResource BodyTextBlockStyle}" />
                    <Button
                        MinWidth="0"
                        MinHeight="32"
                        Padding="2"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.Name="{Binding Entry.User.Name}"
                        Click="AuthorButton_OnClick"
                        Theme="{StaticResource MaterialTextButtonTheme}"
                        ToolTip.Tip="{Binding Entry.User.Name}">
                        <TextBlock
                            x:Name="AuthorTextBlock"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Text="{Binding Entry.User.Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Theme="{StaticResource BodyTextBlockStyle}" />
                    </Button>
                </Grid>
                <WrapPanel
                    x:Name="StatisticsPanel"
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    ItemSpacing="8"
                    LineSpacing="4">
                    <controls:IconText
                        Symbol="Eye"
                        Text="{Binding Entry.TotalView, Converter={x:Static converters:PixevalConverters.NumberEllipsis}}"
                        ToolTip.Tip="{Binding Entry.TotalView}" />
                    <controls:IconText
                        Symbol="Heart"
                        Text="{Binding Entry.TotalFavorite, Converter={x:Static converters:PixevalConverters.NumberEllipsis}}"
                        ToolTip.Tip="{Binding Entry.TotalFavorite}" />
                    <controls:IconText
                        Symbol="TextAlignLeft"
                        Text="{Binding Entry.TextLength, Converter={x:Static converters:PixevalConverters.NumberEllipsis}}"
                        ToolTip.Tip="{Binding Entry.TextLength}" />
                    <controls:PixevalBadge IsVisible="{Binding Entry.IsAiGenerated}" Mode="Ai" />
                    <controls:PixevalBadge Mode="{Binding Entry.XRestrict, Converter={x:Static converters:PixevalConverters.RestrictBadgeModeConverter}}" />
                </WrapPanel>

                <ScrollViewer
                    x:Name="TagsScrollViewer"
                    Grid.Row="3"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TagsList" ItemsSource="{Binding Entry.Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="5" LineSpacing="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type model:Tag}">
                                <Button
                                    MaxWidth="{Binding $parent[ItemsControl].Bounds.Width}"
                                    Padding="2"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="{Binding ToolTip}"
                                    Background="Transparent"
                                    Click="TagButton_OnClicked"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    FocusAdorner="{StaticResource WorkCardFocusAdorner}"
                                    Theme="{StaticResource TransparentButtonStyle}"
                                    ToolTip.Tip="{Binding ToolTip}">
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        MaxLines="2"
                                        Text="{Binding ToolTip, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Theme="{StaticResource CaptionTextBlockStyle}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </ContentControl>
</work:WorkItem>
