<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!--If you are willing to use Windows/MacOS native APIs you will need to create 3 projects.
			One for Windows with net8.0-windows TFM, one for MacOS with net8.0-macos and one with net8.0 TFM for Linux.-->
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<EnableMcp>true</EnableMcp>
        <PublishAot Condition="'$(Configuration)' != 'Debug'">true</PublishAot>
		<UseAppHost Condition="'$(Configuration)' == 'Debug'">false</UseAppHost>
	</PropertyGroup>

	<PropertyGroup>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">..\Pixeval\Assets\logo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Summpot.StaticAvalonia" Version="3.119.4-avalonia.12.1.4-r1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pixeval\Pixeval.csproj"
		                  AdditionalProperties="EnableMcp=$(EnableMcp)"
		                  GlobalPropertiesToRemove="PublishAot" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Assets\macOS\Pixeval.icns"
		      Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- 在 NativeAOT 发布时移除 av_libglesv2 原生库，避免其复制到输出发布目录（Summpot.StaticAvalonia 已静态链接 ANGLE） -->
	<Target Name="ExcludeAngleNativeFromPublish"
	        BeforeTargets="ComputeFilesToPublish;CopyNativeSymbolFiles;_CopyResolvedFilesToPublishPreserveNewest"
	        Condition="'$(PublishAot)' == 'true'">
		<ItemGroup>
			<NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
			                      Condition="$([System.String]::Copy('%(FileName)').ToLower().Contains('av_libglesv2'))" />
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
			                       Condition="$([System.String]::Copy('%(FileName)').ToLower().Contains('av_libglesv2'))" />
		</ItemGroup>
	</Target>

</Project>

